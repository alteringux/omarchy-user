{
  "label": "Wind-down",
  "description": "End of day: reset the pomodoro and score, cancel the check-in stopwatch, a last stocks refresh, a plan-the-day reminder for the morning, the LLM daily recap, drop the VPN, and close with a 4-7-8 breathing session. Does NOT touch activity timers — those are long-lived trackers, not session state.",
  "steps": [
    { "when": "start", "cli": "omarchy-pomodoro",       "args": ["reset"],                     "speak": "Winding down." },
    { "when": "start", "cli": "omarchy-cliamp-start",   "args": [],                            "optional": true },
    { "when": "start", "cli": "omarchy-stopwatch",      "args": ["cancel"] },
    { "when": "start", "cli": "omarchy-score",          "args": ["reset"] },
    { "when": "start", "cli": "omarchy-stocks-refresh", "args": [],                            "optional": true },
    { "when": "start", "cli": "omarchy-remind",         "args": ["--at", "09:00", "Plan the day"], "optional": true },
    { "when": "start", "cli": "flow",                   "args": ["run", "daily-recap"],        "optional": true },
    { "when": "start", "cli": "protonvpn-rotate",       "args": ["disconnect"],                "optional": true },
    { "when": "start", "cli": "omarchy-dashboard-note", "args": ["Wound down {{date}}"],       "optional": true, "speak": "Wound down. Rest well." },
    { "when": "start", "cli": "omarchy-breathe",        "args": ["start", "relaxing478"],      "optional": true, "speak": "Four seven eight to finish." }
  ]
}
