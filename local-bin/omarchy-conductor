#!/usr/bin/env bash
# omarchy-conductor — the ritual engine that conducts every other alteringux
# plugin CLI as one instrument.
#
# A *ritual* is one JSON file in ~/.config/omarchy/conductor/rituals/<id>.json:
# an ordered list of steps, each step running one plugin CLI verb, tagged with
# the lifecycle phase it belongs to (start / work / break / end). `run` fires
# the start steps and — if the ritual has any phased steps — starts a
# `systemd --user` daemon that watches the pomodoro phase and fires the
# break / work / end steps as the pomodoro flips.
#
# Sole writer of ~/.local/state/omarchy/conductor-state.json and
# conductor-snapshot.json. The alteringux.conductor bar widget is a thin view:
# it watches those files and calls the verbs below.
# See ~/.config/omarchy/docs/adr/0006-cli-first-plugins.md.
#
#   omarchy-conductor list                    ritual ids, labels, step counts
#   omarchy-conductor get                     print conductor-state.json
#   omarchy-conductor status                  { active, ritual, phase, step, total, steps[] }
#   omarchy-conductor snapshot                aggregate status of every plugin (also writes the file)
#   omarchy-conductor run <id> [label...]     start a ritual (fires its `start` steps)
#   omarchy-conductor advance                 run the next single pending step
#   omarchy-conductor phase <work|break|end>  fire the steps tagged for that phase
#   omarchy-conductor stop                    run the `end` steps, then go idle
#   omarchy-conductor abort                   go idle immediately, run nothing
#
# Env: OMARCHY_STATE_DIR       override the state dir (tests)
#      OMARCHY_CONDUCTOR_NO_DAEMON=1  never spawn/stop the systemd unit (tests)
#      OMARCHY_CONDUCTOR_QUIET=1      no piper-tts / notify-send (tests)
#      OMARCHY_CONDUCTOR_RITUAL_DIR   override the ritual dir (tests)
set -uo pipefail

STATE_DIR="${OMARCHY_STATE_DIR:-$HOME/.local/state/omarchy}"
RITUAL_DIR="${OMARCHY_CONDUCTOR_RITUAL_DIR:-$HOME/.config/omarchy/conductor/rituals}"
STATE_FILE="$STATE_DIR/conductor-state.json"
SNAP_FILE="$STATE_DIR/conductor-snapshot.json"
STATE_LOCK="$STATE_FILE.lock"
UNIT="omarchy-conductor"
POLL_SECONDS=3

DEFAULT_STATE='{"version":1,"active":false,"ritual":null,"label":"","phase":"idle","startedAt":0,"lastStepAt":0,"pomodoroPhaseSeen":"IDLE","steps":[],"lastSummary":""}'

mkdir -p "$STATE_DIR"

now_ms() { date +%s%3N; }

# ── tolerant IO ────────────────────────────────────────────────────────
read_state() { { [ -f "$STATE_FILE" ] && jq -e . "$STATE_FILE" 2>/dev/null; } || printf '%s' "$DEFAULT_STATE"; }

write_json() {   # $1 = target ; stdin = JSON
  local target="$1" tmp
  tmp="$target.tmp.$$"
  if jq . >"$tmp" 2>/dev/null && [ -s "$tmp" ]; then
    mv -f "$tmp" "$target"
  else
    rm -f "$tmp"
    echo "omarchy-conductor: refusing to write invalid JSON to $target" >&2
    return 1
  fi
}


state_jq() {   # [jq args...] <program> — input = current state; writes it back
  local prog="${!#}" ; local args=("${@:1:$#-1}")
  (
    flock 9
    read_state | jq "${args[@]}" "$prog" | write_json "$STATE_FILE"
  ) 9>"$STATE_LOCK"
}

# ── resolve a plugin CLI by name across every place they hide ───────────
resolve_cli() {   # $1 = command name -> prints absolute path, or fails
  local name="$1" p
  p="$(command -v "$name" 2>/dev/null)" && { printf '%s' "$p"; return 0; }
  for p in "$HOME/.local/bin/$name" "$HOME/Work/bin/$name" \
           "$HOME"/.config/omarchy/plugins/*/bin/"$name"; do
    [ -x "$p" ] && { printf '%s' "$p"; return 0; }
  done
  return 1
}

# ── spoken / toast side channel ───────────────────────────────────────
announce() {   # $1 = text
  local msg="$1"
  [ -z "$msg" ] && return 0
  [ "${OMARCHY_CONDUCTOR_QUIET:-0}" = 1 ] && return 0
  local piper
  if piper="$(resolve_cli piper-tts)"; then
    "$piper" --tag conductor "$msg" >/dev/null 2>&1 &
  else
    notify-send -a Conductor "Conductor" "$msg" >/dev/null 2>&1 || true
  fi
}

# ── daemon ────────────────────────────────────────────────────────────
daemon_active() { systemctl --user is-active --quiet "${UNIT}.service" 2>/dev/null; }

ensure_daemon() {
  [ "${OMARCHY_CONDUCTOR_NO_DAEMON:-0}" = 1 ] && return 0
  daemon_active && return 0
  systemd-run --user --unit="$UNIT" --collect \
    --description="Omarchy ritual conductor" -- "$0" __run >/dev/null 2>&1 || true
}

stop_daemon() {
  [ "${OMARCHY_CONDUCTOR_NO_DAEMON:-0}" = 1 ] && return 0
  systemctl --user stop "${UNIT}.service" 2>/dev/null || true
}

pomodoro_phase() {
  local bin
  bin="$(resolve_cli omarchy-pomodoro)" || { echo "IDLE"; return; }
  timeout 5 "$bin" status 2>/dev/null | jq -r '.phase // "IDLE"' 2>/dev/null || echo "IDLE"
}

run_loop() {
  local prev cur
  prev="$(read_state | jq -r '.pomodoroPhaseSeen // "IDLE"')"
  while :; do
    [ "$(read_state | jq -r '.active')" = "true" ] || break
    cur="$(pomodoro_phase)"
    if [ "$cur" != "$prev" ]; then
      case "$prev:$cur" in
        WORK:SHORT_BREAK|WORK:LONG_BREAK)          "$0" phase break ;;
        SHORT_BREAK:WORK|LONG_BREAK:WORK)          "$0" phase work ;;
      esac
      if [ "$prev" != "IDLE" ] && [ "$cur" = "IDLE" ]; then
        "$0" phase end
        break
      fi
      state_jq --arg p "$cur" '.pomodoroPhaseSeen = $p'
      prev="$cur"
    fi
    sleep "$POLL_SECONDS"
  done
}

ritual_file() {
  local id="${1:-}"
  case "$id" in
    ""|.|..|*/*|*\\*)
      return 1
      ;;
  esac
  printf '%s/%s.json' "$RITUAL_DIR" "$id"
}

# ── ritual loading ───────────────────────────────────────────────────

# Normalise one ritual file's steps into a flat array with token substitution.
# Nested `{ "ritual": "<id>" }` steps are spliced in (depth-guarded).
load_steps() {   # $1 = id ; $2 = label ; $3 = depth
  local id="$1" label="$2" depth="${3:-0}" file arr n i step sub out
  file="$(ritual_file "$id")"
  [ -f "$file" ] || { echo "omarchy-conductor: no ritual '$id'" >&2; return 1; }

  arr="$(jq -c \
      --arg label "$label" \
      --arg date "$(date +%F)" \
      --arg time "$(date +%H:%M)" \
      --arg tomorrow "$(date -d tomorrow +%F 2>/dev/null || date +%F)" '
    def subst:
      gsub("\\{\\{label\\}\\}"; $label)
      | gsub("\\{\\{date\\}\\}"; $date)
      | gsub("\\{\\{time\\}\\}"; $time)
      | gsub("\\{\\{tomorrow\\}\\}"; $tomorrow);
    [ (.steps // [])[] | {
        cli: (.cli // null),
        ritual: (.ritual // null),
        args: ((.args // []) | map(tostring | subst)),
        when: (.when // "start"),
        speak: ((.speak // "") | subst),
        optional: (if has("optional") then (.optional == true) else true end)
      } ]' "$file")" || return 1

  # No nesting -> done.
  if ! jq -e 'any(.[]?; .ritual != null)' >/dev/null 2>&1 <<<"$arr"; then
    printf '%s' "$arr"; return 0
  fi
  if [ "$depth" -ge 4 ]; then printf '%s' "$arr"; return 0; fi

  out='[]'
  n="$(jq 'length' <<<"$arr")"
  for ((i = 0; i < n; i++)); do
    step="$(jq -c ".[$i]" <<<"$arr")"
    if [ "$(jq -r '.ritual // "null"' <<<"$step")" != "null" ]; then
      sub="$(load_steps "$(jq -r '.ritual' <<<"$step")" "$label" "$((depth + 1))")" || sub='[]'
      out="$(jq -cn --argjson a "$out" --argjson b "$sub" '$a + $b')"
    else
      out="$(jq -cn --argjson a "$out" --argjson s "$step" '$a + [$s]')"
    fi
  done
  printf '%s' "$out"
}

# ── step execution ───────────────────────────────────────────────────
# Run the pending step at index $1. Marks it ok / failed / skipped in state.
exec_step() {
  local idx="$1" step cli optional speak bin rc t0 t1
  step="$(read_state | jq -c ".steps[$idx] // empty")"
  [ -n "$step" ] || return 1
  [ "$(jq -r '.status' <<<"$step")" = "pending" ] || return 0

  cli="$(jq -r '.cli // ""' <<<"$step")"
  optional="$(jq -r '.optional' <<<"$step")"
  speak="$(jq -r '.speak // ""' <<<"$step")"
  mapfile -t args < <(jq -r '.args[]?' <<<"$step")

  [ -n "$speak" ] && announce "$speak"

  if [ -z "$cli" ]; then
    state_jq --argjson i "$idx" '.steps[$i].status = "skipped" | .steps[$i].error = "no cli"'
    return 0
  fi

  if ! bin="$(resolve_cli "$cli")"; then
    if [ "$optional" = "true" ]; then
      state_jq --argjson i "$idx" --arg e "not found: $cli" \
        '.steps[$i].status = "skipped" | .steps[$i].error = $e | .lastStepAt = (now*1000|floor)'
      return 0
    fi
    state_jq --argjson i "$idx" --arg e "not found: $cli" \
      '.steps[$i].status = "failed" | .steps[$i].error = $e'
    return 1
  fi

  t0="$(now_ms)"
  timeout 30 "$bin" "${args[@]}" >/dev/null 2>&1
  rc=$?
  t1="$(now_ms)"

  if [ "$rc" -eq 0 ]; then
    state_jq --argjson i "$idx" --argjson ms "$((t1 - t0))" \
      '.steps[$i].status = "ok" | .steps[$i].ms = $ms | .steps[$i].error = null | .lastStepAt = (now*1000|floor)'
    return 0
  fi

  if [ "$optional" = "true" ]; then
    state_jq --argjson i "$idx" --argjson ms "$((t1 - t0))" --arg e "exit $rc" \
      '.steps[$i].status = "skipped" | .steps[$i].ms = $ms | .steps[$i].error = $e | .lastStepAt = (now*1000|floor)'
    return 0
  fi
  state_jq --argjson i "$idx" --argjson ms "$((t1 - t0))" --arg e "exit $rc" \
    '.steps[$i].status = "failed" | .steps[$i].ms = $ms | .steps[$i].error = $e'
  return 1
}

# Run every pending step whose `when` matches $1, in order.
run_phase_steps() {
  local want="$1" n i w st
  n="$(read_state | jq '.steps | length')"
  for ((i = 0; i < n; i++)); do
    w="$(read_state | jq -r ".steps[$i].when")"
    st="$(read_state | jq -r ".steps[$i].status")"
    [ "$w" = "$want" ] || continue
    [ "$st" = "pending" ] || continue
    exec_step "$i" || true
  done
}

summarise_state() {
  read_state | jq -r '
    (.steps // []) as $s
    | "\($s | map(select(.status == "ok")) | length) ok, "
      + "\($s | map(select(.status == "skipped")) | length) skipped, "
      + "\($s | map(select(.status == "failed")) | length) failed"'
}

go_idle() {
  local sum; sum="$(summarise_state)"
  state_jq --arg s "$sum" '
    .active = false | .ritual = null | .label = "" | .phase = "idle"
    | .pomodoroPhaseSeen = "IDLE" | .lastSummary = $s'
  stop_daemon
}

# ── snapshot: every plugin at a glance ───────────────────────────────
# Run a plugin CLI and coerce whatever it prints to one valid JSON value.
# Empty / non-JSON / error output all collapse to {} so `jq -n --argjson`
# downstream can never choke.
call_json() {   # $1 = cli name ; rest = args
  local bin out; bin="$(resolve_cli "$1")" || { echo '{}'; return; }
  shift
  out="$(timeout 5 "$bin" "$@" 2>/dev/null \
        | jq -cs '[.[] | select(type=="object" or type=="array")]
                  | if length == 1 then .[0] else . end' 2>/dev/null)"
  case "$out" in "" | "[]") echo '{}' ;; *) printf '%s' "$out" ;; esac
}

read_state_file() {   # $1 = filename under $STATE_DIR
  local f="$STATE_DIR/$1"
  { [ -f "$f" ] && jq -c . "$f" 2>/dev/null; } || echo '{}'
}

build_snapshot() {
  jq -n \
    --argjson pomodoro   "$(call_json omarchy-pomodoro status)" \
    --argjson timers     "$(call_json omarchy-timers status)" \
    --argjson countdowns "$(call_json omarchy-countdowns status)" \
    --argjson score      "$(call_json omarchy-score status)" \
    --argjson reminders  "$(call_json omarchy reminder show --json)" \
    --argjson vpn        "$(read_state_file vpnrotate.json)" \
    --argjson stocks     "$(read_state_file stocks.json)" \
    --argjson at         "$(now_ms)" '
    {
      at: $at,
      pomodoro:   $pomodoro,
      timers:     $timers,
      countdowns: $countdowns,
      score:      $score,
      reminders:  $reminders,
      vpn:        $vpn,
      stocks:     $stocks
    }'
}

# ── verbs ────────────────────────────────────────────────────────────
cmd="${1:-status}"
shift || true

case "$cmd" in
  __run)
    run_loop
    ;;

  get)
    read_state | jq .
    ;;

  list)
    if [ ! -d "$RITUAL_DIR" ]; then echo "[]"; exit 0; fi
    for f in "$RITUAL_DIR"/*.json; do
      [ -f "$f" ] || continue
      jq -c --arg id "$(basename "$f" .json)" '{
        id: $id,
        label: (.label // $id),
        description: (.description // ""),
        steps: ((.steps // []) | length),
        phases: ((.steps // [])
          | map(.when // "start")
          | unique
          | sort_by(
              if . == "start" then 0
              elif . == "work" then 1
              elif . == "break" then 2
              elif . == "end" then 3
              else 4
              end
            ))
      }' "$f"
    done | jq -s '.'
    ;;

  status)
    read_state | jq '{
      active, ritual, label, phase, startedAt, lastStepAt, lastSummary,
      step: ((.steps // []) | map(select(.status != "pending")) | length),
      total: ((.steps // []) | length),
      steps: (.steps // [])
    }'
    ;;

  snapshot)
    snap="$(build_snapshot)"
    printf '%s\n' "$snap" | write_json "$SNAP_FILE" || true
    printf '%s\n' "$snap" | jq .
    ;;

  run)
    id="${1:-}"
    [ -n "$id" ] || { echo "usage: omarchy-conductor run <id> [label...]" >&2; exit 2; }
    shift || true
    label="${*:-}"
    [ -f "$(ritual_file "$id")" ] || { echo "omarchy-conductor: no ritual '$id'" >&2; exit 1; }

    steps="$(load_steps "$id" "$label" 0)" || exit 1
    steps="$(jq -c '[ .[] | . + {status:"pending", ms:0, error:null} ]' <<<"$steps")"
    ritual_label="$(jq -r '.label // $id' --arg id "$id" "$(ritual_file "$id")")"

    state_jq \
      --arg id "$id" --arg label "$label" --arg rlabel "$ritual_label" \
      --argjson steps "$steps" --argjson now "$(now_ms)" '
      .active = true | .ritual = $id
      | .label = (if $label == "" then $rlabel else $label end)
      | .phase = "start" | .startedAt = $now | .lastStepAt = $now
      | .pomodoroPhaseSeen = "IDLE" | .steps = $steps | .lastSummary = ""'

    run_phase_steps start

    if read_state | jq -e 'any(.steps[]?; .when != "start")' >/dev/null; then
      ensure_daemon
      state_jq '.phase = "running"'
    else
      go_idle
    fi
    read_state | jq '{active, ritual, label, phase, lastSummary}'
    ;;

  advance)
    [ "$(read_state | jq -r '.active')" = "true" ] || { echo "omarchy-conductor: no active ritual" >&2; exit 1; }
    n="$(read_state | jq '.steps | length')"
    done_any=0
    for ((i = 0; i < n; i++)); do
      if [ "$(read_state | jq -r ".steps[$i].status")" = "pending" ]; then
        exec_step "$i" || true
        done_any=1
        break
      fi
    done
    [ "$done_any" = 1 ] || echo "omarchy-conductor: nothing pending" >&2
    read_state | jq '{step: ((.steps//[]) | map(select(.status!="pending")) | length), total: ((.steps//[]) | length)}'
    ;;

  phase)
    want="${1:-}"
    case "$want" in work|break|end) ;; *) echo "usage: omarchy-conductor phase <work|break|end>" >&2; exit 2 ;; esac
    [ "$(read_state | jq -r '.active')" = "true" ] || { echo "omarchy-conductor: no active ritual" >&2; exit 1; }
    state_jq --arg p "$want" '.phase = $p'
    run_phase_steps "$want"
    [ "$want" = "end" ] && go_idle
    read_state | jq '{active, phase, lastSummary}'
    ;;

  stop)
    if [ "$(read_state | jq -r '.active')" = "true" ]; then
      state_jq '.phase = "end"'
      run_phase_steps end
    fi
    go_idle
    read_state | jq '{active, lastSummary}'
    ;;

  abort)
    go_idle
    read_state | jq '{active}'
    ;;

  -h | --help | help)
    sed -n '2,38p' "$0"
    ;;

  *)
    echo "omarchy-conductor: unknown command '$cmd' (try --help)" >&2
    exit 2
    ;;
esac
