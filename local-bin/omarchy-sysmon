#!/usr/bin/env bash
# omarchy-sysmon — CPU/memory/temperature sampler shared by the alteringux
# cpumon / memmon / tempmon bar widgets. Sole writer of sysmon-state.json
# (docs/adr/0006-cli-first-plugins.md). Each widget is a thin view: Kit.Store
# watches the state file; one widget's Timer calls `sample` on a cadence.
#
#   omarchy-sysmon sample     read /proc + sensors, write sysmon-state.json
#   omarchy-sysmon get        print sysmon-state.json (sampling first if stale)
#   omarchy-sysmon status     alias for get
#   omarchy-sysmon top [--json]   top-5 processes by CPU and by memory (`ps`)
#   omarchy-sysmon sensors        every labelled *_input temperature (`sensors -j`)
#   omarchy-sysmon watch [--interval S]   foreground loop: sample; sleep
#
# /proc/stat's cpu line is a cumulative counter since boot, so CPU% needs a
# delta between two samples — the first `sample` after a reset/reboot reports
# 0% and just lays down the baseline in sysmon-sample.json.
#
# `sample` also keeps a ~10-minute ring of {ts,cpu,mem,temp} in state.history
# for each panel's trend sparkline and min/avg/max stats. A flock around the
# read means concurrent widget timers coalesce to one sample per tick.
#
# Env (fixture overrides for test/cli.test.sh, all default to the real
# files/commands):
#   OMARCHY_STATE_DIR          state dir (default ~/.local/state/omarchy)
#   OMARCHY_SYSMON_STAT        path standing in for /proc/stat
#   OMARCHY_SYSMON_MEMINFO     path standing in for /proc/meminfo
#   OMARCHY_SYSMON_LOADAVG     path standing in for /proc/loadavg
#   OMARCHY_SYSMON_UPTIME      path standing in for /proc/uptime
#   OMARCHY_SYSMON_SENSORS_JSON   literal `sensors -j` output, skips calling sensors
#   OMARCHY_SYSMON_PS_OUTPUT   literal `ps -eo pid=,comm=,%cpu=,%mem=` output,
#                              skips running ps (for `top`)
set -euo pipefail

STATE_DIR="${OMARCHY_STATE_DIR:-$HOME/.local/state/omarchy}"
STATE_FILE="$STATE_DIR/sysmon-state.json"
SAMPLE_FILE="$STATE_DIR/sysmon-sample.json"

PROC_STAT="${OMARCHY_SYSMON_STAT:-/proc/stat}"
PROC_MEMINFO="${OMARCHY_SYSMON_MEMINFO:-/proc/meminfo}"
PROC_LOADAVG="${OMARCHY_SYSMON_LOADAVG:-/proc/loadavg}"
PROC_UPTIME="${OMARCHY_SYSMON_UPTIME:-/proc/uptime}"
PROC_DISKSTATS="${OMARCHY_SYSMON_DISKSTATS:-/proc/diskstats}"
QUIET="${OMARCHY_SYSMON_QUIET:-0}"
HISTORY_CAP=300

die() { echo "omarchy-sysmon: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
now_ms() { date +%s%3N; }
ensure_dir() { mkdir -p "$STATE_DIR"; }
read_file() { [ -f "$1" ] && cat "$1" || printf ''; }

have jq || die "needs jq on PATH"

put_file() { # put_file <path> ; content on stdin, atomic
  local f="$1" tmp
  ensure_dir
  tmp="$(mktemp "${f}.XXXXXX")"
  cat >"$tmp"
  mv -f "$tmp" "$f"
}

# ── /proc/stat -> cpu totals ─────────────────────────────────────────────
# Emits one JSON object per "cpu" line: { name, busy, total }. `busy` excludes
# idle + iowait; `total` sums every field.
cpu_totals_json() {
  awk '
    /^cpu[0-9]*[[:space:]]/ {
      name = $1
      total = 0
      for (i = 2; i <= NF; i++) total += $i
      idle = $5 + $6
      busy = total - idle
      printf "{\"name\":\"%s\",\"busy\":%s,\"total\":%s}\n", name, busy, total
    }
  ' "$PROC_STAT" | jq -s '.'
}

# ── /proc/meminfo -> kB fields ───────────────────────────────────────────
meminfo_json() {
  awk '
    /^MemTotal:/     { t = $2 }
    /^MemAvailable:/ { a = $2 }
    /^SwapTotal:/    { st = $2 }
    /^SwapFree:/     { sf = $2 }
    END {
      printf "{\"totalKb\":%s,\"availableKb\":%s,\"swapTotalKb\":%s,\"swapFreeKb\":%s}\n", \
        t+0, a+0, st+0, sf+0
    }
  ' "$PROC_MEMINFO"
}

loadavg_json() {
  if [ -f "$PROC_LOADAVG" ]; then
    read -r l1 l5 l15 _ < "$PROC_LOADAVG"
    jq -n --arg a "$l1" --arg b "$l5" --arg c "$l15" \
      '{one: ($a|tonumber), five: ($b|tonumber), fifteen: ($c|tonumber)}'
  else
    echo '{"one":0,"five":0,"fifteen":0}'
  fi
}

uptime_seconds() {
  if [ -f "$PROC_UPTIME" ]; then
    awk '{print int($1)}' "$PROC_UPTIME"
  else
    echo 0
  fi
}

# ── temperature: sensors -j, falling back across common chip shapes ──────
temp_source_json() {
  if [ -n "${OMARCHY_SYSMON_SENSORS_JSON:-}" ]; then
    printf '%s' "$OMARCHY_SYSMON_SENSORS_JSON"
    return
  fi
  if have sensors; then
    sensors -j 2>/dev/null || echo '{}'
  else
    echo '{}'
  fi
}

temp_celsius() {
  local src
  src="$(temp_source_json)"
  printf '%s' "$src" | jq -r '
    def inputs_of(obj): [obj | to_entries[]? | select(.key | test("_input$")) | .value | select(. > -100)];
    . as $root
    | ([$root | to_entries[] | select(.key | test("coretemp")) | .value] | .[0]) as $coretemp
    | ([$root | to_entries[] | select(.key | test("k10temp")) | .value] | .[0]) as $k10temp
    | (
        if $coretemp then
          if ($coretemp["Package id 0"]["temp1_input"]? != null) then
            $coretemp["Package id 0"]["temp1_input"]
          else
            ([$coretemp | to_entries[] | select(.key | test("^Core")) | .value | inputs_of(.)[0]] | map(select(. != null)) | if length > 0 then (add / length) else null end)
          end
        elif $k10temp then
          ($k10temp["Tctl"]["temp1_input"]? // $k10temp["Tccd1"]["temp1_input"]? // null)
        else
          null
        end
      ) as $picked
    | if $picked != null then $picked
      else
        ([$root | .. | objects | select(has("temp1_input")) | .temp1_input] | map(select(. != null and . > -100)) | if length > 0 then max else null end)
      end
    | if . == null then "" else (. * 10 | round / 10) end
  ' 2>/dev/null || printf ''
}

# ── sample: read everything, diff cpu against the last sample, write state ──
cmd_sample() {
  ensure_dir
  # cpumon/memmon/tempmon may each tick a sampler at the same cadence; flock
  # keeps it to one /proc+sensors read and one writer per tick (docs/adr/0006,
  # "separate before serializing shared state").
  exec 9>"$STATE_DIR/sysmon-sample.lock"
  flock -n 9 || return 0
  local cur_cpus prev_cpus mem load up temp updated
  cur_cpus="$(cpu_totals_json)"
  # A truncated or hand-edited baseline must not prevent a fresh sample.
  prev_cpus="$(read_file "$SAMPLE_FILE" | jq -c 'if type == "array" then . else [] end' 2>/dev/null || true)"
  [ -z "$prev_cpus" ] && prev_cpus='[]'
  mem="$(meminfo_json)"
  load="$(loadavg_json)"
  up="$(uptime_seconds)"
  temp="$(temp_celsius)"
  updated="$(now_ms)"

  local cpu_result
  cpu_result="$(jq -n --argjson cur "$cur_cpus" --argjson prev "$prev_cpus" '
    def by_name(list): reduce list[] as $c ({}; .[$c.name] = $c);
    (by_name($prev)) as $p
    | [ $cur[] | . as $c
        | ($p[$c.name]) as $pc
        | {
            name: $c.name,
            pct: (
              if $pc == null then 0
              else
                ((($c.total - $pc.total) as $dt
                  | if $dt <= 0 then 0
                    else ((($c.busy - $pc.busy) / $dt) * 100)
                    end) as $p2
                 | (if $p2 < 0 then 0 elif $p2 > 100 then 100 else $p2 end))
              end
            )
          }
      ]
  ')"

  local overall cores
  overall="$(printf '%s' "$cpu_result" | jq '[.[] | select(.name == "cpu")][0].pct // 0')"
  cores="$(printf '%s' "$cpu_result" | jq '[.[] | select(.name != "cpu") | .pct]')"

  local mem_used_pct swap_used_pct
  mem_used_pct="$(printf '%s' "$mem" | jq '
    if .totalKb > 0 then (((.totalKb - .availableKb) / .totalKb) * 100) else 0 end
  ')"
  swap_used_pct="$(printf '%s' "$mem" | jq '
    if .swapTotalKb > 0 then (((.swapTotalKb - .swapFreeKb) / .swapTotalKb) * 100) else 0 end
  ')"

  # A rolling ~10-minute ring of {ts,cpu,mem,temp} feeds each panel's trend
  # sparkline and its min/avg/max stats. Carried forward from the prior state.
  local prev_hist
  # State may have been interrupted while being written or edited by hand.
  # Keep only an array and cap it before passing it as --argjson; otherwise jq
  # would try to add an object/string to the new history array and abort.
  prev_hist="$(jq -c --argjson cap "$HISTORY_CAP" '
    (.history? // []) | if type == "array" then .[(-$cap):] else [] end
  ' "$STATE_FILE" 2>/dev/null || true)"
  [ -z "$prev_hist" ] && prev_hist='[]'
  jq -n \
    --argjson updatedAt "$updated" \
    --argjson cpuPct "$overall" \
    --argjson cores "$cores" \
    --argjson mem "$mem" \
    --argjson memPct "$mem_used_pct" \
    --argjson swapPct "$swap_used_pct" \
    --argjson load "$load" \
    --argjson uptimeSec "$up" \
    --argjson prevHist "$prev_hist" \
    --argjson cap "$HISTORY_CAP" \
    --arg tempStr "$temp" \
    '
    ($tempStr | if . == "" then null else tonumber end) as $t
    | {
      version: 1,
      updatedAt: $updatedAt,
      cpu: { pct: $cpuPct, cores: $cores },
      memory: {
        pct: $memPct,
        totalKb: $mem.totalKb,
        availableKb: $mem.availableKb,
        usedKb: ($mem.totalKb - $mem.availableKb)
      },
      swap: {
        pct: $swapPct,
        totalKb: $mem.swapTotalKb,
        usedKb: ($mem.swapTotalKb - $mem.swapFreeKb)
      },
      temp: $t,
      load: $load,
      uptimeSec: $uptimeSec,
      history: (
        ($prevHist + [{ ts: $updatedAt, cpu: $cpuPct, mem: $memPct, temp: $t }])
        | if (length > $cap) then .[(length - $cap):] else . end
      )
    }' | put_file "$STATE_FILE"

  printf '%s' "$cur_cpus" | put_file "$SAMPLE_FILE"
}

cmd_get() {
  [ -f "$STATE_FILE" ] || cmd_sample
  jq -e . "$STATE_FILE" 2>/dev/null || echo '{}'
}

cmd_watch() {
  local interval=2
  while [ $# -gt 0 ]; do
    case "$1" in
      --interval) interval="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  while true; do
    cmd_sample
    sleep "$interval"
  done
}

# ── top: highest CPU / memory processes (ps snapshot) ──────────────────
cmd_top() {
  local as_json=0
  [ "${1:-}" = "--json" ] && as_json=1

  local ps_out
  ps_out="${OMARCHY_SYSMON_PS_OUTPUT:-$(ps -eo pid=,comm=,%cpu=,%mem= 2>/dev/null || true)}"

  local parsed
  parsed="$(printf '%s\n' "$ps_out" | awk '
    NF >= 4 {
      pid = $1; cpu = $(NF - 1) + 0; mem = $NF + 0
      name = $2
      for (i = 3; i < NF - 1; i++) name = name " " $i
      gsub(/\\/, "\\\\", name); gsub(/"/, "\\\"", name)
      printf "{\"pid\":%d,\"name\":\"%s\",\"cpu\":%.1f,\"mem\":%.1f}\n", pid, name, cpu, mem
    }
  ' | jq -s '{
      byCpu: (sort_by(-.cpu) | .[0:5]),
      byMem: (sort_by(-.mem) | .[0:5])
    }' 2>/dev/null || true)"
  [ -z "$parsed" ] && parsed='{"byCpu":[],"byMem":[]}'

  if [ "$as_json" -eq 1 ]; then
    printf '%s\n' "$parsed"
  else
    printf '%s\n' "$parsed" | jq -r '
      "CPU", (.byCpu[] | "  \(.cpu)%  \(.name)"),
      "MEM", (.byMem[] | "  \(.mem)%  \(.name)")'
  fi
}

# ── sensors: every labelled tempN_input leaf (not voltage/current/fan) ──
cmd_sensors() {
  temp_source_json | jq -c '
    [ to_entries[]
      | .key as $chip
      | .value
      | (if type == "object" then to_entries[] else empty end)
      | select(.value | type == "object")
      | .key as $feature
      | .value
      | to_entries[]
      | select(.key | test("^temp[0-9]+_input$"))
      | select(.value > -50 and .value < 200)
      | { chip: ($chip | sub("-.*"; "")), label: $feature, celsius: (.value * 10 | round / 10) }
    ]' 2>/dev/null || echo '[]'
}

main() {
  local verb="${1:-status}"
  shift || true
  case "$verb" in
    sample) cmd_sample ;;
    get|status) cmd_get ;;
    watch) cmd_watch "$@" ;;
    top) cmd_top "$@" ;;
    sensors) cmd_sensors ;;
    *) die "unknown verb: $verb" ;;
  esac
}

main "$@"
