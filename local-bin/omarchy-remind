#!/usr/bin/env bash
# omarchy-remind — repeating desktop reminders, layered on top of `omarchy reminder`.
#
# The stock `omarchy-reminder <minutes> [msg]` fires a one-shot systemd --user
# transient timer (--on-active) and deletes its message file after firing, so it
# can't repeat. This wrapper adds --every (fixed interval) and --at (wall-clock
# calendar) recurring reminders while keeping the same unit-name convention
# (omarchy-reminder-<N>m-<epoch>.timer) + $XDG_RUNTIME_DIR/omarchy-reminders
# message files, so `omarchy reminder show` / `show --json` list them for free.
#
#   omarchy-remind <minutes> [message]              one-shot (delegates to stock)
#   omarchy-remind <minutes> [message] --every <M>  first fire in <minutes>, then every <M> min
#   omarchy-remind --every <M> [message]            first fire in <M>, then every <M> min
#   omarchy-remind --at '<CALENDAR>' [message]      recurring wall-clock (systemd OnCalendar spec)
#   omarchy-remind list                             repeating reminders this tool created
#   omarchy-remind stop <unit|all>                  stop one repeating reminder (or all of them)
#   omarchy-remind show                             passthrough to `omarchy reminder show`
#
# Repeating reminders are transient units: they do NOT survive logout/reboot
# (same as stock reminders). `omarchy reminder clear` also stops them.

set -euo pipefail

GLYPH=$'\U000f088c'
reminder_dir="${XDG_RUNTIME_DIR:-/tmp}/omarchy-reminders"

refresh_indicator() {
  omarchy-shell -q omarchy.indicators refresh >/dev/null 2>&1 || true
}

usage() {
  sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

# ---------------------------------------------------------------------------
# subcommands
# ---------------------------------------------------------------------------

cmd_list() {
  local marker unit spec msg next found=0 timers_json

  timers_json=$(systemctl --user list-timers --all --output=json 'omarchy-reminder-*.timer' 2>/dev/null || echo '[]')

  shopt -s nullglob
  for marker in "$reminder_dir"/omarchy-reminder-*.repeat; do
    unit=$(basename "$marker" .repeat)
    systemctl --user is-active --quiet "$unit.timer" 2>/dev/null || {
      rm -f "$marker" "$reminder_dir/$unit.message"
      continue
    }
    found=1
    spec=$(<"$marker")
    msg=""
    [[ -f $reminder_dir/$unit.message ]] && msg=$(<"$reminder_dir/$unit.message")
    next=$(jq -r --arg u "$unit.timer" '.[] | select(.unit == $u) | .next' <<<"$timers_json" 2>/dev/null)
    printf '%s\n' "$unit"
    printf '  repeat : %s\n' "$spec"
    printf '  message: %s\n' "${msg:-(default)}"
    if [[ -n $next && $next != null && $next != 0 ]]; then
      printf '  next   : %s\n' "$(date -d "@$((next / 1000000))" '+%a %H:%M')"
    fi
  done
  ((found)) || echo "No repeating reminders."
}

cmd_stop() {
  local target=${1:-}
  [[ -z $target ]] && { echo "usage: omarchy-remind stop <unit|all>" >&2; exit 1; }

  local marker unit stopped=0
  shopt -s nullglob
  for marker in "$reminder_dir"/omarchy-reminder-*.repeat; do
    unit=$(basename "$marker" .repeat)
    if [[ $target == all || $target == "$unit" || $target == "$unit.timer" ]]; then
      systemctl --user stop "$unit.timer" "$unit.service" >/dev/null 2>&1 || true
      rm -f "$marker" "$reminder_dir/$unit.message"
      stopped=$((stopped + 1))
    fi
  done

  refresh_indicator
  if ((stopped)); then
    omarchy-notification-send -g "$GLYPH" "Reminder stopped" "$stopped repeating reminder(s) cleared"
  else
    echo "No matching repeating reminder: $target" >&2
    exit 1
  fi
}

# ---------------------------------------------------------------------------
# arg parsing for the "set" path
# ---------------------------------------------------------------------------

case ${1:-} in
  ""|-h|--help|help) usage 0 ;;
  list) cmd_list; exit 0 ;;
  stop) shift; cmd_stop "${1:-}"; exit 0 ;;
  show|list-all) exec omarchy reminder show "${@:2}" ;;
esac

every=""
at=""
positional=()

while (($#)); do
  case $1 in
    --every|-e) every=${2:-}; shift 2 ;;
    --at|-a)    at=${2:-};    shift 2 ;;
    --) shift; while (($#)); do positional+=("$1"); shift; done ;;
    -*) echo "unknown option: $1" >&2; usage 1 ;;
    *)  positional+=("$1"); shift ;;
  esac
done

# ---------------------------------------------------------------------------
# calendar (--at) reminder
# ---------------------------------------------------------------------------

if [[ -n $at ]]; then
  message="${positional[*]:-}"
  [[ -z $message ]] && message="Reminder"
  set_at=$(date +%s)
  unit="omarchy-reminder-0m-$set_at"
  mkdir -p "$reminder_dir"
  printf '%s' "$message" >"$reminder_dir/$unit.message"
  printf 'at %s' "$at" >"$reminder_dir/$unit.repeat"

  if ! systemd-run --user --quiet --unit="$unit" --on-calendar="$at" \
      bash -c 'omarchy-notification-send -g "$1" "Reminder" "$2"; omarchy-shell -q omarchy.indicators refresh >/dev/null 2>&1 || true' \
      bash "$GLYPH" "$message"; then
    rm -f "$reminder_dir/$unit.message" "$reminder_dir/$unit.repeat"
    echo "systemd-run rejected the calendar spec: $at" >&2
    exit 1
  fi

  refresh_indicator
  omarchy-notification-send -g "$GLYPH" "Repeating reminder set" "\"$message\" — $at"
  exit 0
fi

# ---------------------------------------------------------------------------
# interval reminders
# ---------------------------------------------------------------------------

first=""
if [[ ${#positional[@]} -gt 0 && ${positional[0]} =~ ^[0-9]+$ ]]; then
  first=${positional[0]}
  positional=("${positional[@]:1}")
fi
message="${positional[*]:-}"

# no --every → plain one-shot; hand off to the stock command verbatim
if [[ -z $every ]]; then
  [[ -z $first ]] && { echo "need <minutes> or --every <M>" >&2; usage 1; }
  if [[ -n $message ]]; then
    exec omarchy reminder "$first" "$message"
  else
    exec omarchy reminder "$first"
  fi
fi

[[ $every =~ ^[0-9]+$ ]] && ((every > 0)) || { echo "--every needs a positive integer (minutes)" >&2; exit 1; }
[[ -z $first ]] && first=$every
[[ -z $message ]] && message="Every ${every}m reminder"

set_at=$(date +%s)
unit="omarchy-reminder-${first}m-$set_at"
mkdir -p "$reminder_dir"
printf '%s' "$message" >"$reminder_dir/$unit.message"
printf 'every %sm' "$every" >"$reminder_dir/$unit.repeat"

if ! systemd-run --user --quiet --unit="$unit" \
    --on-active="${first}min" \
    --timer-property="OnUnitActiveSec=${every}min" \
    bash -c 'omarchy-notification-send -g "$1" "Reminder" "$2"; omarchy-shell -q omarchy.indicators refresh >/dev/null 2>&1 || true' \
    bash "$GLYPH" "$message"; then
  rm -f "$reminder_dir/$unit.message" "$reminder_dir/$unit.repeat"
  echo "systemd-run failed to schedule the reminder" >&2
  exit 1
fi

remind_at=$(date -d "+${first} minutes" +%H:%M)
refresh_indicator
omarchy-notification-send -g "$GLYPH" "Repeating reminder set" \
  "\"$message\" — first at $remind_at, then every ${every}m"
