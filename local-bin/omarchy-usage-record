#!/usr/bin/env python3
"""Atomically record one Kit.Usage action under a per-file advisory lock."""
from __future__ import annotations

import fcntl
import json
import os
import sys
import tempfile

RECENT_CAP = 20

def main() -> int:
    if len(sys.argv) != 4:
        return 2
    path, action, raw_now = sys.argv[1:]
    if not action.strip():
        return 0
    try:
        now = max(0, int(raw_now))
    except ValueError:
        return 2
    directory = os.path.dirname(path) or "."
    os.makedirs(directory, exist_ok=True)
    lock_path = path + ".lock"
    with open(lock_path, "a+", encoding="utf-8") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        try:
            with open(path, encoding="utf-8") as source:
                doc = json.load(source)
        except (OSError, ValueError, TypeError):
            doc = {}
        if not isinstance(doc, dict):
            doc = {}
        actions = doc.setdefault("actions", {})
        if not isinstance(actions, dict):
            actions = {}
            doc["actions"] = actions
        entry = actions.get(action)
        if not isinstance(entry, dict):
            entry = {"count": 0, "lastAt": 0, "recent": []}
        try:
            count = max(0, int(entry.get("count", 0)))
        except (TypeError, ValueError):
            count = 0
        try:
            last_at = max(0, int(entry.get("lastAt", 0)))
        except (TypeError, ValueError):
            last_at = 0
        recent = entry.get("recent", [])
        if not isinstance(recent, list):
            recent = []
        recent = [value for value in recent if isinstance(value, int) and value >= 0]
        recent.append(now)
        entry.update(count=count + 1, lastAt=max(last_at, now), recent=recent[-RECENT_CAP:])
        actions[action] = entry
        first_at = doc.get("firstAt", 0)
        try:
            first_at = max(0, int(first_at))
        except (TypeError, ValueError):
            first_at = 0
        doc["firstAt"] = first_at or now
        fd, tmp = tempfile.mkstemp(prefix=".usage-", dir=directory, text=True)
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as target:
                json.dump(doc, target, indent=2)
                target.write("\n")
                target.flush()
                os.fsync(target.fileno())
            os.replace(tmp, path)
        finally:
            try:
                os.unlink(tmp)
            except FileNotFoundError:
                pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
