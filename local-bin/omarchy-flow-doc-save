#!/usr/bin/env python3
"""Atomically save a flow document if the file is still at the expected text."""

import fcntl
import os
import sys
import tempfile


def main() -> int:
    if len(sys.argv) != 4:
        print("usage: omarchy-flow-doc-save FILE EXPECTED REPLACEMENT", file=sys.stderr)
        return 64

    filename, expected, replacement = sys.argv[1:]
    directory = os.path.dirname(filename) or "."
    os.makedirs(directory, exist_ok=True)
    lockname = filename + ".lock"

    with open(lockname, "a+", encoding="utf-8") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        try:
            with open(filename, "r", encoding="utf-8") as current:
                actual = current.read()
        except FileNotFoundError:
            actual = ""
        if actual != expected:
            print("flow document changed while editing", file=sys.stderr)
            return 2

        fd, temporary = tempfile.mkstemp(prefix="." + os.path.basename(filename) + ".", dir=directory)
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as output:
                output.write(replacement)
                output.flush()
                os.fsync(output.fileno())
            os.replace(temporary, filename)
        finally:
            try:
                os.unlink(temporary)
            except FileNotFoundError:
                pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
