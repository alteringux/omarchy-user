#!/usr/bin/env python3
"""Speak desktop notifications aloud via Piper TTS as they pop up.

Runs as a session-long daemon. It eavesdrops on the session bus for
`org.freedesktop.Notifications.Notify` method calls (the same calls the
Omarchy/Quickshell notification daemon receives) and reads the summary +
body aloud.

Toggle on/off at runtime with `omarchy-speak-notifications-toggle`, which
just flips a state file this daemon re-checks on every notification -- no
restart needed.

TTS/playback mirrors omarchy-narrate: piper -> wav -> paplay.
"""
import html
import os
import queue
import re
import shutil
import signal
import subprocess
import sys
import threading

import dbus
from dbus.mainloop.glib import DBusGMainLoop
from gi.repository import GLib

HOME = os.path.expanduser("~")
VOICE = os.environ.get(
    "OMARCHY_SPEAK_VOICE",
    os.path.join(HOME, ".local/share/piper-voices/en_GB-cori-high.onnx"),
)
PIPER_TTS = (
    os.environ.get("PIPER_TTS_BIN")
    or shutil.which("piper-tts")
    or os.path.join(HOME, ".local/bin/piper-tts")
)
STATE_DIR = os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.join(HOME, ".local/state")),
    "omarchy-speak-notifications",
)
STATE_FILE = os.path.join(STATE_DIR, "state")   # contains "on" or "off"
PIDFILE = os.path.join(STATE_DIR, "daemon.pid")

MAX_QUEUE = 4          # drop notifications if more than this are already waiting
MAX_CHARS = 400        # truncate very long bodies before speaking

# Notifications from these apps are NOT spoken: each is a sibling TTS tool that
# already plays its own text through Piper, so speaking the notification as well
# gives you two overlapping voices reading the same thing. Override with
# OMARCHY_SPEAK_SKIP_APPS="App One,App Two" (case-insensitive, comma-separated).
SKIP_APPS = {
    a.strip().lower()
    for a in os.environ.get(
        "OMARCHY_SPEAK_SKIP_APPS",
        "Daily briefing,Weekly recap,Reddit stories,ASX briefing,TTS guard,Window hide",
    ).split(",")
    if a.strip()
}

_tag_re = re.compile(r"<[^>]+>")
_ws_re = re.compile(r"\s+")


def enabled() -> bool:
    """Default ON when the state file is missing or unreadable."""
    try:
        with open(STATE_FILE) as f:
            return f.read().strip().lower() != "off"
    except FileNotFoundError:
        return True
    except OSError:
        return True


def clean(text: str) -> str:
    text = _tag_re.sub(" ", text or "")      # strip HTML / Pango markup
    text = html.unescape(text)
    text = _ws_re.sub(" ", text).strip()
    return text


speak_q: "queue.Queue[str]" = queue.Queue()


def speaker_worker():
    while True:
        text = speak_q.get()
        if text is None:
            return
        try:
            # piper-tts chunks + streams the line and, via its own flock queue,
            # waits for any other TTS (a narration, a briefing) to finish first.
            subprocess.run(
                [PIPER_TTS, "--tag", "notify", "--voice", VOICE],
                input=text.encode(),
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        except Exception:
            pass
        finally:
            speak_q.task_done()


def enqueue(text: str):
    if speak_q.qsize() > MAX_QUEUE:
        return
    speak_q.put(text)


def on_message(_bus, message):
    try:
        if message.get_member() != "Notify":
            return
        if message.get_interface() != "org.freedesktop.Notifications":
            return
        if not enabled():
            return
        args = list(message.get_args_list())
        # Notify signature: app_name, replaces_id, app_icon, summary, body, ...
        app_name = clean(str(args[0])) if args else ""
        if app_name.lower() in SKIP_APPS:
            return
        summary = clean(str(args[3])) if len(args) > 3 else ""
        body = clean(str(args[4])) if len(args) > 4 else ""
        if not summary and not body:
            return
        spoken = summary if not body else f"{summary}. {body}" if summary else body
        if len(spoken) > MAX_CHARS:
            spoken = spoken[:MAX_CHARS].rsplit(" ", 1)[0] + "..."
        enqueue(spoken)
    except Exception:
        pass


def main():
    os.makedirs(STATE_DIR, exist_ok=True)

    # single instance
    try:
        with open(PIDFILE) as f:
            old = int(f.read().strip())
        os.kill(old, 0)
        print(f"already running as pid {old}", file=sys.stderr)
        return 0
    except (FileNotFoundError, ValueError, ProcessLookupError, PermissionError):
        pass
    with open(PIDFILE, "w") as f:
        f.write(str(os.getpid()))

    if not os.path.exists(VOICE):
        print(f"piper voice not found: {VOICE}", file=sys.stderr)

    threading.Thread(target=speaker_worker, daemon=True).start()

    DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()

    # Become a monitor for just the Notify calls (dbus >= 1.10).
    rules = [
        "type='method_call',interface='org.freedesktop.Notifications',member='Notify'"
    ]
    try:
        bus.call_blocking(
            "org.freedesktop.DBus",
            "/org/freedesktop/DBus",
            "org.freedesktop.DBus.Monitoring",
            "BecomeMonitor",
            "asu",
            (rules, dbus.UInt32(0)),
        )
    except dbus.DBusException as e:
        print(f"BecomeMonitor failed: {e}", file=sys.stderr)
        return 1

    bus.add_message_filter(on_message)

    loop = GLib.MainLoop()
    for sig in (signal.SIGINT, signal.SIGTERM):
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sig, loop.quit)
    try:
        loop.run()
    finally:
        try:
            os.unlink(PIDFILE)
        except OSError:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
