#!/usr/bin/env bash
# omarchy-voice — a "Siri"-style voice assistant for Omarchy.
#
#   speech  ->  whisper-cli (STT, tiny.en + fast decode)
#           ->  a regex fast-path handles common commands with no network call;
#               anything else goes to Featherless, which picks ONE allow-listed
#               intent + args
#           ->  either a system action runs, or it answers you conversationally
#           ->  piper-tts reads the reply / confirmation aloud
#
# The LLM never emits a shell command. It only picks an intent from a fixed
# enum; this script owns the mapping from intent to command. Anything it
# can't classify falls through to `chat` and is just answered, never executed.
#
# Usage:
#   omarchy-voice                 record speech, act / answer aloud
#   omarchy-voice --text "TEXT"   skip the mic, treat TEXT as the request
#   omarchy-voice --dry-run ...   parse + print the intent JSON, run nothing
#   omarchy-voice --stop          stop whatever it's currently saying
#   omarchy-voice --toggle "T"    speak T, interrupting current speech
#   omarchy-voice --help
#
# Env:
#   FEATHERLESS_API_KEY         overrides ~/.config/featherless/key
#   OMARCHY_VOICE_MODEL         Featherless model (default Qwen/Qwen3-30B-A3B-Instruct-2507)
#   OMARCHY_VOICE_WHISPER_MODEL ggml model path (default ~/.cache/whisper/ggml-tiny.en.bin;
#                               set to …/ggml-base.en.bin for more accuracy, ~1.7s slower)
#   OMARCHY_VOICE_SILENCE       seconds of silence that ends recording (default 1.0)
#   OMARCHY_VOICE_RATE          piper length-scale, lower = faster speech (default 0.85)

set -uo pipefail

TAG="voice"
MODEL_NAME="${OMARCHY_VOICE_MODEL:-Qwen/Qwen3-30B-A3B-Instruct-2507}"
WHISPER_MODEL="${OMARCHY_VOICE_WHISPER_MODEL:-${WHISPER_MODEL:-$HOME/.cache/whisper/ggml-tiny.en.bin}}"
SILENCE="${OMARCHY_VOICE_SILENCE:-1.0}"
RATE="${OMARCHY_VOICE_RATE:-0.85}"

DRY_RUN=0
TEXT=""

say() { # speak (faster than default rate) + echo to stderr for terminal use
  local msg="$1"
  echo "🔊 $msg" >&2
  [[ -n "${msg// }" ]] && printf '%s' "$msg" | piper-tts --tag "$TAG" --length-scale "$RATE" || true
}

die() { echo "omarchy-voice: $*" >&2; exit 1; }

# ----------------------------------------------------------------- args
while [[ $# -gt 0 ]]; do
  case "$1" in
    --stop)    exec piper-tts --stop --tag "$TAG" ;;
    --toggle)  shift; exec piper-tts --toggle --tag "$TAG" --length-scale "$RATE" "$@" ;;
    --text)    TEXT="${2:-}"; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    -h|--help)
      sed -n '2,34p' "$0" | sed 's/^# \?//'
      exit 0 ;;
    *) die "unknown argument: $1 (see --help)" ;;
  esac
done

# ----------------------------------------------------------------- 1. get the request text
if [[ -z "$TEXT" ]]; then
  command -v whisper-cli >/dev/null || die "whisper-cli not found"
  command -v parec >/dev/null      || die "parec not found (pulseaudio-utils)"

  WAV="$(mktemp --suffix=.wav)"
  SIL="$(mktemp --suffix=.sil)"
  trap 'rm -f "$WAV" "$SIL"' EXIT

  if [[ ! -f "$WHISPER_MODEL" ]]; then
    echo "Downloading whisper model to $WHISPER_MODEL ..." >&2
    mkdir -p "$(dirname "$WHISPER_MODEL")"
    curl -Ls -o "$WHISPER_MODEL" \
      "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/$(basename "$WHISPER_MODEL")" \
      || die "model download failed"
  fi

  echo "Listening… (speak, then ~${SILENCE}s of silence to stop)" >&2
  parec -d @DEFAULT_SOURCE@ --rate=16000 --channels=1 --format=s16le 2>/dev/null \
    | ffmpeg -y -f s16le -ar 16000 -ac 1 -i - \
        -af "silencedetect=noise=-40dB:d=${SILENCE}" -f wav -t 120 - \
        > "$WAV" 2> "$SIL" &
  PID=$!

  HEARD=0 MARK=0
  while kill -0 "$PID" 2>/dev/null; do
    if (( HEARD == 0 )); then
      if grep -q "silence_end" "$SIL" 2>/dev/null; then
        HEARD=1
        MARK=$(grep -c "silence_start" "$SIL" 2>/dev/null || true)
      fi
    else
      NOW=$(grep -c "silence_start" "$SIL" 2>/dev/null || true)
      if (( NOW > MARK )); then sleep 0.2; kill "$PID" 2>/dev/null || true; break; fi
    fi
    sleep 0.15
  done
  wait "$PID" 2>/dev/null || true

  (( $(stat -c%s "$WAV" 2>/dev/null || echo 0) > 1000 )) || { echo "No speech detected." >&2; exit 0; }

  echo "Transcribing…" >&2
  TEXT=$(whisper-cli -m "$WHISPER_MODEL" -f "$WAV" -nt -bs 1 -bo 1 -nf 2>/dev/null \
           | grep -v '^\[' | tr '\n' ' ' | sed 's/^ *//;s/ *$//')
fi

[[ -n "${TEXT// }" ]] || { echo "Empty request." >&2; exit 0; }
echo "You: $TEXT" >&2

# ----------------------------------------------------------------- 2a. regex fast-path (no network)
# Handles the common "do X" commands directly. A miss just falls through to the
# LLM, so these patterns can stay conservative: require an explicit target noun
# plus either a number or a direction word.
LC=$(printf '%s' "$TEXT" | tr '[:upper:]' '[:lower:]' | tr -d '\r')
# spoken small numbers -> digits (only the values people actually say to a dial)
LC_N=$(printf '%s' "$LC" | sed -E '
  s/\bzero\b/0/g;s/\bone\b/1/g;s/\btwo\b/2/g;s/\bthree\b/3/g;s/\bfour\b/4/g;
  s/\bfive\b/5/g;s/\bsix\b/6/g;s/\bseven\b/7/g;s/\beight\b/8/g;s/\bnine\b/9/g;
  s/\bten\b/10/g;s/\btwenty\b/20/g;s/\bthirty\b/30/g;s/\bforty\b/40/g;
  s/\bfifty\b/50/g;s/\bsixty\b/60/g;s/\bseventy\b/70/g;s/\beighty\b/80/g;
  s/\bninety\b/90/g;s/\b(a |one )?hundred\b/100/g')

JSON=""
num=$(printf '%s' "$LC_N" | grep -oE '[0-9]+' | head -1)
case "$LC_N" in
  *mut*mic*|*mut*microphone*|*mic*mut*|*microphone*mut*)  JSON='{"intent":"mic_mute","args":{}}' ;;
  *lock*screen*|*lock*computer*|*lock*session*|"lock"|"lock it"|"lock up")  JSON='{"intent":"lock","args":{}}' ;;
  *night*light*|*nightlight*|*blue*light*filter*)  JSON='{"intent":"nightlight","args":{}}' ;;
  *screenshot*|*screen*shot*)  JSON='{"intent":"screenshot","args":{}}' ;;
  *mute*|*unmute*)  JSON='{"intent":"volume_mute","args":{}}' ;;
esac
if [[ -z "$JSON" && -n "$num" ]]; then
  case "$LC_N" in
    *brightness*|*screen*bright*|*bright*screen*)  JSON="{\"intent\":\"brightness_set\",\"args\":{\"percent\":$num}}" ;;
    *volume*|*sound*level*)                        JSON="{\"intent\":\"volume_set\",\"args\":{\"percent\":$num}}" ;;
  esac
fi
if [[ -z "$JSON" ]]; then
  case "$LC_N" in
    *brighten*|*brighter*|*bright*up*)   JSON='{"intent":"brightness_rel","args":{"delta":10}}' ;;
    *dim*|*darker*|*bright*down*)        JSON='{"intent":"brightness_rel","args":{"delta":-10}}' ;;
    *louder*|*volume*up*|*turn*up*volume*|*volume*louder*)   JSON='{"intent":"volume_rel","args":{"delta":10}}' ;;
    *quieter*|*volume*down*|*turn*down*volume*|*lower*volume*)  JSON='{"intent":"volume_rel","args":{"delta":-10}}' ;;
  esac
fi

# ----------------------------------------------------------------- 2b. LLM intent parse (only if fast-path missed)
if [[ -z "$JSON" ]]; then
  SYS='You are the intent parser for a Linux voice assistant on Omarchy (Hyprland).
Reply with ONE minified JSON object and nothing else: {"intent":"NAME","args":{...}}

Allowed intents and args:
- brightness_set {"percent":0-100}   set display brightness to an absolute level
- brightness_rel {"delta":-100..100} change brightness by delta percentage points
- volume_set     {"percent":0-100}   set output volume to an absolute level
- volume_rel     {"delta":-100..100} change output volume by delta percentage points
- volume_mute    {}                  toggle output mute
- mic_mute       {}                  toggle microphone mute
- theme_set      {"name":"TEXT"}     switch the Omarchy theme (name as spoken)
- nightlight     {}                  toggle the night-light filter
- screenshot     {}                  take a screenshot
- lock           {}                  lock the screen
- launch         {"app":"browser|terminal|files|spotify|signal|discord"}
- chat           {}                  ANY question or request that is not one of the above

Rules: choose chat unless the request clearly matches an action above.
Convert spoken numbers to integers. Bare "down/dim/lower/quieter" => delta -10;
bare "up/brighter/louder" => delta +10.'

  RAW=$(llm-blurb --json --model "$MODEL_NAME" --system "$SYS" --max-tokens 64 --timeout 30 "$TEXT")
  if [[ -z "${RAW// }" ]]; then
    say "Sorry, I could not reach the language model."
    exit 1
  fi
  JSON=$(printf '%s' "$RAW" | sed -e 's/^```[a-z]*//' -e 's/```$//')
  printf '%s' "$JSON" | jq -e . >/dev/null 2>&1 || JSON='{"intent":"chat"}'
fi

INTENT=$(printf '%s' "$JSON" | jq -r '.intent // "chat"' 2>/dev/null || echo chat)

if (( DRY_RUN )); then
  echo "intent: $INTENT" >&2
  printf '%s\n' "$JSON"
  exit 0
fi

arg()   { printf '%s' "$JSON" | jq -r "$1 // empty" 2>/dev/null; }
clamp() { local v=$1 lo=$2 hi=$3; (( v < lo )) && v=$lo; (( v > hi )) && v=$hi; echo "$v"; }
run_action() { echo "▶ $*" >&2; "$@"; }

# ----------------------------------------------------------------- 3. act
STATUS=0
SAY=""
case "$INTENT" in
  brightness_set)
    p=$(arg .args.percent); p=$(clamp "${p:-50}" 1 100)
    run_action omarchy brightness display "${p}%" || STATUS=$?
    SAY="Brightness ${p} percent." ;;

  brightness_rel)
    d=$(arg .args.delta); d=${d:-0}
    if (( d >= 0 )); then run_action omarchy brightness display "+${d}%" || STATUS=$?
    else                  run_action omarchy brightness display "$(( -d ))%-" || STATUS=$?; fi
    SAY="Done." ;;

  volume_set)
    p=$(arg .args.percent); p=$(clamp "${p:-30}" 0 100)
    cur=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk '{print int($2*100)}')
    cur=${cur:-0}; d=$(( p - cur ))
    if (( d >= 0 )); then run_action omarchy audio output volume "+${d}" || STATUS=$?
    else                  run_action omarchy audio output volume "-$(( -d ))" || STATUS=$?; fi
    SAY="Volume ${p} percent." ;;

  volume_rel)
    d=$(arg .args.delta); d=${d:-0}
    if (( d >= 0 )); then run_action omarchy audio output volume "+${d}" || STATUS=$?
    else                  run_action omarchy audio output volume "-$(( -d ))" || STATUS=$?; fi
    SAY="Done." ;;

  volume_mute)  run_action omarchy audio output volume mute-toggle || STATUS=$?; SAY="Mute toggled." ;;
  mic_mute)     run_action omarchy audio input mute || STATUS=$?;                SAY="Mic toggled." ;;
  nightlight)   run_action omarchy toggle nightlight || STATUS=$?;               SAY="Night light toggled." ;;
  screenshot)   run_action omarchy capture screenshot || STATUS=$?;             SAY="Screenshot taken." ;;

  theme_set)
    want=$(arg .args.name | tr '[:upper:]' '[:lower:]')
    match=""
    while IFS= read -r t; do
      lt=$(printf '%s' "$t" | tr '[:upper:]' '[:lower:]')
      if [[ "$lt" == "$want" || "$lt" == *"$want"* || "$want" == *"$lt"* ]]; then match="$t"; break; fi
    done < <(omarchy theme list 2>/dev/null)
    if [[ -n "$match" ]]; then
      run_action omarchy theme set "$match" || STATUS=$?
      SAY="${match} theme."
    else
      SAY="No theme called ${want}."
    fi ;;

  lock)
    say "Locking up."
    exec omarchy system lock ;;

  launch)
    app=$(arg .args.app)
    case "$app" in
      browser)  run_action omarchy launch browser  || STATUS=$? ;;
      terminal) run_action omarchy launch terminal || STATUS=$? ;;
      files)    run_action omarchy launch nautilus || STATUS=$? ;;
      spotify)  run_action omarchy launch spotify  || STATUS=$? ;;
      signal)   run_action omarchy launch signal   || STATUS=$? ;;
      discord)  run_action omarchy launch discord community || STATUS=$? ;;
      *)        say "I cannot launch ${app:-that}."; exit 0 ;;
    esac
    SAY="Launching ${app}." ;;

  *) # chat / anything unrecognised — keep the answer short so it starts sooner
    ans=$(llm-blurb --model "$MODEL_NAME" --max-tokens 120 --timeout 40 \
      --system "You are a spoken voice assistant. Answer in one or two short sentences, under 40 words. No markdown, no lists, no emoji." \
      "$TEXT")
    say "${ans:-Sorry, I could not work that out.}"
    exit 0 ;;
esac

# ----------------------------------------------------------------- 4. confirm aloud
if (( STATUS != 0 )); then
  say "That did not work."
  exit "$STATUS"
fi
say "$SAY"
