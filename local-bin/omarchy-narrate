#!/usr/bin/env bash
# Reads the current selection (or clipboard) aloud using Piper TTS.
# Run again while speaking to stop.
#
# Synthesis + playback + the "one voice at a time" queue are handled by
# piper-tts: the text is chunked, the first sentence streams out of piper
# immediately while the rest is synthesised in parallel, and if something
# else is already speaking this read waits its turn instead of overlapping.
set -uo pipefail

VOICE="${OMARCHY_SPEAK_VOICE:-$HOME/.local/share/piper-voices/en_GB-cori-high.onnx}"
PIPER_TTS="$(command -v piper-tts 2>/dev/null || echo "$HOME/.local/bin/piper-tts")"

# re-run while speaking (or while a narrate is queued) => stop it
if "$PIPER_TTS" --tag narrate --stop; then exit 0; fi

TEXT="$(wl-paste --primary --no-newline 2>/dev/null)"
if [[ -z "$TEXT" ]]; then
  TEXT="$(wl-paste --no-newline 2>/dev/null)"
fi

if [[ -z "$TEXT" ]]; then
  notify-send "Narrator" "Nothing selected or copied to read." 2>/dev/null
  exit 0
fi

printf '%s' "$TEXT" | "$PIPER_TTS" --tag narrate --voice "$VOICE"
