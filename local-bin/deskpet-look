#!/usr/bin/env bash
# deskpet-look -- one-shot screen glance + in-character comment, via `claude -p`.
# Used by alteringux.deskpet's floating pet when the (opt-in, default-off) "let
# it look at your screen" setting is on: grabs a screenshot, downscales it,
# hands the file to claude with a system prompt describing the pet's
# personality, and prints back one short line.
#
# This sends a downscaled copy of your actual screen content to the Claude API
# every time it runs. It only runs when the user has explicitly enabled
# screen-watch in the Desk Pet settings panel.
#
# Usage: deskpet-look --system "SYSTEM PROMPT TEXT" [--max-tokens N] [--timeout N]
#
# On ANY failure (no claude, no grim/magick, capture failure, empty reply)
# prints one reason line to stderr and exits non-zero *quietly* -- the caller
# just skips this ambient beat and falls back to its own canned lines, same
# contract as llm-blurb.
#
# Exit codes: 0 ok | 2 bad args | 3 claude not found | 4 capture/model failure
#             5 empty reply
set -uo pipefail

system=""
max_tokens=70
timeout=45

while (($#)); do
  case "$1" in
    --system)     system="${2:-}"; shift 2 ;;
    --max-tokens) max_tokens="${2:-}"; shift 2 ;;
    --timeout)    timeout="${2:-}"; shift 2 ;;
    *)            echo "deskpet-look: unknown arg $1" >&2; exit 2 ;;
  esac
done
[[ -z "$system" ]] && { echo "deskpet-look: --system is required" >&2; exit 2; }

command -v claude >/dev/null 2>&1 || { echo "deskpet-look: claude CLI not on PATH" >&2; exit 3; }
for bin in grim magick; do
  command -v "$bin" >/dev/null || { echo "deskpet-look: $bin not found" >&2; exit 4; }
done

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

grim "$work/full.png" 2>/dev/null || { echo "deskpet-look: screenshot capture failed" >&2; exit 4; }
magick "$work/full.png" -resize 900x -quality 55 "$work/small.jpg" 2>/dev/null \
  || { echo "deskpet-look: downscale failed" >&2; exit 4; }

raw=$(timeout -k 5 "$timeout" claude -p "Read the image at $work/small.jpg -- it is my screen right now. React in character in one short line. Keep it to roughly ${max_tokens} tokens. Plain text, no preamble." \
  --system-prompt "$system Answer only from what is visibly on screen. Plain text, one line." \
  --allowedTools Read \
  --output-format text </dev/null 2>/dev/null)
rc=$?
if ((rc != 0)); then
  echo "deskpet-look: claude failed (rc=$rc)" >&2
  exit 4
fi

line=$(printf '%s' "$raw" | tr '\n' ' ' | sed -E 's/^[[:space:]]+|[[:space:]]+$//g')
[[ -z "$line" ]] && { echo "deskpet-look: empty reply" >&2; exit 5; }
printf '%s\n' "${line:0:220}"
