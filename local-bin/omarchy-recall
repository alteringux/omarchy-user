#!/usr/bin/env bash
# omarchy-recall — an intrusive spaced-repetition trainer: short technique
# lessons taught as fullscreen takeovers, quizzed later on an adaptive,
# escalating cadence (same shape as omarchy-grip's task wall).
#
# Sole writer of ~/.local/state/omarchy/recall-cards.json (content + SRS
# schedule, one file — a card's due date is as much "the content" as its
# text) and recall-state.json (prompt/streak runtime). A `systemd --user`
# transient unit (this script, `__run`) ticks once a minute: rolls the daily
# counters, then asks the shared decision engine (Model.js, via
# recall-cli.js) whether a fresh lesson is due, a quiz check-in is due, or
# things have escalated to a fullscreen takeover — and raises that prompt in
# recall-state.json plus a notification. The alteringux.recall bar widget is
# a thin view: it watches the files, shows the prompt surface, and calls the
# verbs below. recall-config.json (cadence knobs) is seeded once and meant
# to be hand-edited. See ~/.config/omarchy/docs/adr/0006-cli-first-plugins.md.
#
#   omarchy-recall add-quiz "front" "back" [--category trivia|technique|custom]
#   omarchy-recall add-lesson "Title" "slide one" "slide two" ...
#   omarchy-recall drop <id>                     remove a card
#   omarchy-recall grade <id> <again|hard|good|easy>   review one card (SRS)
#   omarchy-recall lesson-seen <id>              mark a lesson taught, spins up
#                                                its spaced recall companion card
#   omarchy-recall list                          the due queue, oldest first
#   omarchy-recall get | get-state               raw recall-cards.json / -state.json
#   omarchy-recall status                        live { prompt, reason, dueCount, ... }
#   omarchy-recall stats                         retention rate, streak, counts
#   omarchy-recall checkin                       raise a check-in now (keybind target)
#   omarchy-recall ack <lesson|checkin|takeover> [--engaged] [--snooze <min>]
#                                                 respond to the on-screen prompt
#   omarchy-recall generate-trivia <n> [--category X]   Featherless-generated
#                                                 trivia cards via llm-blurb
#   omarchy-recall generate-vocab <n>            Featherless-generated English
#                                                 vocabulary cards (word / definition
#                                                 + example), skips words already in deck
#   omarchy-recall review                        interactive terminal session: walks
#                                                 unseen lessons + due quizzes one at a
#                                                 time (front, reveal, self-grade)
#   omarchy-recall pause <dur>                   mute all prompts for a while
#   omarchy-recall resume                        end a pause early
#   omarchy-recall on | off                      enable / disable (starts off)
#
# Env: OMARCHY_STATE_DIR   override the state dir (tests)
#      OMARCHY_RECALL_DIR  override the plugin dir holding Model.js / recall-cli.js
#      OMARCHY_RECALL_NO_DAEMON=1  skip all systemd calls (tests)
#      OMARCHY_RECALL_QUIET=1      skip notify-send (tests)
#      OMARCHY_RECALL_TICK_SECONDS override the 60s daemon cadence (tests)
set -euo pipefail

STATE_DIR="${OMARCHY_STATE_DIR:-$HOME/.local/state/omarchy}"
RECALL_DIR="${OMARCHY_RECALL_DIR:-$HOME/.config/omarchy/plugins/alteringux.recall}"
CONFIG_FILE="$STATE_DIR/recall-config.json"
STATE_FILE="$STATE_DIR/recall-state.json"
CARDS_FILE="$STATE_DIR/recall-cards.json"
ENGINE="$RECALL_DIR/recall-cli.js"
UNIT="omarchy-recall"
TICK_SECONDS="${OMARCHY_RECALL_TICK_SECONDS:-60}"

DEFAULT_CONFIG='{"version":1,"enabled":false,"baseIntervalMin":45,"minIntervalMin":15,"maxIntervalMin":150,"quizBatchSize":5,"overdueTakeoverHours":8,"dismissTakeoverStreak":3,"dailyNewLessonCap":1,"lessonGapHours":20,"snoozeMinutes":[15,60]}'
DEFAULT_STATE='{"version":1,"prompt":null,"dismissStreak":0,"lastPromptMs":0,"lastLessonMs":0,"lessonsToday":0,"lessonsTodayDate":"","pauseUntilMs":0,"streakDays":0,"lastActiveDate":""}'

mkdir -p "$STATE_DIR"

die()    { echo "omarchy-recall: $*" >&2; exit 1; }
now_ms() { date +%s%3N; }
have()   { command -v "$1" >/dev/null 2>&1; }

have jq   || die "jq not found"
have node || die "node not found"
[ -f "$ENGINE" ] || die "engine not found at $ENGINE (set OMARCHY_RECALL_DIR)"

# ── file IO ────────────────────────────────────────────────────────────────
write_json() {   # $1 = file; stdin = JSON
  local target="$1" tmp
  tmp="$target.tmp.$$"
  if jq . >"$tmp" 2>/dev/null && [ -s "$tmp" ]; then
    mv -f "$tmp" "$target"
  else
    rm -f "$tmp"
    echo "omarchy-recall: refusing to write invalid JSON to $target" >&2
    return 1
  fi
}

seed_config() {
  [ -f "$CONFIG_FILE" ] && return 0
  printf '%s\n' "$DEFAULT_CONFIG" | write_json "$CONFIG_FILE"
}
seed_cards() {
  [ -f "$CARDS_FILE" ] && return 0
  jq -n --argjson now "$(now_ms)" '{now:$now}' | engine seed | jq '{version:1, cards:.cards}' | put_cards
}
read_config() { seed_config; jq -e . "$CONFIG_FILE" 2>/dev/null || printf '%s' "$DEFAULT_CONFIG"; }
read_state()  { { [ -f "$STATE_FILE" ] && jq -e . "$STATE_FILE" 2>/dev/null; } || printf '%s' "$DEFAULT_STATE"; }
read_cards()  { seed_cards; { [ -f "$CARDS_FILE" ] && jq -e . "$CARDS_FILE" 2>/dev/null; } || printf '%s' '{"version":1,"cards":[]}'; }

put_state() { write_json "$STATE_FILE"; }
put_cards() { write_json "$CARDS_FILE"; }

# ── engine bridge ─────────────────────────────────────────────────────────
engine() { node "$ENGINE" "$1"; }

# ── side effects ─────────────────────────────────────────────────────────
notify() {   # $1 = urgency (normal|critical), $2 = title, $3 = body
  [ "${OMARCHY_RECALL_QUIET:-0}" = 1 ] && return 0
  have notify-send || return 0
  notify-send -a "Recall" -u "$1" "$2" "$3" 2>/dev/null || true
}

pulse_prompt() {   # $1 = checkin|takeover|lesson
  command -v omarchy-pulse >/dev/null 2>&1 || return 0
  local lvl label
  case "$1" in
    takeover) lvl=critical; label="Deal with this now" ;;
    lesson)   lvl=urgent;   label="A short lesson is ready" ;;
    *)        lvl=urgent;   label="Recall check-in due" ;;
  esac
  omarchy-pulse attention alteringux.recall --label "$label" --level "$lvl" \
    --action "omarchy-shell alteringux.recall checkin" --action-label "Review" >/dev/null 2>&1 || true
}
pulse_clear() {
  command -v omarchy-pulse >/dev/null 2>&1 || return 0
  omarchy-pulse clear alteringux.recall >/dev/null 2>&1 || true
}

top_lines() {   # top 3 due card fronts, newline-joined
  jq -n --argjson cards "$(read_cards)" --argjson now "$(now_ms)" '{cards:$cards.cards, now:$now, n:3}' \
    | engine top \
    | jq -r '.[].front' | sed 's/^/• /' | paste -sd '\n' -
}

# ── daemon lifecycle ────────────────────────────────────────────────────
daemon_active() {
  [ "${OMARCHY_RECALL_NO_DAEMON:-0}" = 1 ] && return 1
  systemctl --user is-active --quiet "${UNIT}.service" 2>/dev/null
}
ensure_daemon() {
  [ "${OMARCHY_RECALL_NO_DAEMON:-0}" = 1 ] && return 0
  daemon_active && return 0
  systemd-run --user --unit="$UNIT" --collect \
    --description="Omarchy recall trainer" -- "$0" __run >/dev/null 2>&1 || true
}
stop_daemon() {
  [ "${OMARCHY_RECALL_NO_DAEMON:-0}" = 1 ] && return 0
  systemctl --user stop "${UNIT}.service" 2>/dev/null || true
}

# ── helpers ────────────────────────────────────────────────────────────
new_id() { od -An -N4 -tx1 /dev/urandom | tr -d ' \n'; }

dur_to_min() {   # "2h" / "30m" / "90" -> minutes
  local raw="${1:-}"
  case "$raw" in
    *h) echo $(( ${raw%h} * 60 )) ;;
    *m) echo "${raw%m}" ;;
    ''|*[!0-9]*) die "bad duration: '$raw' (try 2h, 30m, 90)" ;;
    *) echo "$raw" ;;
  esac
}

state_set() { read_state | jq "$1" | put_state; }

# ── verbs ──────────────────────────────────────────────────────────────
cmd_add_quiz() {
  local category="custom" front="" back=""
  local pos=()
  while (($#)); do
    case "$1" in
      --category) category="${2:-}"; shift 2 ;;
      *) pos+=("$1"); shift ;;
    esac
  done
  front="${pos[0]:-}"; back="${pos[1]:-}"
  [ -n "$front" ] && [ -n "$back" ] || die "usage: omarchy-recall add-quiz <front> <back> [--category trivia|technique|custom]"

  local id; id="$(new_id)"
  jq -n --argjson cards "$(read_cards)" --arg id "$id" --argjson now "$(now_ms)" \
        --arg front "$front" --arg back "$back" --arg category "$category" \
        '{cards:$cards.cards, id:$id, now:$now, input:{front:$front, back:$back, category:$category}}' \
    | engine add-quiz | jq '{version:1, cards:.cards}' | put_cards
  echo "added $id  $front"
}

cmd_add_lesson() {
  local title="${1:-}"; shift || true
  [ -n "$title" ] && (($# >= 1)) || die "usage: omarchy-recall add-lesson <title> <slide...>"
  local id; id="$(new_id)"
  local slides_json; slides_json="$(printf '%s\n' "$@" | jq -R . | jq -s .)"
  jq -n --argjson cards "$(read_cards)" --arg id "$id" --argjson now "$(now_ms)" \
        --arg title "$title" --argjson slides "$slides_json" \
        '{cards:$cards.cards, id:$id, now:$now, input:{title:$title, slides:$slides}}' \
    | engine add-lesson | jq '{version:1, cards:.cards}' | put_cards
  echo "added $id  $title"
}

cmd_drop() {
  local id="${1:-}"; [ -n "$id" ] || die "usage: omarchy-recall drop <id>"
  jq -n --argjson cards "$(read_cards)" --arg id "$id" '{cards:$cards.cards, id:$id}' \
    | engine drop | jq '{version:1, cards:.cards}' | put_cards
  echo "dropped $id"
}

cmd_grade() {
  local id="${1:-}" grade="${2:-}"
  case "$grade" in again|hard|good|easy) ;; *) die "usage: omarchy-recall grade <id> <again|hard|good|easy>" ;; esac
  [ -n "$id" ] || die "usage: omarchy-recall grade <id> <again|hard|good|easy>"
  jq -n --argjson cards "$(read_cards)" --arg id "$id" --arg grade "$grade" --argjson now "$(now_ms)" \
        '{cards:$cards.cards, id:$id, grade:$grade, now:$now}' \
    | engine grade | jq '{version:1, cards:.cards}' | put_cards
  echo "graded $id $grade"
}

cmd_lesson_seen() {
  local id="${1:-}"; [ -n "$id" ] || die "usage: omarchy-recall lesson-seen <id>"
  jq -n --argjson cards "$(read_cards)" --arg id "$id" --argjson now "$(now_ms)" \
        '{cards:$cards.cards, id:$id, now:$now}' \
    | engine lesson-seen | jq '{version:1, cards:.cards}' | put_cards
  echo "lesson-seen $id"
}

cmd_list() {
  jq -n --argjson cards "$(read_cards)" --argjson now "$(now_ms)" '{cards:$cards.cards, now:$now}' \
    | engine render
}

cmd_stats() {
  jq -n --argjson cards "$(read_cards)" --argjson state "$(read_state)" --argjson now "$(now_ms)" \
    '{cards:$cards.cards, state:$state, now:$now}' | engine stats
}

cmd_status() {
  local decision
  decision="$(jq -n --argjson config "$(read_config)" --argjson state "$(read_state)" \
              --argjson cards "$(read_cards)" --argjson now "$(now_ms)" \
              '{config:$config, state:$state, cards:$cards.cards, now:$now}' | engine decide)"
  jq -n --argjson d "$decision" --argjson st "$(read_state)" --argjson cfg "$(read_config)" \
    '{enabled: $cfg.enabled, prompt: $st.prompt, wouldPrompt: $d.prompt, reason: $d.reason,
      dismissStreak: $st.dismissStreak, pauseUntilMs: $st.pauseUntilMs, streakDays: $st.streakDays,
      nextIntervalMs: $d.nextIntervalMs}'
}

cmd_checkin() {
  local cfg; cfg="$(read_config)"
  [ "$(jq -r '.enabled' <<<"$cfg")" = "true" ] || die "recall is off — run: omarchy-recall on"
  local st; st="$(read_state)"
  if [ "$(jq -r '.prompt' <<<"$st")" != "null" ]; then
    echo "a prompt is already up"; return 0
  fi
  local ids; ids="$(jq -n --argjson cards "$(read_cards)" --argjson now "$(now_ms)" \
    '{cards:$cards.cards, now:$now, n: 5}' | engine top | jq -c '[.[].id]')"
  if [ "$ids" = "[]" ]; then
    echo "nothing due"; return 0
  fi
  jq --argjson ids "$ids" --argjson now "$(now_ms)" \
    '.prompt = {kind:"checkin", cardIds:$ids, reason:"manual"} | .lastPromptMs = $now' <<<"$st" | put_state
  notify normal "🧠 Recall check-in" "$(top_lines)"
  pulse_prompt checkin
}

cmd_ack() {
  local kind="${1:-}"; shift || true
  case "$kind" in lesson|checkin|takeover) ;; *) die "usage: omarchy-recall ack <lesson|checkin|takeover> [--engaged] [--snooze <min>]" ;; esac

  local engaged=false snooze=""
  while (($#)); do
    case "$1" in
      --engaged) engaged=true; shift ;;
      --snooze) snooze="$(dur_to_min "${2:-}")"; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done

  local now; now="$(now_ms)"
  local pause_expr=".pauseUntilMs = .pauseUntilMs"
  if [ -n "$snooze" ]; then
    pause_expr=".pauseUntilMs = ($now + $snooze * 60000)"
  fi

  local streak_expr
  if [ "$kind" = "lesson" ] || [ "$kind" = "takeover" ] || [ "$engaged" = "true" ]; then
    streak_expr=".dismissStreak = 0"
  else
    streak_expr=".dismissStreak = (.dismissStreak + 1)"
  fi

  read_state | jq --argjson now "$now" \
    ".prompt = null | .lastPromptMs = \$now | $streak_expr | $pause_expr" | put_state
  pulse_clear
  echo "ack $kind"
}

cmd_generate_trivia() {
  local n="${1:-10}"; shift || true
  local category="general knowledge"
  while (($#)); do
    case "$1" in
      --category) category="${2:-}"; shift 2 ;;
      *) shift ;;
    esac
  done
  have llm-blurb || die "llm-blurb not found on PATH (Featherless helper)"

  local prompt raw items
  prompt="Generate $n trivia question/answer pairs about $category. Prefer interesting, non-obvious facts over common knowledge. Answers must be concise (under 15 words). Return ONLY a JSON object of the shape {\"items\":[{\"q\":\"...\",\"a\":\"...\"}]} with exactly $n items, nothing else."
  raw="$(llm-blurb --json --max-tokens 1500 "$prompt")" || die "llm-blurb failed"
  items="$(jq -c '[.items[]? | {front:.q, back:.a, category:"trivia"}]' <<<"$raw" 2>/dev/null)" || die "could not parse trivia JSON from model"
  [ "$items" != "[]" ] && [ -n "$items" ] || die "model returned no usable trivia items"

  jq -n --argjson cards "$(read_cards)" --argjson items "$items" --argjson now "$(now_ms)" --arg prefix "t$(now_ms)-" \
        '{cards:$cards.cards, items:$items, now:$now, idPrefix:$prefix}' \
    | engine add-quiz-batch | jq '{version:1, cards:.cards}' | put_cards
  echo "generated $(jq 'length' <<<"$items") trivia cards ($category)"
}

cmd_generate_vocab() {
  local n="${1:-3}"
  have llm-blurb || die "llm-blurb not found on PATH (Featherless helper)"

  local existing exclude_clause=""
  existing="$(jq -r '[.cards[]? | select(.category=="vocabulary") | .front] | join(", ")' <<<"$(read_cards)")"
  [ -n "$existing" ] && exclude_clause=" Do not repeat any of these words already taught: $existing."

  local prompt raw items
  prompt="Pick $n English vocabulary words worth teaching an adult who already speaks English fluently but wants a richer, more precise vocabulary. Prefer useful, interesting words of moderate-to-advanced difficulty — not painfully obscure, not trivially common — mixing parts of speech. For each word give a one-sentence plain-English definition and one natural example sentence that uses the word.$exclude_clause Return ONLY a JSON object of the shape {\"items\":[{\"word\":\"...\",\"definition\":\"...\",\"example\":\"...\"}]} with exactly $n items, nothing else."
  raw="$(llm-blurb --json --max-tokens 1200 "$prompt")" || die "llm-blurb failed"
  items="$(jq -c '[.items[]? | select(.word and .definition) | {front: .word, back: (.definition + (if .example then "  e.g. " + .example else "" end)), category: "vocabulary"}]' <<<"$raw" 2>/dev/null)" || die "could not parse vocabulary JSON from model"
  [ "$items" != "[]" ] && [ -n "$items" ] || die "model returned no usable vocabulary items"

  jq -n --argjson cards "$(read_cards)" --argjson items "$items" --argjson now "$(now_ms)" --arg prefix "v$(now_ms)-" \
        '{cards:$cards.cards, items:$items, now:$now, idPrefix:$prefix}' \
    | engine add-quiz-batch | jq '{version:1, cards:.cards}' | put_cards
  echo "generated $(jq 'length' <<<"$items") vocabulary cards"
}

cmd_review() {
  local cards front back id title grade choice line
  local seen_any=0

  # 1. unseen lessons first (teach, no grading)
  cards="$(read_cards)"
  local lesson_ids=()
  mapfile -t lesson_ids < <(jq -r '[.cards[]? | select(.kind=="lesson" and .shownAt==null)] | .[].id' <<<"$cards")
  for id in "${lesson_ids[@]}"; do
    [ -n "$id" ] || continue
    seen_any=1
    cards="$(read_cards)"
    title="$(jq -r --arg id "$id" '.cards[] | select(.id==$id) | .title' <<<"$cards")"
    echo
    echo "=== Lesson: $title ==="
    while IFS= read -r line; do
      echo "  $line"
    done < <(jq -r --arg id "$id" '.cards[] | select(.id==$id) | .slides[]' <<<"$cards")
    read -r -p "-- press Enter when done --" _ || true
    cmd_lesson_seen "$id" >/dev/null
  done

  # 2. due quizzes, oldest first
  local due_ids=()
  mapfile -t due_ids < <(jq -n --argjson cards "$(read_cards)" --argjson now "$(now_ms)" '{cards:$cards.cards, now:$now, n:999}' | engine top | jq -r '.[].id')
  for id in "${due_ids[@]}"; do
    [ -n "$id" ] || continue
    seen_any=1
    cards="$(read_cards)"
    front="$(jq -r --arg id "$id" '.cards[] | select(.id==$id) | .front' <<<"$cards")"
    back="$(jq -r --arg id "$id" '.cards[] | select(.id==$id) | .back' <<<"$cards")"
    echo
    echo "  $front"
    read -r -p "-- press Enter to reveal --" _ || true
    echo "  -> $back"
    grade=""
    while [ -z "$grade" ]; do
      read -r -p "  [1]again  [2]hard  [3]good  [4]easy  [s]kip session: " choice || { grade=skip; break; }
      case "$choice" in
        1) grade=again ;; 2) grade=hard ;; 3) grade=good ;; 4) grade=easy ;;
        s|S) grade=skip ;;
        *) echo "  (enter 1-4 or s)" ;;
      esac
    done
    [ "$grade" = skip ] && { echo "session ended"; return 0; }
    cmd_grade "$id" "$grade" >/dev/null
  done

  [ "$seen_any" = 1 ] || echo "Nothing due. Deck is caught up."
  echo
  echo "session complete."
}

cmd_pause() {
  local min; min="$(dur_to_min "${1:-}")"
  [ "$min" -gt 0 ] 2>/dev/null || die "usage: omarchy-recall pause <2h|30m|90>"
  local until; until=$(( $(now_ms) + min * 60000 ))
  state_set ".pauseUntilMs = $until | .prompt = null"
  pulse_clear
  notify normal "😴 Recall paused" "No lessons or quizzes for ${min}m."
  echo "paused ${min}m"
}

cmd_resume() { state_set ".pauseUntilMs = 0"; echo "resumed"; }

cmd_on() {
  seed_cards
  read_config | jq '.enabled = true' | write_json "$CONFIG_FILE"
  ensure_daemon
  do_tick
  notify normal "🧠 Recall is on" "Short lessons + review check-ins will start. Pause anytime: omarchy-recall pause 2h"
  echo "on"
}

cmd_off() {
  read_config | jq '.enabled = false' | write_json "$CONFIG_FILE"
  state_set ".prompt = null"
  stop_daemon
  pulse_clear
  notify normal "🧠 Recall is off" "No more lessons or quizzes until you turn it back on."
  echo "off"
}

# ── the tick ───────────────────────────────────────────────────────────
do_tick() {
  local cfg st decision want reason ids kind
  cfg="$(read_config)"
  [ "$(jq -r '.enabled' <<<"$cfg")" = "true" ] || return 0
  st="$(read_state)"

  # 1. roll daily counters (lessonsToday reset, streakDays bump) if the day rolled over
  st="$(jq -n --argjson state "$st" --argjson now "$(now_ms)" '{state:$state, now:$now}' | engine roll-daily)"
  put_state <<<"$st"

  # 2. ask the engine what to show
  decision="$(jq -n --argjson config "$cfg" --argjson state "$st" --argjson cards "$(read_cards)" --argjson now "$(now_ms)" \
              '{config:$config, state:$state, cards:$cards.cards, now:$now}' | engine decide)"
  want="$(jq -r '.prompt // "none"' <<<"$decision")"

  # 3. raise a new prompt only when nothing is on screen yet
  if [ "$want" != "none" ] && [ "$(jq -r '.prompt' <<<"$st")" = "null" ]; then
    kind="$(jq -r '.prompt.kind' <<<"$decision")"
    ids="$(jq -c '.prompt.cardIds' <<<"$decision")"
    reason="$(jq -r '.prompt.reason' <<<"$decision")"
    local now; now="$(now_ms)"
    local extra=".lastPromptMs = \$now"
    if [ "$kind" = "lesson" ]; then
      extra=".lessonsToday = (.lessonsToday + 1) | .lastLessonMs = \$now"
    fi
    jq --argjson ids "$ids" --arg reason "$reason" --arg kind "$kind" --argjson now "$now" \
      ".prompt = {kind:\$kind, cardIds:\$ids, reason:\$reason} | $extra" <<<"$st" | put_state
    if [ "$kind" = "takeover" ]; then
      notify critical "🧠 Recall — deal with this" "$(top_lines)"
    elif [ "$kind" = "lesson" ]; then
      notify normal "🧠 New lesson ready" "A short technique lesson is queued."
    else
      notify normal "🧠 Recall check-in" "$(top_lines)"
    fi
    pulse_prompt "$kind"
  fi
}

run_loop() {
  do_tick
  while :; do
    sleep "$TICK_SECONDS"
    [ "$(jq -r '.enabled' <<<"$(read_config)")" = "true" ] || break
    do_tick
  done
}

seed_config

case "${1:-status}" in
  __run)              run_loop ;;
  add-quiz)           shift; cmd_add_quiz "$@" ;;
  add-lesson)         shift; cmd_add_lesson "$@" ;;
  drop|rm)            shift; cmd_drop "$@" ;;
  grade)              shift; cmd_grade "$@" ;;
  lesson-seen)        shift; cmd_lesson_seen "$@" ;;
  list|ls)            cmd_list ;;
  get)                read_cards | jq . ;;
  get-state)          read_state | jq . ;;
  status)             cmd_status ;;
  stats)              cmd_stats ;;
  tick)               do_tick ;;
  checkin)            cmd_checkin ;;
  ack)                shift; cmd_ack "$@" ;;
  generate-trivia)    shift; cmd_generate_trivia "$@" ;;
  generate-vocab)     shift; cmd_generate_vocab "$@" ;;
  review)             cmd_review ;;
  pause)              shift; cmd_pause "$@" ;;
  resume)             cmd_resume ;;
  on)                 cmd_on ;;
  off)                cmd_off ;;
  -h|--help|help)     sed -n '2,45p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "omarchy-recall: unknown command '${1}' (try --help)" >&2; exit 2 ;;
esac
