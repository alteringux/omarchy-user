#!/usr/bin/env bash
# omarchy-breathe — the guided-breathing engine + daemon.
#
# Sole writer of ~/.local/state/omarchy/breathe-session.json, -stats.json and
# -history.json. A `systemd --user` transient unit (this script, `__run`) owns
# the tick, the phase-boundary cues, session completion and the streak/stats
# bookkeeping, so a session keeps running with the panel closed. The
# alteringux.breathe bar widget is a thin view: it watches the files and calls
# the verbs below, reconstructing the between-heartbeat frames itself.
# It still owns breathe-config.json (defaults / sounds / nudge / custom
# patterns), which this script reads and seeds but never mutates.
# See ~/.config/omarchy/docs/adr/0006-cli-first-plugins.md.
#
#   omarchy-breathe get                 print breathe-session.json
#   omarchy-breathe status              live { state, phaseKind, phaseRemainingMs, ... }
#   omarchy-breathe start [id] [--cycles N] [--silent]
#   omarchy-breathe toggle              IDLE->start · RUNNING<->PAUSED · DONE->start again
#   omarchy-breathe pause | resume      the explicit forms of toggle
#   omarchy-breathe stop                end now; credited if at least one cycle ran
#   omarchy-breathe reset               back to IDLE, stop the daemon, credit nothing
#   omarchy-breathe restore             reconcile a session persisted across a reboot
#   omarchy-breathe techniques          the catalogue (built-ins + customs) as JSON
#   omarchy-breathe stats | history     print those files
#
# Env: OMARCHY_STATE_DIR overrides the state dir (tests).
#      OMARCHY_BREATHE_NO_DAEMON=1 skips all systemd calls (tests).
#      OMARCHY_BREATHE_QUIET=1 skips notify-send / sound (tests).
set -euo pipefail

STATE_DIR="${OMARCHY_STATE_DIR:-$HOME/.local/state/omarchy}"
CONFIG_FILE="$STATE_DIR/breathe-config.json"
SESSION_FILE="$STATE_DIR/breathe-session.json"
STATS_FILE="$STATE_DIR/breathe-stats.json"
HISTORY_FILE="$STATE_DIR/breathe-history.json"
UNIT="omarchy-breathe"

