# ── jq helpers ────────────────────────────────────────────────────────
# Phase resolution, mirroring Model.js's resolve(): map an elapsed-ms position
# onto the repeating phase list. Only the parts the daemon needs — the widget
# does the frame-accurate version in QML.
# The $-names below are jq's own variables, bound by --argjson at each call
# site; the shell must NOT expand them, so the quoting is deliberate.
# shellcheck disable=SC2016
PLIB='
def cycle_ms: ([.phases[].seconds] | add) * 1000;
def resolve($elapsed; $cycles):
  . as $t
  | (cycle_ms) as $cycleMs
  | ($cycleMs * $cycles) as $total
  | (if $elapsed >= $total then (if $total > 0 then $total - 1 else 0 end) else $elapsed end) as $pos
  | (if $cycleMs > 0 then (($pos / $cycleMs) | floor) else 0 end) as $ci
  | ($pos - ($ci * $cycleMs)) as $into
  | (reduce range(0; ($t.phases | length)) as $i ({idx: 0, acc: 0, found: false};
      if .found then .
      else ($t.phases[$i].seconds * 1000) as $span
        | if $into < (.acc + $span) then {idx: $i, acc: .acc, found: true}
          else {idx: $i, acc: (.acc + $span), found: false} end
      end)) as $r
  | {cycleIndex: $ci, phaseIndex: $r.idx, cycleMs: $cycleMs, totalMs: $total,
     phaseKind: $t.phases[$r.idx].kind,
     phaseLabel: ($t.phases[$r.idx].label // $t.phases[$r.idx].kind),
     phaseDurationMs: ($t.phases[$r.idx].seconds * 1000),
     phaseElapsedMs: ($into - $r.acc),
     done: ($elapsed >= $total)};
'

# ── readers ───────────────────────────────────────────────────────────
seed_config() {
  [ -f "$CONFIG_FILE" ] && jq -e . "$CONFIG_FILE" >/dev/null 2>&1 && return 0
  printf '%s' "$DEFAULT_CONFIG" | jq . > "$CONFIG_FILE"
}
read_config()  { seed_config; jq -e . "$CONFIG_FILE" 2>/dev/null || printf '%s' "$DEFAULT_CONFIG"; }
read_session() { { [ -f "$SESSION_FILE" ] && jq -e . "$SESSION_FILE" 2>/dev/null; } || printf '%s' "$DEFAULT_SESSION"; }
read_stats()   { { [ -f "$STATS_FILE" ]   && jq -e . "$STATS_FILE"   2>/dev/null; } || printf '%s' "$DEFAULT_STATS"; }
read_history() { { [ -f "$HISTORY_FILE" ] && jq -e . "$HISTORY_FILE" 2>/dev/null; } || printf '%s' "$DEFAULT_HISTORY"; }

# Built-ins plus whatever the widget has stored as custom patterns. Customs
# override a built-in of the same id so a hand-edited copy wins, which is what
# a user editing their own config would expect.
read_techniques() {
  jq -n --argjson builtin "$BUILTIN_TECHNIQUES" --argjson cfg "$(read_config)" '
    ($cfg.customTechniques // []) as $custom
    | ($custom | map(select(.id != null and .id != "")))  as $valid
    | ($builtin | map(select(.id as $i | ($valid | map(.id) | index($i)) | not))) + $valid
  '
}

technique_by_id() {   # $1 = id; prints the technique object, or empty on miss
  read_techniques | jq -e --arg id "$1" '.[] | select(.id == $id)' 2>/dev/null || true
}

write_json() {   # $1 = file; stdin = JSON
  local target="$1" tmp
  tmp="$target.tmp.$$"
  if jq . > "$tmp" && [ -s "$tmp" ]; then
    mv -f "$tmp" "$target"
  else
    rm -f "$tmp"
    echo "omarchy-breathe: refusing to write empty/invalid JSON to $target" >&2
    return 1
  fi
}
put_session() { write_json "$SESSION_FILE"; }

# ── side effects (skipped when QUIET or the session is silent) ────────
session_is_silent() {
  local sess; sess="$(read_session)"
  [ "$(jq -r '.silent // false' <<<"$sess")" = "true" ] && return 0
  [ "$(jq -r '.silent // false' <<<"$(read_config)")" = "true" ] && return 0
  return 1
}

play_file() {   # $1 = path
  local path="$1"
  [ -n "$path" ] || return 0
  [ -f "$path" ] || return 0
  # Gate on the shared mute helper so a cue never wakes a device the user
  # deliberately silenced; a broken sound stack fails open and still plays.
  if [ -r "$HOME/.local/bin/omarchy-audio-lib" ]; then
    # shellcheck disable=SC1091
    source "$HOME/.local/bin/omarchy-audio-lib"
    omarchy_output_muted && return 0
  fi
  ( command -v mpv >/dev/null 2>&1 && exec mpv --no-video --really-quiet "$path"
    command -v paplay >/dev/null 2>&1 && exec paplay "$path"
    command -v pw-play >/dev/null 2>&1 && exec pw-play "$path"
    exec canberra-gtk-play -f "$path" ) >/dev/null 2>&1 &
}

play_phase_cue() {
  [ "${OMARCHY_BREATHE_QUIET:-0}" = 1 ] && return 0
  session_is_silent && return 0
  local configured; configured="$(jq -r '.phaseSound // ""' <<<"$(read_config)")"
  play_file "${configured:-$DEFAULT_SOUND}"
}

play_end_cue() {
  [ "${OMARCHY_BREATHE_QUIET:-0}" = 1 ] && return 0
  session_is_silent && return 0
  local configured; configured="$(jq -r '.endSound // ""' <<<"$(read_config)")"
  play_file "${configured:-$DEFAULT_END_SOUND}"
}

notify_end() {   # $1 = technique name, $2 = seconds, $3 = cycles
  [ "${OMARCHY_BREATHE_QUIET:-0}" = 1 ] && return 0
  [ "$(jq -r '.notifyOnEnd // true' <<<"$(read_config)")" = "true" ] || return 0
  local mins=$(( ($2 + 30) / 60 ))
  notify-send -a "Breathe" "󰗑 $1 complete" \
    "$3 cycles · ${mins} min. Streak: $(jq -r '.streak // 0' <<<"$(read_stats)") days." 2>/dev/null || true
}

# ── daemon lifecycle (stubbed by NO_DAEMON) ──────────────────────────
daemon_active() {
  [ "${OMARCHY_BREATHE_NO_DAEMON:-0}" = 1 ] && return 1
  systemctl --user is-active --quiet "${UNIT}.service" 2>/dev/null
}
ensure_daemon() {
  [ "${OMARCHY_BREATHE_NO_DAEMON:-0}" = 1 ] && return 0
  daemon_active && return 0
  systemctl --user reset-failed "${UNIT}.service" 2>/dev/null || true
  systemd-run --user --unit="$UNIT" --collect \
    --description="Omarchy breathing session" -- "$0" __run >/dev/null 2>&1 || true
}
stop_daemon() {
  [ "${OMARCHY_BREATHE_NO_DAEMON:-0}" = 1 ] && return 0
  systemctl --user stop "${UNIT}.service" 2>/dev/null || true
}

# ── crediting ─────────────────────────────────────────────────────────
# A session counts only once at least one whole cycle has run: half an inhale
# is not a breathing session, and crediting it would make the streak lie.
credit_session() {   # $1 = session JSON, $2 = elapsedMs, $3 = completed(true|false)
  local sess="$1" elapsed="$2" completed="$3"
  local tid technique cycleMs cycles seconds doneCycles name
  tid="$(jq -r '.techniqueId' <<<"$sess")"
  technique="$(technique_by_id "$tid")"
  [ -n "$technique" ] || return 0

  cycleMs="$(jq -r "$PLIB cycle_ms" <<<"$technique")"
  cycles="$(jq -r '.cycles' <<<"$sess")"
  [ "$cycleMs" -gt 0 ] 2>/dev/null || return 0

  # Clamp HERE, at the one place that writes the record, rather than trusting
  # every caller to have done it. A session can legitimately overrun its
  # planned length — the daemon sleeps between ticks, the machine suspends, a
  # long pause shifts the arithmetic — and a stat that says you breathed for
  # longer than the exercise lasts is simply wrong. Belt and braces: the stop
  # and restore paths clamp too, but this is the invariant that matters.
  local plannedMs=$(( cycleMs * cycles ))
  (( plannedMs > 0 && elapsed > plannedMs )) && elapsed=$plannedMs

  doneCycles=$(( elapsed / cycleMs ))
  (( doneCycles < 1 )) && return 0
  (( doneCycles > cycles )) && doneCycles=$cycles
  seconds=$(( (elapsed + 500) / 1000 ))
  name="$(jq -r '.name' <<<"$technique")"

  read_history | jq \
    --arg id "$(jq -r '.sessionId' <<<"$sess")" \
    --arg tid "$tid" \
    --argjson started "$(jq -r '.startedAtMs' <<<"$sess")" \
    --argjson seconds "$seconds" \
    --argjson cycles "$doneCycles" \
    --argjson planned "$cycles" \
    --argjson completed "$completed" \
    --argjson cap "$SESSION_HISTORY_MAX" '
      .sessions = ((.sessions // []) + [{
        id: $id, techniqueId: $tid, startedAtMs: $started,
        seconds: $seconds, cycles: $cycles, plannedCycles: $planned, completed: $completed
      }])
      | (if (.sessions | length) > $cap then .sessions |= .[-$cap:] else . end)
      | .version = 1
    ' | write_json "$HISTORY_FILE"

  read_stats | jq \
    --arg today "$(today)" \
    --arg yesterday "$(yesterday)" \
    --argjson seconds "$seconds" \
    --argjson cycles "$doneCycles" \
    --argjson days "$DAILY_HISTORY_DAYS" '
      .daily[$today] = {
        sessions: (((.daily[$today].sessions) // 0) + 1),
        seconds:  (((.daily[$today].seconds)  // 0) + $seconds),
        cycles:   (((.daily[$today].cycles)   // 0) + $cycles)
      }
      | .totals = {
          sessions: (((.totals.sessions) // 0) + 1),
          seconds:  (((.totals.seconds)  // 0) + $seconds),
          cycles:   (((.totals.cycles)   // 0) + $cycles)
        }
      # Same day is idempotent, a consecutive day extends, any gap restarts.
      | .streak = (if (.lastActiveDate // "") == $today then (.streak // 0)
                   elif (.lastActiveDate // "") == $yesterday then ((.streak // 0) + 1)
                   else 1 end)
      | .bestStreak = ([(.bestStreak // 0), .streak] | max)
      | .lastActiveDate = $today
      | .daily |= (to_entries | sort_by(.key) | .[-$days:] | from_entries)
      | .version = 1
    ' | write_json "$STATS_FILE"

  printf '%s\t%s\t%s' "$name" "$seconds" "$doneCycles"
}

# ── verbs ─────────────────────────────────────────────────────────────
cmd_start() {
  local tid="" cycles="" silent="false"
  while [ $# -gt 0 ]; do
    case "$1" in
      --cycles) cycles="${2:-}"; shift 2 ;;
      --silent) silent="true"; shift ;;
      --*) echo "omarchy-breathe: unknown option '$1'" >&2; exit 2 ;;
      *) tid="$1"; shift ;;
    esac
  done

  local cfg; cfg="$(read_config)"
  [ -n "$tid" ] || tid="$(jq -r '.defaultTechniqueId // "box"' <<<"$cfg")"

  local technique; technique="$(technique_by_id "$tid")"
  if [ -z "$technique" ]; then
    echo "omarchy-breathe: unknown technique '$tid' (try: omarchy-breathe techniques)" >&2
    exit 2
  fi

  if [ -z "$cycles" ]; then
    cycles="$(jq -r '.defaultCycles // empty' <<<"$technique")"
    [ -n "$cycles" ] || cycles="$(jq -r '.defaultCycles // 8' <<<"$cfg")"
  fi
  case "$cycles" in (*[!0-9]*|"") echo "omarchy-breathe: --cycles needs a positive integer" >&2; exit 2 ;; esac
  [ "$cycles" -ge 1 ] || { echo "omarchy-breathe: --cycles needs a positive integer" >&2; exit 2; }

  [ "$silent" = "true" ] || silent="$(jq -r '.silent // false' <<<"$cfg")"

  local now; now="$(now_ms)"
  jq -n --arg tid "$tid" --argjson cycles "$cycles" --arg sid "$(new_id)" \
        --argjson now "$now" --argjson silent "$silent" '
    {version:1, state:"RUNNING", techniqueId:$tid, cycles:$cycles, sessionId:$sid,
     startedAtMs:$now, savedAtMs:$now, elapsedMs:0, silent:$silent}
  ' | put_session
  ensure_daemon
  cmd_status
}

cmd_pause() {
  local sess; sess="$(read_session)"
  [ "$(jq -r '.state' <<<"$sess")" = "RUNNING" ] || { cmd_status; return 0; }
  local now elapsed
  now="$(now_ms)"
  elapsed=$(( $(jq -r '.elapsedMs' <<<"$sess") + (now - $(jq -r '.savedAtMs' <<<"$sess")) ))
  (( elapsed < 0 )) && elapsed=0
  jq --argjson e "$elapsed" --argjson n "$now" '.state="PAUSED" | .elapsedMs=$e | .savedAtMs=$n' \
    <<<"$sess" | put_session
  cmd_status
}

cmd_resume() {
  local sess; sess="$(read_session)"
  [ "$(jq -r '.state' <<<"$sess")" = "PAUSED" ] || { cmd_status; return 0; }
  jq --argjson n "$(now_ms)" '.state="RUNNING" | .savedAtMs=$n' <<<"$sess" | put_session
  ensure_daemon
  cmd_status
}

cmd_toggle() {
  case "$(jq -r '.state' <<<"$(read_session)")" in
    RUNNING) cmd_pause ;;
    PAUSED)  cmd_resume ;;
    *)       cmd_start ;;
  esac
}

# End the session now. Credited when at least one cycle ran; `completed` is
# true only if it actually reached its planned length.
finish_session() {   # $1 = credit(true|false)
  local sess state elapsed technique totalMs completed credited
  sess="$(read_session)"
  state="$(jq -r '.state' <<<"$sess")"
  if [ "$state" = "IDLE" ]; then cmd_status; return 0; fi

  elapsed="$(jq -r '.elapsedMs' <<<"$sess")"
  if [ "$state" = "RUNNING" ]; then
    elapsed=$(( elapsed + ($(now_ms) - $(jq -r '.savedAtMs' <<<"$sess")) ))
  fi
  (( elapsed < 0 )) && elapsed=0

  completed=false
  technique="$(technique_by_id "$(jq -r '.techniqueId' <<<"$sess")")"
  if [ -n "$technique" ]; then
    totalMs=$(( $(jq -r "$PLIB cycle_ms" <<<"$technique") * $(jq -r '.cycles' <<<"$sess") ))
    (( elapsed >= totalMs )) && { completed=true; elapsed=$totalMs; }
  fi

  credited=""
  if [ "$1" = "true" ]; then
    credited="$(credit_session "$sess" "$elapsed" "$completed")"
  fi

  jq --argjson e "$elapsed" --argjson n "$(now_ms)" '.state="DONE" | .elapsedMs=$e | .savedAtMs=$n' \
    <<<"$sess" | put_session
  stop_daemon

  if [ -n "$credited" ]; then
    play_end_cue
    IFS=$'\t' read -r name seconds cycles <<<"$credited"
    notify_end "$name" "$seconds" "$cycles"
  fi
}

cmd_reset() {
  printf '%s' "$DEFAULT_SESSION" | put_session
  stop_daemon
  cmd_status
}

# Reconcile a session persisted across a restart. A RUNNING session whose
# planned length ran out while the machine was off is credited and parked in
# DONE rather than resumed as a phantom timer; one still legitimately mid-flight
# gets its daemon back.
do_restore() {
  local sess state technique totalMs elapsed
  sess="$(read_session)"
  state="$(jq -r '.state' <<<"$sess")"
  [ "$state" = "RUNNING" ] || return 0

  technique="$(technique_by_id "$(jq -r '.techniqueId' <<<"$sess")")"
  if [ -z "$technique" ]; then
    # The technique was deleted under a live session; nothing sane to resume to.
    printf '%s' "$DEFAULT_SESSION" | put_session
    return 0
  fi

  totalMs=$(( $(jq -r "$PLIB cycle_ms" <<<"$technique") * $(jq -r '.cycles' <<<"$sess") ))
  elapsed=$(( $(jq -r '.elapsedMs' <<<"$sess") + ($(now_ms) - $(jq -r '.savedAtMs' <<<"$sess")) ))
  (( elapsed < 0 )) && elapsed=0

  if (( elapsed >= totalMs )); then
    credit_session "$sess" "$totalMs" true >/dev/null
    jq --argjson e "$totalMs" --argjson n "$(now_ms)" '.state="DONE" | .elapsedMs=$e | .savedAtMs=$n' \
      <<<"$sess" | put_session
  fi
}

restore_and_ensure() {
  do_restore
  [ "$(jq -r '.state' <<<"$(read_session)")" = "RUNNING" ] && ensure_daemon
  cmd_status
}

cmd_status() {
  local sess technique state elapsed
  sess="$(read_session)"
  state="$(jq -r '.state' <<<"$sess")"
  technique="$(technique_by_id "$(jq -r '.techniqueId' <<<"$sess")")"
  [ -n "$technique" ] || technique='null'

  elapsed="$(jq -r '.elapsedMs' <<<"$sess")"
  if [ "$state" = "RUNNING" ]; then
    elapsed=$(( elapsed + ($(now_ms) - $(jq -r '.savedAtMs' <<<"$sess")) ))
    (( elapsed < 0 )) && elapsed=0
  fi

  jq -n \
    --argjson session "$sess" \
    --argjson technique "$technique" \
    --argjson stats "$(read_stats)" \
    --argjson elapsed "$elapsed" \
    --arg today "$(today)" "$PLIB"'
      ($session.cycles // 0) as $cycles
      | (if $technique == null then null else ($technique | resolve($elapsed; $cycles)) end) as $r
      | {state: $session.state,
         techniqueId: $session.techniqueId,
         techniqueName: (($technique.name) // ""),
         cycles: $cycles,
         silent: ($session.silent // false),
         elapsedMs: $elapsed,
         phaseKind: (($r.phaseKind) // ""),
         phaseLabel: (($r.phaseLabel) // ""),
         phaseRemainingMs: (if $r == null then 0 else (($r.phaseDurationMs - $r.phaseElapsedMs) | if . < 0 then 0 else . end) end),
         cycleIndex: (($r.cycleIndex) // 0),
         cycleCount: $cycles,
         sessionDurationMs: (($r.totalMs) // 0),
         sessionFraction: (if ($r.totalMs // 0) > 0 then ([$elapsed / $r.totalMs, 1] | min) else 0 end),
         done: (($r.done) // false),
         streak: ($stats.streak // 0),
         bestStreak: ($stats.bestStreak // 0),
         todaySeconds: (($stats.daily[$today].seconds) // 0),
         todaySessions: (($stats.daily[$today].sessions) // 0)}
    '
}

# ── the daemon ────────────────────────────────────────────────────────
# Owns the tick, the phase-boundary cues and completion. It deliberately does
# NOT write a frame per phase: the widget reconstructs those locally from
# savedAtMs, so this only heartbeats every few seconds.
#
# Everything invariant for the session — the phase durations, the cue path,
# whether it is silent — is resolved ONCE up front into shell variables, and
# the per-tick work is then pure bash arithmetic plus a single jq read of the
# session file. An earlier version resolved the phase through jq on every
# 0.25s tick and cost ~22% of a core for the length of a session; a breathing
# timer that heats the laptop rather rather defeats the point.
#
# The wait is until the next phase boundary, capped at 500ms so an external
# pause or stop is still noticed promptly. Bellows' one-second phases are why
# the cap is sub-second rather than pomodoro's flat 1s poll.
run_loop() {
  do_restore

  local sess technique state cycles
  sess="$(read_session)"
  technique="$(technique_by_id "$(jq -r '.techniqueId' <<<"$sess")")"
  [ -n "$technique" ] || return 0

  local -a phase_ms=()
  mapfile -t phase_ms < <(jq -r '.phases[] | (.seconds * 1000 | floor)' <<<"$technique")
  local phase_count=${#phase_ms[@]}
  (( phase_count > 0 )) || return 0

  local cycle_ms=0 p
  for p in "${phase_ms[@]}"; do cycle_ms=$(( cycle_ms + p )); done
  (( cycle_ms > 0 )) || return 0

  # Cue policy is config, which is widget-owned and effectively static for the
  # length of one session, so resolve it here instead of per boundary.
  local cue_path silent cfg
  cfg="$(read_config)"
  silent="$(jq -r '.silent // false' <<<"$cfg")"
  [ "$(jq -r '.silent // false' <<<"$sess")" = "true" ] && silent=true
  cue_path="$(jq -r '.phaseSound // ""' <<<"$cfg")"
  [ -n "$cue_path" ] || cue_path="$DEFAULT_SOUND"

  local hb=0 last_index=-1 now elapsed base saved total_ms into acc idx i index wait_ms

  while :; do
    # One jq call per tick, reading every field at once.
    IFS=$'\t' read -r state base saved cycles < <(
      jq -r '[(.state // "IDLE"), (.elapsedMs // 0 | floor), (.savedAtMs // 0 | floor), (.cycles // 0 | floor)] | @tsv' \
        "$SESSION_FILE" 2>/dev/null
    ) || break
    [ -n "$state" ] || break

    case "$state" in
      IDLE|DONE) break ;;
      PAUSED) sleep 0.4; continue ;;
    esac

    now="$(now_ms)"
    elapsed=$(( base + now - saved ))
    (( elapsed < 0 )) && elapsed=0
    total_ms=$(( cycle_ms * cycles ))

    if (( total_ms > 0 && elapsed >= total_ms )); then
      finish_session true
      break
    fi

    # Phase lookup in pure bash — this is the part that used to be a jq fork.
    into=$(( elapsed % cycle_ms ))
    acc=0; idx=$(( phase_count - 1 ))
    for i in "${!phase_ms[@]}"; do
      if (( into < acc + phase_ms[i] )); then idx=$i; break; fi
      acc=$(( acc + phase_ms[i] ))
    done

    # A monotonically increasing index, so a boundary is simply a change and
    # each cue fires exactly once even across a cycle wrap.
    index=$(( (elapsed / cycle_ms) * phase_count + idx ))
    if (( last_index >= 0 && index != last_index )) && [ "$silent" != "true" ] \
       && [ "${OMARCHY_BREATHE_QUIET:-0}" != 1 ]; then
      play_file "$cue_path"
    fi
    last_index=$index

    if (( now - hb >= 5000 )); then
      hb="$now"
      jq --argjson e "$elapsed" --argjson n "$now" '.elapsedMs=$e | .savedAtMs=$n' \
        "$SESSION_FILE" 2>/dev/null | put_session || true
    fi

    wait_ms=$(( acc + phase_ms[idx] - into ))
    (( wait_ms > 500 )) && wait_ms=500
    (( wait_ms < 40 )) && wait_ms=40
    sleep "$(printf '%d.%03d' $(( wait_ms / 1000 )) $(( wait_ms % 1000 )))"
  done
}

seed_config

case "${1:-get}" in
  __run)           run_loop ;;
  get)             read_session | jq . ;;
  status)          cmd_status ;;
  start)           shift; cmd_start "$@" ;;
  toggle)          cmd_toggle ;;
  pause)           cmd_pause ;;
  resume)          cmd_resume ;;
  stop)            finish_session true; cmd_status ;;
  reset)           cmd_reset ;;
  restore)         restore_and_ensure ;;
  techniques)      read_techniques ;;
  stats)           read_stats | jq . ;;
  history)         read_history | jq . ;;
  -h|--help|help)  sed -n '2,29p' "$0" ;;
  *) echo "omarchy-breathe: unknown command '${1}' (try --help)" >&2; exit 2 ;;
esac
