#!/usr/bin/env bash
# omarchy-grip — an intrusive "get a grip on things" task wall.
#
# Sole writer of ~/.local/state/omarchy/grip-state.json and grip-tasks.json.
# A `systemd --user` transient unit (this script, `__run`) ticks once a minute:
# it reseeds the day's routine rows, then asks the shared decision engine
# (Model.js, via grip-cli.js) whether a check-in is due or things have
# escalated to a fullscreen takeover — and raises that prompt in grip-state.json
# plus a notification. The alteringux.grip bar widget is a thin view: it watches
# the files, shows the prompt surface, and calls the verbs below.
# grip-config.json (cadence knobs + the daily routine list) is seeded once and
# meant to be hand-edited. See ~/.config/omarchy/docs/adr/0006-cli-first-plugins.md.
#
#   omarchy-grip add <text...> [--due <when>] [--hard]   add a task
#                                                        --due: "17:00", "tomorrow 9am", ISO
#                                                        --hard: a real deadline (escalates on due)
#   omarchy-grip done <id>                add-list id -> done
#   omarchy-grip drop <id>               remove a task
#   omarchy-grip list                    the open wall, loudest first
#   omarchy-grip get | get-state         raw grip-tasks.json / grip-state.json
#   omarchy-grip status                  live { prompt, reason, open, overdue, ... }
#   omarchy-grip checkin                 raise a check-in now (keybind target)
#   omarchy-grip ack <checkin|takeover> [--did <id>] [--snooze <min>]
#                                        respond to the on-screen prompt
#   omarchy-grip pause <dur>             mute all prompts for a while (2h, 30m, 90)
#   omarchy-grip resume                  end a pause early
#   omarchy-grip on | off               enable / disable the whole thing (starts off)
#   omarchy-grip routines               print the configured daily routines
#
# Env: OMARCHY_STATE_DIR   override the state dir (tests)
#      OMARCHY_GRIP_DIR    override the plugin dir holding Model.js / grip-cli.js
#      OMARCHY_GRIP_NO_DAEMON=1  skip all systemd calls (tests)
#      OMARCHY_GRIP_QUIET=1      skip notify-send (tests)
#      OMARCHY_GRIP_TICK_SECONDS override the 60s daemon cadence (tests)
set -euo pipefail

STATE_DIR="${OMARCHY_STATE_DIR:-$HOME/.local/state/omarchy}"
GRIP_DIR="${OMARCHY_GRIP_DIR:-$HOME/.config/omarchy/plugins/alteringux.grip}"
CONFIG_FILE="$STATE_DIR/grip-config.json"
STATE_FILE="$STATE_DIR/grip-state.json"
TASKS_FILE="$STATE_DIR/grip-tasks.json"
ENGINE="$GRIP_DIR/grip-cli.js"
UNIT="omarchy-grip"
TICK_SECONDS="${OMARCHY_GRIP_TICK_SECONDS:-60}"

DEFAULT_CONFIG='{"version":1,"baseIntervalMin":20,"minIntervalMin":8,"maxIntervalMin":45,"overdueTakeoverHours":2,"dismissTakeoverStreak":3,"snoozeMinutes":[15,60],"routines":[]}'
DEFAULT_STATE='{"version":1,"enabled":false,"prompt":null,"dismissStreak":0,"lastPromptMs":0,"pauseUntilMs":0,"routinesDate":""}'
DEFAULT_TASKS='{"version":1,"tasks":[]}'

mkdir -p "$STATE_DIR"

die()    { echo "omarchy-grip: $*" >&2; exit 1; }
now_ms() { date +%s%3N; }
today()  { date +%F; }
have()   { command -v "$1" >/dev/null 2>&1; }

have jq   || die "jq not found"
have node || die "node not found"
[ -f "$ENGINE" ] || die "engine not found at $ENGINE (set OMARCHY_GRIP_DIR)"

# ── file IO ────────────────────────────────────────────────────────────────
write_json() {   # $1 = file; stdin = JSON
  local target="$1" tmp
  tmp="$target.tmp.$$"
  if jq . >"$tmp" 2>/dev/null && [ -s "$tmp" ]; then
    mv -f "$tmp" "$target"
  else
    rm -f "$tmp"
    echo "omarchy-grip: refusing to write invalid JSON to $target" >&2
    return 1
  fi
}

seed_config() {
  [ -f "$CONFIG_FILE" ] && return 0
  printf '%s\n' "$DEFAULT_CONFIG" | write_json "$CONFIG_FILE"
}
read_config() { seed_config; jq -e . "$CONFIG_FILE" 2>/dev/null || printf '%s' "$DEFAULT_CONFIG"; }
read_state()  { { [ -f "$STATE_FILE" ] && jq -e . "$STATE_FILE" 2>/dev/null; } || printf '%s' "$DEFAULT_STATE"; }
read_tasks()  { { [ -f "$TASKS_FILE" ] && jq -e . "$TASKS_FILE" 2>/dev/null; } || printf '%s' "$DEFAULT_TASKS"; }

put_state() { write_json "$STATE_FILE"; }
put_tasks() { write_json "$TASKS_FILE"; }

# ── engine bridge ─────────────────────────────────────────────────────────
# engine <op>  — payload on stdin, result on stdout
engine() { node "$ENGINE" "$1"; }

# ── side effects ─────────────────────────────────────────────────────────
notify() {   # $1 = urgency (normal|critical), $2 = title, $3 = body
  [ "${OMARCHY_GRIP_QUIET:-0}" = 1 ] && return 0
  have notify-send || return 0
  notify-send -a "Grip" -u "$1" "$2" "$3" 2>/dev/null || true
}

# Mirror the on-screen prompt into the shared alteringux.pulse feed, so the
# Pulse bell widget reddens and offers the check-in too. Best-effort — a
# missing or failing omarchy-pulse must never break a grip run.
pulse_prompt() {   # $1 = checkin|takeover
  command -v omarchy-pulse >/dev/null 2>&1 || return 0
  local lvl label
  if [ "$1" = "takeover" ]; then lvl=critical; label="Deal with this now"; else lvl=urgent; label="Check-in due"; fi
  omarchy-pulse attention alteringux.grip --label "$label" --level "$lvl" \
    --action "omarchy-shell alteringux.grip checkin" --action-label "Check in" >/dev/null 2>&1 || true
}
pulse_clear() {
  command -v omarchy-pulse >/dev/null 2>&1 || return 0
  omarchy-pulse clear alteringux.grip >/dev/null 2>&1 || true
}

top_lines() {   # top 3 open task texts, newline-joined
  jq -n --argjson tasks "$(read_tasks)" --argjson now "$(now_ms)" '{tasks:$tasks, now:$now, n:3}' \
    | engine top \
    | jq -r '.[].text' | sed 's/^/• /' | paste -sd '\n' -
}

# ── daemon lifecycle ────────────────────────────────────────────────────
daemon_active() {
  [ "${OMARCHY_GRIP_NO_DAEMON:-0}" = 1 ] && return 1
  systemctl --user is-active --quiet "${UNIT}.service" 2>/dev/null
}
ensure_daemon() {
  [ "${OMARCHY_GRIP_NO_DAEMON:-0}" = 1 ] && return 0
  daemon_active && return 0
  systemd-run --user --unit="$UNIT" --collect \
    --description="Omarchy grip task wall" -- "$0" __run >/dev/null 2>&1 || true
}
stop_daemon() {
  [ "${OMARCHY_GRIP_NO_DAEMON:-0}" = 1 ] && return 0
  systemctl --user stop "${UNIT}.service" 2>/dev/null || true
}

# ── helpers ────────────────────────────────────────────────────────────
# 8 hex chars from a fixed 4-byte read — no `head` on a pipe (that SIGPIPEs
# `tr`/`/dev/urandom` and trips pipefail).
new_id() { od -An -N4 -tx1 /dev/urandom | tr -d ' \n'; }

# minutes from "2h" / "30m" / "90"
dur_to_min() {
  local raw="${1:-}"
  case "$raw" in
    *h) echo $(( ${raw%h} * 60 )) ;;
    *m) echo "${raw%m}" ;;
    ''|*[!0-9]*) die "bad duration: '$raw' (try 2h, 30m, 90)" ;;
    *) echo "$raw" ;;
  esac
}

# epoch ms from a natural "when"; a bare HH:MM already >2h in the past rolls to
# tomorrow (you meant the next one).
due_to_ms() {
  local raw="$1" ms now
  ms="$(date -d "$raw" +%s%3N 2>/dev/null)" || die "don't understand --due '$raw'"
  now="$(now_ms)"
  if [[ "$raw" =~ ^[0-2]?[0-9]:[0-5][0-9]$ ]] && (( ms < now - 7200000 )); then
    ms="$(date -d "tomorrow $raw" +%s%3N 2>/dev/null)" || true
  fi
  echo "$ms"
}

state_set() {   # jq expression that transforms the state object
  read_state | jq "$1" | put_state
}

# ── verbs ──────────────────────────────────────────────────────────────
cmd_add() {
  local hard=false due_ms=null text_parts=()
  while (($#)); do
    case "$1" in
      --hard) hard=true; shift ;;
      --due|-d) due_ms="$(due_to_ms "${2:-}")"; shift 2 ;;
      --) shift; while (($#)); do text_parts+=("$1"); shift; done ;;
      -*) die "unknown option: $1" ;;
      *) text_parts+=("$1"); shift ;;
    esac
  done
  local text="${text_parts[*]:-}"
  [ -n "${text// /}" ] || die "nothing to add"

  local id; id="$(new_id)"
  jq -n --argjson tasks "$(read_tasks)" \
        --arg id "$id" --argjson now "$(now_ms)" \
        --arg text "$text" --argjson due "$due_ms" --argjson hard "$hard" \
        '{tasks:$tasks, id:$id, now:$now, input:{text:$text, due:$due, hard:$hard}}' \
    | engine add | put_tasks
  echo "added $id  $text"
}

cmd_done() {
  local id="${1:-}"; [ -n "$id" ] || die "usage: omarchy-grip done <id>"
  jq -n --argjson tasks "$(read_tasks)" --arg id "$id" '{tasks:$tasks, id:$id}' \
    | engine complete | put_tasks
  echo "done $id"
}

cmd_drop() {
  local id="${1:-}"; [ -n "$id" ] || die "usage: omarchy-grip drop <id>"
  jq -n --argjson tasks "$(read_tasks)" --arg id "$id" '{tasks:$tasks, id:$id}' \
    | engine drop | put_tasks
  echo "dropped $id"
}

cmd_list() {
  jq -n --argjson tasks "$(read_tasks)" --argjson now "$(now_ms)" '{tasks:$tasks, now:$now}' \
    | engine render
}

cmd_status() {
  local summary decision
  summary="$(jq -n --argjson tasks "$(read_tasks)" --argjson state "$(read_state)" --argjson now "$(now_ms)" \
              '{tasks:$tasks, state:$state, now:$now}' | engine summary)"
  decision="$(jq -n --argjson config "$(read_config)" --argjson state "$(read_state)" \
              --argjson tasks "$(read_tasks)" --argjson now "$(now_ms)" \
              '{config:$config, state:$state, tasks:$tasks, now:$now}' | engine decide)"
  jq -n --argjson s "$summary" --argjson d "$decision" --argjson st "$(read_state)" \
    '{enabled: $st.enabled, prompt: $st.prompt, pending: $s.promptKind,
      wouldPrompt: $d.prompt, reason: $d.reason,
      open: $s.open, overdue: $s.overdue, tone: $s.tone,
      dismissStreak: $st.dismissStreak, pauseUntilMs: $st.pauseUntilMs,
      nextIntervalMs: $d.nextIntervalMs}'
}

cmd_checkin() {
  local st; st="$(read_state)"
  [ "$(jq -r '.enabled' <<<"$st")" = "true" ] || die "grip is off — run: omarchy-grip on"
  if [ "$(jq -r '.prompt' <<<"$st")" != "null" ]; then
    echo "a prompt is already up"; return 0
  fi
  jq --argjson now "$(now_ms)" '.prompt = {kind:"checkin", since:$now}' <<<"$st" | put_state
  notify normal "󰄲  Grip check-in" "$(top_lines)"
  pulse_prompt checkin
}

cmd_ack() {
  local kind="${1:-}"; shift || true
  case "$kind" in checkin|takeover) ;; *) die "usage: omarchy-grip ack <checkin|takeover> [--did <id>] [--snooze <min>]" ;; esac

  local did="" snooze=""
  while (($#)); do
    case "$1" in
      --did) did="${2:-}"; shift 2 ;;
      --snooze) snooze="$(dur_to_min "${2:-}")"; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done

  [ -n "$did" ] && cmd_done "$did" >/dev/null

  local now; now="$(now_ms)"
  local pause_expr=".pauseUntilMs = .pauseUntilMs"
  if [ -n "$snooze" ]; then
    pause_expr=".pauseUntilMs = ($now + $snooze * 60000)"
  elif [ "$kind" = "takeover" ]; then
    # a bare takeover ack is the "I hear you — 10 min" escape hatch
    pause_expr=".pauseUntilMs = ($now + 600000)"
  fi

  local streak_expr
  if [ -n "$did" ] || [ "$kind" = "takeover" ]; then
    streak_expr=".dismissStreak = 0"          # you engaged
  else
    streak_expr=".dismissStreak = (.dismissStreak + 1)"
  fi

  read_state | jq --argjson now "$now" \
    ".prompt = null | .lastPromptMs = \$now | $streak_expr | $pause_expr" | put_state
  pulse_clear
  echo "ack $kind"
}

cmd_pause() {
  local min; min="$(dur_to_min "${1:-}")"
  [ "$min" -gt 0 ] 2>/dev/null || die "usage: omarchy-grip pause <2h|30m|90>"
  local until; until=$(( $(now_ms) + min * 60000 ))
  state_set ".pauseUntilMs = $until | .prompt = null"
  pulse_clear
  notify normal "󰒲  Grip paused" "No nudges for ${min}m."
  echo "paused ${min}m"
}

cmd_resume() {
  state_set ".pauseUntilMs = 0"
  echo "resumed"
}

cmd_on() {
  state_set ".enabled = true"
  ensure_daemon
  do_tick
  notify normal "󰄬  Grip is on" "It'll start checking in. Pause anytime: omarchy-grip pause 2h"
  echo "on"
}

cmd_off() {
  state_set ".enabled = false | .prompt = null"
  stop_daemon
  pulse_clear
  notify normal "󰅖  Grip is off" "No more nudges until you turn it back on."
  echo "off"
}

cmd_routines() {
  read_config | jq -r '.routines[] | "  \(.id)\t\(.text)"' 2>/dev/null || echo "  (none configured — edit $CONFIG_FILE)"
}

# ── the tick ───────────────────────────────────────────────────────────
do_tick() {
  local cfg st tasks day decision want
  cfg="$(read_config)"
  st="$(read_state)"
  [ "$(jq -r '.enabled' <<<"$st")" = "true" ] || return 0

  # 1. reseed today's routine rows if the day rolled over
  day="$(today)"
  if [ "$(jq -r '.routinesDate' <<<"$st")" != "$day" ]; then
    jq -n --argjson tasks "$(read_tasks)" --argjson config "$cfg" --arg day "$day" \
      '{tasks:$tasks, config:$config, day:$day}' | engine sync-routines | put_tasks
    st="$(jq --arg day "$day" '.routinesDate = $day' <<<"$st")"
    put_state <<<"$st"
  fi

  # 2. ask the engine what to show
  tasks="$(read_tasks)"
  decision="$(jq -n --argjson config "$cfg" --argjson state "$st" --argjson tasks "$tasks" --argjson now "$(now_ms)" \
              '{config:$config, state:$state, tasks:$tasks, now:$now}' | engine decide)"
  want="$(jq -r '.prompt // "none"' <<<"$decision")"

  # 3. raise a new prompt only when nothing is on screen yet
  if [ "$want" != "none" ] && [ "$(jq -r '.prompt' <<<"$st")" = "null" ]; then
    jq --arg kind "$want" --argjson now "$(now_ms)" '.prompt = {kind:$kind, since:$now}' <<<"$st" | put_state
    if [ "$want" = "takeover" ]; then
      notify critical "󱐋  Grip — deal with this" "$(top_lines)"
      pulse_prompt takeover
    else
      notify normal "󰄲  Grip check-in" "$(top_lines)"
      pulse_prompt checkin
    fi
  fi
}

run_loop() {
  do_tick
  while :; do
    sleep "$TICK_SECONDS"
    [ "$(jq -r '.enabled' <<<"$(read_state)")" = "true" ] || break
    do_tick
  done
}

seed_config

case "${1:-status}" in
  __run)          run_loop ;;
  add)            shift; cmd_add "$@" ;;
  done)           shift; cmd_done "$@" ;;
  drop|rm)        shift; cmd_drop "$@" ;;
  list|ls)        cmd_list ;;
  get)            read_tasks | jq . ;;
  get-state)      read_state | jq . ;;
  status)         cmd_status ;;
  tick)           do_tick ;;
  checkin)        cmd_checkin ;;
  ack)            shift; cmd_ack "$@" ;;
  pause)          shift; cmd_pause "$@" ;;
  resume)         cmd_resume ;;
  on)             cmd_on ;;
  off)            cmd_off ;;
  routines)       cmd_routines ;;
  -h|--help|help) sed -n '2,45p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "omarchy-grip: unknown command '${1}' (try --help)" >&2; exit 2 ;;
esac
