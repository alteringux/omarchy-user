#!/usr/bin/env bash
# omarchy-devcast — turn a Claude Code session into an interactive replay
# ("devcast"): a self-contained replay.html you can scrub / play, optionally
# rendered to MP4 or GIF.
#
# Source material: Claude Code writes one JSONL transcript per session under
#   ~/.claude/projects/<project-slug>/<session-id>.jsonl
# every prompt, assistant turn, Bash/Edit/Write tool call + result, timestamped.
# `build` parses one into ordered steps (with a secret-redaction pass) and
# renders the player. See the plugin's Model.js for the parse rules.
#
# VERBS
#   build [latest|<session-id>|<path>] [flags]   render a devcast
#       --project DIR   only search this project's transcript dir
#       --title STR     override the title
#       --no-redact     keep secrets verbatim (default: mask them)
#       --thinking      include Claude's thinking blocks (default: omit)
#       --no-reads      drop Read tool steps
#       --max-gap MS    clamp idle gaps for pacing (default 6000)
#       --open          xdg-open the replay.html when done
#   list [--json]                    recent devcasts, newest first
#   latest                           print the newest replay.html path
#   open [<id>]                       xdg-open a devcast (newest if omitted)
#   stats <id>                        print its stats
#   export <id> [--mp4|--gif] [--fps N] [--width W] [--height H] [--theme dark|light]
#                                    render frames with headless chromium + ffmpeg
#   prune [--keep N]                 delete all but the N newest (default 20)
#   flag <id> <text...>              record "this replay was wrong" for the
#                                    self-improvement loop (omarchy-plugin-improve)
#   catalog [--rebuild]              scan EVERY ~/.claude/projects/*/*.jsonl into
#                                    devcast-catalog.json (streamed, incremental)
#   library [--json]                 list every known session, ▶ = replay built,
#                                    ~ = replay stale (transcript grew since)
#   import [--all] [--since D] [--project SUBSTR] [--min-tools N] [--limit N]
#                                    bulk-build replays from the catalogue
#                                    (default: unbuilt/stale, >=3 tool calls, 25 newest)
#
# Reuses omarchy-pulse (a "devcast ready" activity event with a Watch action).
#
# Env: OMARCHY_STATE_DIR      override the state dir (tests)
#      OMARCHY_DEVCAST_DIR     override the plugin dir (Model.js / template)
#      CLAUDE_PROJECTS_DIR     override ~/.claude/projects
#      OMARCHY_DEVCAST_QUIET=1 skip omarchy-pulse / notify-send
set -euo pipefail

STATE_DIR="${OMARCHY_STATE_DIR:-$HOME/.local/state/omarchy}"
DC_DIR="${OMARCHY_DEVCAST_DIR:-$HOME/.config/omarchy/plugins/alteringux.devcast}"
PROJECTS_DIR="${CLAUDE_PROJECTS_DIR:-$HOME/.claude/projects}"
CASTS_DIR="$STATE_DIR/devcasts"
CLI="$DC_DIR/devcast-cli.js"
QUIET="${OMARCHY_DEVCAST_QUIET:-0}"

die() { echo "omarchy-devcast: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
have node || die "needs node on PATH"
have jq || die "needs jq on PATH"

slugify() {
  printf '%s' "$1" | tr '\n\r\t' '   ' | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' | cut -c1-48
}

resolve_transcript() {  # <selector> [projectDir] -> path on stdout
  local sel="${1:-latest}" proj="${2:-}"
  if [ -f "$sel" ]; then printf '%s' "$sel"; return 0; fi
  local search="$PROJECTS_DIR"
  [ -n "$proj" ] && search="$proj"
  if [ "$sel" = "latest" ]; then
    find "$search" -name '*.jsonl' -type f -printf '%T@ %p\n' 2>/dev/null \
      | sort -rn | awk 'NR==1{ $1=""; sub(/^ /,""); print }'
    return 0
  fi
  # treat as a session id (with or without .jsonl)
  local id="${sel%.jsonl}"
  find "$search" -name "${id}.jsonl" -type f 2>/dev/null | head -1
}

pulse_notify() {  # <html> <title> <summary>
  [ "$QUIET" = 1 ] && return 0
  have omarchy-pulse || return 0
  omarchy-pulse log alteringux.devcast "Devcast ready — $2" \
    --level info --notify \
    --action "xdg-open '$1'" --action-label "Watch" \
    >/dev/null 2>&1 || true
}

open_html() { setsid xdg-open "$1" >/dev/null 2>&1 || true; }

# Best-effort: feed the self-improvement loop. Never affects this command.
improve_insight() { # <kind> <severity> <detail> [dataJSON]
  command -v omarchy-plugin-improve >/dev/null 2>&1 || return 0
  setsid omarchy-plugin-improve insight devcast "$1" \
    --severity "$2" --detail "$3" --data "${4:-{}}" >/dev/null 2>&1 &
}

cast_dirs_newest_first() {
  [ -d "$CASTS_DIR" ] || return 0
  find "$CASTS_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' 2>/dev/null \
    | sort -rn | awk '{ $1=""; sub(/^ /,""); print }'
}

INDEX_FILE="$STATE_DIR/devcast-index.json"
CATALOG_FILE="$STATE_DIR/devcast-catalog.json"

# sessionId \t castDirName \t buildMtimeMs  — one line per built devcast
built_map() {
  local d sid mt
  while IFS= read -r d; do
    [ -f "$d/build.json" ] || continue
    sid="$(jq -r '.meta.sessionId // empty' "$d/build.json" 2>/dev/null)"
    [ -n "$sid" ] || continue
    mt="$(stat -c %Y "$d/cast.json" 2>/dev/null || echo 0)"
    printf '%s\t%s\t%s000\n' "$sid" "$(basename "$d")" "$mt"
  done < <(cast_dirs_newest_first)
}

# Replays whose source transcript has grown are kept on disk for a later
# rebuild, but must not be advertised as the current/recent replay.
replay_is_stale() {
  local d="$1" source sourceMt replayMt
  [ -f "$d/build.json" ] || return 1
  source="$(jq -r '.sourceTranscript // empty' "$d/build.json" 2>/dev/null || true)"
  [ -n "$source" ] && [ -f "$source" ] || return 1
  sourceMt="$(stat -c %Y "$source" 2>/dev/null || echo 0)"
  replayMt="$(stat -c %Y "$d/cast.json" 2>/dev/null || echo 0)"
  [ "$sourceMt" -gt "$replayMt" ]
}

current_cast_dirs_newest_first() {
  local d
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    replay_is_stale "$d" && continue
    printf '%s\n' "$d"
  done < <(cast_dirs_newest_first)
}

# Rebuild devcast-index.json — the single file the bar widget watches
# (docs/adr/0006-cli-first-plugins.md). Cheap; called after build / prune /
# catalog. Also folds in a capped view of the session catalogue.
write_index() {
  local rows="[]" d
  while IFS= read -r d; do
    [ -n "$d" ] && [ -f "$d/cast.json" ] || continue
    local meta
    meta="$(node "$CLI" stats "$d/cast.json" 2>/dev/null || echo '{}')"
    rows="$(jq -c --argjson m "$meta" --arg id "$(basename "$d")" \
      --arg html "$d/replay.html" --arg mp4 "$(ls -t "$d"/*.mp4 2>/dev/null | head -1)" \
      --arg gif "$(ls -t "$d"/*.gif 2>/dev/null | head -1)" \
      '. + [{
        id:$id, title:($m.meta.title // "session"), summary:($m.summary // ""),
        duration:($m.duration // ""), html:$html,
        video:(if $mp4 != "" then $mp4 elif $gif != "" then $gif else "" end),
        stats:($m.stats // {})
      }]' <<<"$rows")"
  done < <(current_cast_dirs_newest_first)

  local cat='null'
  if [ -f "$CATALOG_FILE" ]; then
    cat="$(jq -c '{
      totalSessions: (.sessions | length),
      built: ([.sessions[] | select(.built)] | length),
      stale: ([.sessions[] | select(.stale)] | length),
      unbuilt: ([.sessions[] | select((.built | not))] | length),
      updatedAt: .updatedAt,
      recent: (.sessions[:60] | map({
        id: .sessionId, title, project, endedAt: .lastTs,
        toolUses, lines, built, stale, sourcePath
      }))
    }' "$CATALOG_FILE" 2>/dev/null || echo 'null')"
  fi

  mkdir -p "$STATE_DIR"
  local tmp="$INDEX_FILE.tmp.$$"
  jq -n --argjson casts "$rows" --argjson cat "$cat" --argjson now "$(date +%s%3N)" '{
    version: 1, updatedAt: $now, count: ($casts | length),
    latest: ($casts[0] // null), casts: $casts, catalog: $cat
  }' > "$tmp" && mv -f "$tmp" "$INDEX_FILE"
}

# Walk every ~/.claude/projects/*/*.jsonl into devcast-catalog.json (streamed,
# incremental by mtime). This is the "track all sessions + history" view.
cmd_catalog() {
  local rebuild=""
  [ "${1:-}" = "--rebuild" ] && rebuild="--rebuild"
  mkdir -p "$STATE_DIR"
  local btsv; btsv="$(mktemp)"
  built_map > "$btsv" 2>/dev/null || true
  local tmp="$CATALOG_FILE.tmp.$$"
  if node "$CLI" catalog "$PROJECTS_DIR" --prev "$CATALOG_FILE" --built "$btsv" $rebuild > "$tmp" 2>/dev/null \
     && jq -e . "$tmp" >/dev/null 2>&1; then
    mv -f "$tmp" "$CATALOG_FILE"
  else
    rm -f "$tmp" "$btsv"; die "catalog scan failed"
  fi
  rm -f "$btsv"
  write_index
  echo "$CATALOG_FILE"
  jq -r '"  \(.count) sessions · \([.sessions[]|select(.built)]|length) with replays · \([.sessions[]|select(.stale)]|length) stale"' "$CATALOG_FILE"
}

cmd_library() {
  local json=0
  [ "${1:-}" = "--json" ] && json=1
  [ -f "$CATALOG_FILE" ] || cmd_catalog >/dev/null
  if [ "$json" = 1 ]; then jq . "$CATALOG_FILE"; return 0; fi
  jq -r '
    .sessions[] |
    (if .built then "▶" elif .stale then "~" else "·" end) as $m |
    "\($m) \((.lastTs // 0) / 1000 | strftime("%Y-%m-%d %H:%M"))  \(.title[:56])" +
    "   [\(.toolUses) tools · \(.project | sub("^/home/[^/]+"; "~"))]" +
    (if .stale then "  (replay stale)" elif .built then "  (replay built)" else "" end)
  ' "$CATALOG_FILE"
}

# Bulk-build replays from the catalogue. Default: unbuilt/stale sessions with
# >= 3 tool calls, newest 25.
cmd_import() {
  local all=0 since="" projFilter="" minTools=3 limit=25
  local passthru=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --all)        all=1; shift ;;
      --since)      since="${2:-}"; shift 2 ;;
      --project)    projFilter="${2:-}"; shift 2 ;;
      --min-tools)  minTools="${2:-3}"; shift 2 ;;
      --limit)      limit="${2:-25}"; shift 2 ;;
      --no-redact|--thinking|--no-reads) passthru+=("$1"); shift ;;
      *) die "import: unknown flag '$1'" ;;
    esac
  done
  cmd_catalog >/dev/null

  local sinceMs=0
  [ -n "$since" ] && sinceMs="$(date -d "$since" +%s%3N 2>/dev/null || echo 0)"

  local targets=()
  while IFS= read -r p; do
    [ -n "$p" ] && targets+=("$p")
  done < <(jq -r --argjson all "$all" --argjson mt "$minTools" --argjson since "$sinceMs" \
    --arg pf "$projFilter" --argjson lim "$limit" '
    .sessions
    | map(select( ($all == 1) or ((.built | not)) or .stale ))
    | map(select(.toolUses >= $mt))
    | map(select($since == 0 or ((.lastTs // 0) >= $since)))
    | map(select($pf == "" or (.project | test($pf; "i"))))
    | .[:$lim] | .[].sourcePath' "$CATALOG_FILE")

  if [ ${#targets[@]} -eq 0 ]; then
    echo "nothing to import — all matching sessions already have current replays (try --all)"
    return 0
  fi

  echo "importing ${#targets[@]} session(s)…"
  local p ok=0 fail=0
  export DEVCAST_BATCH=1 OMARCHY_DEVCAST_QUIET=1
  for p in "${targets[@]}"; do
    if cmd_build "$p" "${passthru[@]}" >/dev/null 2>&1; then
      ok=$((ok + 1)); echo "  ✓ $(basename "$p" .jsonl)"
    else
      fail=$((fail + 1)); echo "  ✗ $(basename "$p" .jsonl)"
    fi
  done
  unset DEVCAST_BATCH OMARCHY_DEVCAST_QUIET
  cmd_catalog >/dev/null
  echo "built $ok, failed $fail  →  $INDEX_FILE updated"
}

resolve_cast_dir() {  # <id-or-empty> -> dir
  local want="${1:-}"
  if [ -z "$want" ]; then current_cast_dirs_newest_first | head -1; return 0; fi
  if [ -d "$CASTS_DIR/$want" ]; then printf '%s' "$CASTS_DIR/$want"; return 0; fi
  cast_dirs_newest_first | grep -m1 -F "$want" || true
}

# ── build ───────────────────────────────────────────────────────────────

cmd_build() {
  local selector="latest" project="" open=0
  local passthru=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --project)   project="${2:-}"; shift 2 ;;
      --open)      open=1; shift ;;
      --title)     passthru+=(--title "${2:-}"); shift 2 ;;
      --no-redact) passthru+=(--no-redact); shift ;;
      --thinking)  passthru+=(--thinking); shift ;;
      --no-reads)  passthru+=(--no-reads); shift ;;
      --max-gap)   passthru+=(--max-gap "${2:-6000}"); shift 2 ;;
      -*)          die "build: unknown flag '$1'" ;;
      *)           selector="$1"; shift ;;
    esac
  done

  local transcript
  transcript="$(resolve_transcript "$selector" "$project")"
  [ -n "$transcript" ] && [ -f "$transcript" ] || die "no transcript for '$selector' under $PROJECTS_DIR"

  # Keep the previous replay until the replacement has been fully built and
  # validated. A failed parse must never erase the last good replay.
  local sid prevdir=""
  sid="$(grep -m1 -o '"sessionId":"[^"]*"' "$transcript" 2>/dev/null | head -1 | cut -d'"' -f4)"
  if [ -n "$sid" ]; then
    prevdir="$(built_map 2>/dev/null | awk -F'\t' -v s="$sid" '$1==s{print $2; exit}')"
  fi

  # Build into a stamp-only dir first, then rename it to include the slug of
  # the title the parser actually settled on (ai-title, else first real prompt).
  local stamp outDir
  stamp="$(date +%Y%m%d-%H%M%S)"
  outDir="$CASTS_DIR/${stamp}-building.$$"

  mkdir -p "$CASTS_DIR"
  local result
  result="$(node "$CLI" build "$transcript" "$outDir" "${passthru[@]}")" || {
    rm -rf "$outDir"
    [ "${DEVCAST_BATCH:-0}" = 1 ] || write_index || true
    die "build failed: $result"
  }

  local err; err="$(printf '%s' "$result" | jq -r '.error // empty')"
  [ -z "$err" ] || {
    rm -rf "$outDir" 2>/dev/null || true
    [ "${DEVCAST_BATCH:-0}" = 1 ] || write_index || true
    die "$err"
  }

  local summary title slug finalDir
  summary="$(printf '%s' "$result" | jq -r '.summary')"
  title="$(printf '%s' "$result" | jq -r '.meta.title // "session"')"
  slug="$(slugify "$title")"
  [ -n "$slug" ] || slug="session"
  finalDir="$CASTS_DIR/${stamp}-${slug}"
  [ -e "$finalDir" ] && finalDir="$CASTS_DIR/${stamp}-${slug}.$$"

  # Write metadata while the new replay is still isolated. This keeps every
  # failure before the swap, so the previous directory remains untouched.
  if ! printf '%s' "$result" | jq --arg src "$transcript" --arg dir "$finalDir" \
    '. + {sourceTranscript:$src, outDir:$dir, htmlPath:($dir + "/replay.html"), castPath:($dir + "/cast.json")}' \
    > "$outDir/build.json"; then
    rm -rf "$outDir"
    die "could not record build metadata"
  fi

  # Swap directories only after the complete replacement exists. Keep a
  # rollback name until the new directory has been installed successfully.
  local oldPath="" backupPath=""
  if [ -n "$prevdir" ] && [ -d "$CASTS_DIR/$prevdir" ]; then
    oldPath="$CASTS_DIR/$prevdir"
    backupPath="$CASTS_DIR/.${prevdir}.backup.$$"
    if ! mv "$oldPath" "$backupPath"; then
      rm -rf "$outDir"
      die "could not stage previous replay for replacement"
    fi
  fi
  if ! mv "$outDir" "$finalDir"; then
    if [ -n "$backupPath" ]; then
      mv "$backupPath" "$oldPath" 2>/dev/null || true
    fi
    rm -rf "$outDir" 2>/dev/null || true
    die "could not install replacement replay"
  fi
  [ -z "$backupPath" ] || rm -rf "$backupPath" 2>/dev/null || true
  outDir="$finalDir"
  local html
  html="$outDir/replay.html"

  [ "${DEVCAST_BATCH:-0}" = 1 ] || write_index

  # ── feed the self-improvement loop from this build's quality warnings ──
  local warn; warn="$(printf '%s' "$result" | jq -c '.warnings // {}')"
  local uk; uk="$(jq -r '.unknownTools // [] | length' <<<"$warn")"
  if [ "${uk:-0}" -gt 0 ]; then
    improve_insight unknown-tool med \
      "no renderer for tool(s): $(jq -r '.unknownTools | join(", ")' <<<"$warn")" "$warn"
  fi
  local up; up="$(jq -r '.unpairedTools // 0' <<<"$warn")"
  [ "${up:-0}" -gt 0 ] && improve_insight unpaired-tool low "$up tool call(s) had no captured result" "$warn"
  local ht; ht="$(jq -r '.heavyTruncations // 0' <<<"$warn")"
  [ "${ht:-0}" -gt 0 ] && improve_insight heavy-truncation low "$ht step(s) lost >200 lines to truncation" "$warn"
  local rr; rr="$(jq -r '.redactionRate // 0' <<<"$warn")"
  awk "BEGIN{exit !($rr > 1.5)}" && improve_insight high-redaction low "redaction rate ${rr}/step — pattern may be too broad" "$warn"

  echo "$outDir"
  echo "  $title"
  echo "  $summary"
  echo "  $html"
  pulse_notify "$html" "$title" "$summary"
  if [ "$open" = 1 ]; then open_html "$html"; fi
}

cmd_flag() {
  local id="${1:-}"; shift || true
  [ -n "$id" ] && [ $# -gt 0 ] || die "usage: omarchy-devcast flag <id> <what looked wrong...>"
  command -v omarchy-plugin-improve >/dev/null 2>&1 || die "needs omarchy-plugin-improve"
  omarchy-plugin-improve insight devcast flag --severity med \
    --detail "$*" --source flag --data "$(jq -n --arg id "$id" '{castId:$id}')"
  echo "flagged devcast $id: $*"
}

# ── list / open / stats / latest ───────────────────────────────────────

cmd_list() {
  local json=0
  [ "${1:-}" = "--json" ] && json=1
  local rows="[]"
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    local cj="$d/cast.json"
    [ -f "$cj" ] || continue
    local row
    row="$(node "$CLI" stats "$cj" 2>/dev/null || echo '{}')"
    row="$(printf '%s' "$row" | jq --arg id "$(basename "$d")" --arg html "$d/replay.html" \
      '{id:$id, html:$html, title:(.meta.title // "session"), summary:.summary, duration:.duration, stats:.stats}')"
    rows="$(jq -c --argjson r "$row" '. + [$r]' <<<"$rows")"
  done < <(current_cast_dirs_newest_first)

  if [ "$json" = 1 ]; then
    printf '%s\n' "$rows" | jq .
    return 0
  fi
  local n; n="$(jq 'length' <<<"$rows")"
  [ "$n" -gt 0 ] || { echo "no devcasts yet — run: omarchy-devcast build latest"; return 0; }
  printf '%s\n' "$rows" | jq -r '.[] | "\(.id)\n  \(.title)\n  \(.summary)\n"'
}

cmd_latest() {
  local d; d="$(resolve_cast_dir "")"
  [ -n "$d" ] || die "no devcasts yet"
  printf '%s\n' "$d/replay.html"
}

cmd_open() {
  local d; d="$(resolve_cast_dir "${1:-}")"
  [ -n "$d" ] && [ -f "$d/replay.html" ] || die "no such devcast"
  open_html "$d/replay.html"
  echo "$d/replay.html"
}

cmd_stats() {
  local d; d="$(resolve_cast_dir "${1:-}")"
  [ -n "$d" ] && [ -f "$d/cast.json" ] || die "no such devcast"
  node "$CLI" stats "$d/cast.json" | jq .
}

cmd_prune() {
  local keep=20
  [ "${1:-}" = "--keep" ] && keep="${2:-20}"
  local i=0
  while IFS= read -r d; do
    i=$((i + 1))
    [ "$i" -le "$keep" ] && continue
    rm -rf "$d" && echo "pruned $(basename "$d")"
  done < <(cast_dirs_newest_first)
  write_index
}

# ── export (headless chromium frames -> ffmpeg) ────────────────────────

cmd_export() {
  local id="" kind="mp4" fps=8 width=1280 height=720 theme="dark" maxFrames=360
  while [ $# -gt 0 ]; do
    case "$1" in
      --mp4)        kind="mp4"; shift ;;
      --gif)        kind="gif"; shift ;;
      --fps)        fps="${2:-8}"; shift 2 ;;
      --width)      width="${2:-1280}"; shift 2 ;;
      --height)     height="${2:-720}"; shift 2 ;;
      --theme)      theme="${2:-dark}"; shift 2 ;;
      --max-frames) maxFrames="${2:-360}"; shift 2 ;;
      -*)           die "export: unknown flag '$1'" ;;
      *)            id="$1"; shift ;;
    esac
  done

  local chromium=""
  for c in chromium chromium-browser google-chrome-stable google-chrome chrome; do
    have "$c" && { chromium="$c"; break; }
  done
  [ -n "$chromium" ] || die "export needs a chromium/chrome binary"
  have ffmpeg || die "export needs ffmpeg"

  local d; d="$(resolve_cast_dir "$id")"
  [ -n "$d" ] && [ -f "$d/replay.html" ] || die "no such devcast"
  local totalMs
  totalMs="$(jq -r '.stats.playDurationMs // 10000' "$d/cast.json")"

  # If the full-rate frame count would blow past --max-frames, drop the fps to
  # fit rather than render for ages. Playback still spans the whole cast.
  local wantFrames
  wantFrames="$(awk -v t="$totalMs" -v f="$fps" 'BEGIN{ printf "%d", (t/1000.0)*f + 1 }')"
  if [ "$wantFrames" -gt "$maxFrames" ]; then
    fps="$(awk -v t="$totalMs" -v m="$maxFrames" 'BEGIN{ r=(m-1)/(t/1000.0); printf "%.2f", (r<0.5?0.5:r) }')"
    echo "omarchy-devcast: capped to $maxFrames frames → ${fps}fps" >&2
  fi

  local tmp; tmp="$(mktemp -d "${TMPDIR:-/tmp}/devcast-export.XXXXXX")"
  trap 'rm -rf "$tmp"' RETURN
  echo "omarchy-devcast: rendering frames with headless $chromium (${width}x${height} @ ${fps}fps)…" >&2

  # Fast path: one persistent chromium driven over the DevTools protocol.
  local fr_json fr_ok=0
  if fr_json="$(node "$CLI" export-frames "$chromium" "$d/replay.html" "$tmp" "$fps" "$width" "$height" "$theme" "$totalMs" "$maxFrames" 2>"$tmp/err.log")"; then
    [ "$(printf '%s' "$fr_json" | jq -r '.ok // false')" = "true" ] && fr_ok=1
  fi
  if [ "$fr_ok" != 1 ]; then
    echo "omarchy-devcast: CDP renderer failed ($(head -1 "$tmp/err.log" 2>/dev/null)); falling back to per-frame screenshots" >&2
    local nframes
    nframes="$(awk -v t="$totalMs" -v f="$fps" -v m="$maxFrames" 'BEGIN{ n=(t/1000.0)*f+1; if(n>m)n=m; printf "%d", n }')"
    seq 0 $((nframes - 1)) | xargs -P "$(nproc 2>/dev/null || echo 4)" -I{} sh -c '
      n="$1"; tmp="$2"; d="$3"; w="$4"; h="$5"; fps="$6"; bin="$7"; theme="$8"
      ms=$(awk -v n="$n" -v f="$fps" "BEGIN{ printf \"%d\", (n/f)*1000 }")
      out="$tmp/$(printf "f_%05d.png" "$n")"
      "$bin" --headless=new --hide-scrollbars --disable-gpu --disable-dev-shm-usage \
        --no-sandbox --force-device-scale-factor=1 --window-size="${w},${h}" \
        --screenshot="$out" "file://$d/replay.html?chrome=hidden&theme=${theme}&frame=${ms}" >/dev/null 2>&1
    ' _ {} "$tmp" "$d" "$width" "$height" "$fps" "$chromium" "$theme"
  fi

  local made
  made="$(find "$tmp" -name 'f_*.png' | wc -l)"
  [ "$made" -ge 2 ] || die "no frames rendered (tried $chromium); see $tmp/err.log"

  local stamp out
  stamp="$(date +%Y%m%d-%H%M%S)"
  # Normalise to a ~TARGET-second clip regardless of how many frames we
  # captured: hold the N captured frames across TARGET seconds, upsample to a
  # smooth outFps.
  local target=45 outFps=15 inRate
  inRate="$(awk -v n="$made" -v t="$target" 'BEGIN{ r=n/t; if(r<0.2)r=0.2; printf "%.4f", r }')"
  local scale2="scale=trunc(iw/2)*2:trunc(ih/2)*2"
  if [ "$kind" = "gif" ]; then
    out="$d/devcast-$stamp.gif"
    ffmpeg -y -loglevel error -framerate "$inRate" -i "$tmp/f_%05d.png" \
      -vf "${scale2}:flags=lanczos,fps=$outFps,split[s0][s1];[s0]palettegen[p];[s1][p]paletteuse" \
      "$out"
  else
    out="$d/devcast-$stamp.mp4"
    ffmpeg -y -loglevel error -framerate "$inRate" -i "$tmp/f_%05d.png" \
      -vf "${scale2},fps=$outFps" \
      -c:v libx264 -pix_fmt yuv420p -movflags +faststart "$out"
  fi
  [ -s "$out" ] || die "ffmpeg produced no output"
  echo "$out"
  [ "$QUIET" = 1 ] || { have omarchy-pulse && omarchy-pulse log alteringux.devcast "Exported $(basename "$out")" --level info --action "xdg-open '$out'" --action-label "Open" >/dev/null 2>&1 || true; }
}

usage() { sed -n '2,52p' "$0" | sed 's/^# \{0,1\}//'; }

case "${1:-list}" in
  build)             shift; cmd_build "$@" ;;
  list|ls)           shift || true; cmd_list "$@" ;;
  latest)            shift || true; cmd_latest ;;
  open)              shift || true; cmd_open "$@" ;;
  stats)             shift || true; cmd_stats "$@" ;;
  export)            shift; cmd_export "$@" ;;
  prune)             shift || true; cmd_prune "$@" ;;
  reindex)           shift || true; write_index; echo "$INDEX_FILE" ;;
  flag)              shift; cmd_flag "$@" ;;
  catalog|scan)      shift || true; cmd_catalog "$@" ;;
  library|history)   shift || true; cmd_library "$@" ;;
  import)            shift; cmd_import "$@" ;;
  -h|--help|help)    usage ;;
  *) die "unknown command '$1' (try --help)" ;;
esac
