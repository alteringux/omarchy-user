#!/bin/bash
# Spoken stopwatch using Piper TTS: counts up indefinitely and announces
# cumulative elapsed time at a configurable interval. Runs as a background
# systemd --user unit so it survives closing the terminal; `cancel` stops
# it. Mirrors omarchy-countdown's speak()/cache pattern, but deliberately
# a separate script/state file: a stopwatch has no end time, so it doesn't
# fit that script's {end_epoch, total_seconds} shape.
set -euo pipefail

VOICE_MODEL="$HOME/.local/share/piper-voices/en_US-lessac-medium.onnx"
PIPER_BIN="$HOME/.local/bin/piper"
UNIT="omarchy-stopwatch"
STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/omarchy-stopwatch"
STATE_FILE="$STATE_DIR/state"
# Presence of this file mutes speak(); `mute` creates it, `unmute` removes it.
# Checked at each announcement so the bar's voice switch takes effect on the
# next interval without restarting the systemd unit. Session-scoped: cleared on
# a fresh start and on cancel, preserved across `resume`.
VOICE_MUTE_FILE="$STATE_DIR/voice-muted"
CACHE_DIR="$HOME/Music/omarchy-countdown-cache"  # same voice/phrasing style, shared cache
HISTORY_FILE="$HOME/.local/state/omarchy/stopwatch-history.json"
# Persistent mirror of $STATE_FILE. $STATE_FILE lives under $XDG_RUNTIME_DIR,
# which is wiped on logout/reboot; this copy is not, so `resume` can respawn
# the timing loop with the original start_epoch after a reboot.
PERSIST_FILE="$HOME/.local/state/omarchy/stopwatch-state.json"
# Presence of this file makes speak() ring a short bell instead of running TTS,
# so the stopwatch marks each interval without a spoken time. `chime` creates
# it, `unchime` removes it; a fresh start seeds it from CONFIG_FILE's "chime"
# flag. Session-scoped like VOICE_MUTE_FILE: cleared on cancel, preserved
# across `resume` and pause/unpause.
CHIME_FILE="$STATE_DIR/chime"
# Panel-owned config written by the bar widget's Kit.Store (announce interval +
# the persisted "chime" default). Read once on start to seed CHIME_FILE.
CONFIG_FILE="$HOME/.local/state/omarchy/stopwatch-config.json"

# Ring the first available desktop "bell" sound. Used by speak() when CHIME_FILE
# is present, so a bell marks each interval instead of spoken TTS. Ordered
# loudest-first: `bell.oga` alone is a very soft UI tick that's easy to miss as
# a once-a-minute cue. Override with $OMARCHY_STOPWATCH_BELL (a file path).
play_bell() {
  local snd
  for snd in \
    "${OMARCHY_STOPWATCH_BELL:-}" \
    "/usr/share/sounds/freedesktop/stereo/complete.oga" \
    "/usr/share/sounds/freedesktop/stereo/alarm-clock-elapsed.oga" \
    "/usr/share/sounds/freedesktop/stereo/bell.oga" \
    "/usr/share/sounds/freedesktop/stereo/message.oga"; do
    if [[ -n "$snd" && -f "$snd" ]]; then
      pw-play "$snd" 2>/dev/null || paplay "$snd" 2>/dev/null || true
      return 0
    fi
  done
}

speak() {
  local text=$1
  # Re-checked every call: flipping the bar's voice / bell switches mid-session
  # just creates or removes a marker file, and the effect lands on the next
  # announcement without restarting the systemd unit.
  #
  # Bell mode is checked BEFORE mute: turning on the bell is an explicit opt-in
  # to an audible interval cue, so it rings even if spoken announcements were
  # silenced (otherwise "voice off + bell on" is a silent dead combo).
  if [[ -f "$CHIME_FILE" ]]; then
    play_bell
    return 0
  fi
  if [[ -f "$VOICE_MUTE_FILE" ]]; then
    return 0
  fi
  local hash cache_file
  hash=$(printf '%s' "$text" | sha256sum | cut -d' ' -f1)
  cache_file="$CACHE_DIR/$hash.wav"

  if [[ ! -s "$cache_file" ]]; then
    mkdir -p "$CACHE_DIR"
    "$PIPER_BIN" --model "$VOICE_MODEL" --output_file "$cache_file" --quiet <<<"$text" >/dev/null 2>&1 || true
  fi

  pw-play "$cache_file" 2>/dev/null || true
}

# Converts a minute count into spoken phrasing, e.g. 121 -> "2 hours 1 minute".
humanize_minutes() {
  local total=$1 h m parts=()
  h=$((total / 60))
  m=$((total % 60))
  if ((h > 0)); then
    local hword="hours"
    ((h == 1)) && hword="hour"
    parts+=("${h} ${hword}")
  fi
  if ((m > 0)) || ((h == 0)); then
    local mword="minutes"
    ((m == 1)) && mword="minute"
    parts+=("${m} ${mword}")
  fi
  local IFS=' '
  echo "${parts[*]}"
}

usage() {
  cat <<EOF
Usage:
  omarchy-stopwatch <interval-minutes> [label]   Start a spoken stopwatch in the background
  omarchy-stopwatch status                       Show elapsed time
  omarchy-stopwatch cancel                       Stop the running stopwatch
  omarchy-stopwatch resume                       Re-launch a stopwatch left running before logout/reboot
  omarchy-stopwatch pause                        Freeze the stopwatch without ending it
  omarchy-stopwatch unpause                      Resume a paused stopwatch
  omarchy-stopwatch mute                         Silence announcements without stopping the stopwatch
  omarchy-stopwatch unmute                       Resume announcements
  omarchy-stopwatch chime                        Ring a bell at each interval instead of speaking
  omarchy-stopwatch unchime                      Go back to speaking the elapsed time
EOF
}

# Toggle spoken announcements for a running stopwatch on/off. Takes effect on
# the next interval (speak() re-checks $VOICE_MUTE_FILE every call), so the bar
# widget's voice switch needs no unit restart.
cmd_mute() {
  mkdir -p "$STATE_DIR"
  printf 'muted\n' >"$VOICE_MUTE_FILE"
  echo "Stopwatch announcements muted."
}

cmd_unmute() {
  rm -f "$VOICE_MUTE_FILE"
  echo "Stopwatch announcements unmuted."
}

# Ring a bell instead of speaking, for a running stopwatch. Takes effect on the
# next interval (speak() re-checks $CHIME_FILE every call), like mute/unmute.
cmd_chime() {
  mkdir -p "$STATE_DIR"
  printf 'chime\n' >"$CHIME_FILE"
  echo "Stopwatch will ring a bell at each interval."
}

cmd_unchime() {
  rm -f "$CHIME_FILE"
  echo "Stopwatch will speak the elapsed time again."
}

# Freeze a running stopwatch: stop the timing unit but keep the state file,
# stamped with the epoch we paused at so elapsed time stops advancing. The bar
# widget reads paused_epoch and shows a frozen counter; `unpause` resumes.
cmd_pause() {
  [[ -f "$STATE_FILE" ]] || { echo "No stopwatch running."; return 0; }
  if jq -e '.paused_epoch' "$STATE_FILE" >/dev/null 2>&1; then
    echo "Stopwatch already paused."
    return 0
  fi
  if ! systemctl --user is-active --quiet "${UNIT}.service" 2>/dev/null; then
    echo "No stopwatch running."
    return 0
  fi
  systemctl --user stop "${UNIT}.service" 2>/dev/null || true
  local now tmp
  now=$(date +%s)
  if tmp=$(mktemp "${STATE_FILE}.XXXXXX" 2>/dev/null) \
    && jq --argjson p "$now" '.paused_epoch = $p' "$STATE_FILE" >"$tmp" 2>/dev/null; then
    mv "$tmp" "$STATE_FILE"
    cp -f "$STATE_FILE" "$PERSIST_FILE" 2>/dev/null || true
  else
    [[ -n "${tmp:-}" ]] && rm -f "$tmp"
  fi
  notify-send "Stopwatch paused" \
    "$(jq -r '.label // "Stopwatch"' "$STATE_FILE" 2>/dev/null || echo Stopwatch)" 2>/dev/null || true
  echo "Stopwatch paused."
}

# Resume a paused stopwatch. Shifts start_epoch forward by however long we were
# paused so the elapsed count picks up exactly where it stopped, then relaunches
# the timing unit with a quiet intro (no "resuming, N elapsed" announcement).
cmd_unpause() {
  [[ -f "$STATE_FILE" ]] || { echo "No paused stopwatch."; return 0; }
  local paused_epoch start_epoch interval_minutes label
  paused_epoch=$(jq -r '.paused_epoch // empty' "$STATE_FILE" 2>/dev/null || true)
  if ! [[ "$paused_epoch" =~ ^[0-9]+$ ]]; then
    echo "Stopwatch is not paused."
    return 0
  fi
  start_epoch=$(jq -r '.start_epoch // empty' "$STATE_FILE" 2>/dev/null || true)
  interval_minutes=$(jq -r '.interval_minutes // empty' "$STATE_FILE" 2>/dev/null || true)
  label=$(jq -r '.label // ""' "$STATE_FILE" 2>/dev/null || true)
  if ! [[ "$start_epoch" =~ ^[0-9]+$ ]] || ! [[ "$interval_minutes" =~ ^[0-9]+$ ]] || ((interval_minutes < 1)); then
    echo "Corrupt stopwatch state; cancel and start again." >&2
    return 1
  fi
  local now new_start
  now=$(date +%s)
  new_start=$(( start_epoch + (now - paused_epoch) ))
  systemctl --user reset-failed "${UNIT}.service" 2>/dev/null || true
  systemd-run --user --unit="$UNIT" --collect \
    --description="Omarchy spoken stopwatch (unpaused)" \
    -- "$0" --run "$interval_minutes" "$label" "$new_start" 1
  echo "Stopwatch resumed ($(( (now - new_start) / 60 )) min elapsed)."
}

# Appends a completed session to $HISTORY_FILE so the bar widget can show
# "N% shorter/longer than your average" for that label. Best-effort: a
# logging failure must never block cancelling the stopwatch itself.
log_session() {
  local label=$1 interval_minutes=$2 elapsed_seconds=$3
  local hist_dir
  hist_dir=$(dirname "$HISTORY_FILE")
  mkdir -p "$hist_dir" 2>/dev/null || return 0
  [[ -f "$HISTORY_FILE" ]] || echo '{"version":1,"sessions":[]}' >"$HISTORY_FILE" 2>/dev/null
  (
    flock -x 200 || exit 0
    local tmp
    tmp=$(mktemp "${HISTORY_FILE}.XXXXXX") || exit 0
    jq -c --arg label "$label" --argjson interval "${interval_minutes:-0}" \
      --argjson elapsed "$elapsed_seconds" --arg ended "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      '.sessions += [{label: $label, interval_minutes: $interval, elapsed_seconds: $elapsed, ended_at: $ended}]
       | .sessions |= (if length > 200 then .[-200:] else . end)' \
      "$HISTORY_FILE" >"$tmp" 2>/dev/null && mv "$tmp" "$HISTORY_FILE"
  ) 200>"${HISTORY_FILE}.lock" 2>/dev/null || true
}

cmd_cancel() {
  local start_epoch="" label="" interval_minutes=0 paused_epoch=""
  local had_state=0
  if [[ -f "$STATE_FILE" ]]; then
    had_state=1
    start_epoch=$(jq -r '.start_epoch // empty' "$STATE_FILE" 2>/dev/null || true)
    label=$(jq -r '.label // ""' "$STATE_FILE" 2>/dev/null || true)
    interval_minutes=$(jq -r '.interval_minutes // 0' "$STATE_FILE" 2>/dev/null || echo 0)
    paused_epoch=$(jq -r '.paused_epoch // empty' "$STATE_FILE" 2>/dev/null || true)
  fi
  # A paused stopwatch's unit has already exited, so `systemctl stop` can fail
  # even though there's real state to clear. Drive cleanup off the state file,
  # not the stop result.
  systemctl --user stop "${UNIT}.service" 2>/dev/null || true
  if ((had_state)); then
    if [[ "$start_epoch" =~ ^[0-9]+$ ]]; then
      # Freeze the logged length at the pause point if we were paused.
      local end_epoch
      if [[ "$paused_epoch" =~ ^[0-9]+$ ]]; then
        end_epoch=$paused_epoch
      else
        end_epoch=$(date +%s)
      fi
      local elapsed=$(( end_epoch - start_epoch ))
      ((elapsed > 0)) && log_session "$label" "$interval_minutes" "$elapsed"
    fi
    rm -f "$STATE_FILE" "$PERSIST_FILE" "$VOICE_MUTE_FILE" "$CHIME_FILE"
    echo "Stopwatch cancelled."
  else
    echo "No stopwatch running."
  fi
}

cmd_status() {
  if [[ -f "$STATE_FILE" ]]; then
    local start_epoch label now elapsed paused_epoch
    start_epoch=$(jq -r '.start_epoch' "$STATE_FILE")
    label=$(jq -r '.label' "$STATE_FILE")
    paused_epoch=$(jq -r '.paused_epoch // empty' "$STATE_FILE" 2>/dev/null || true)
    now=$(date +%s)
    if [[ "$paused_epoch" =~ ^[0-9]+$ ]]; then
      elapsed=$((paused_epoch - start_epoch))
      echo "${label:-Stopwatch}: $((elapsed / 60))m $((elapsed % 60))s elapsed (paused)"
    elif systemctl --user is-active --quiet "${UNIT}.service" 2>/dev/null; then
      elapsed=$((now - start_epoch))
      echo "${label:-Stopwatch}: $((elapsed / 60))m $((elapsed % 60))s elapsed"
    else
      echo "No stopwatch running."
      rm -f "$STATE_FILE" "$PERSIST_FILE" "$VOICE_MUTE_FILE" "$CHIME_FILE"
    fi
  else
    echo "No stopwatch running."
  fi
}

# Internal: actual foreground loop, invoked inside the systemd unit. Runs
# forever (no end time) until the unit is stopped via `cancel`.
run_stopwatch() {
  local interval_minutes=$1
  local label=${2:-}
  local resume_start=${3:-}
  # 1 => started by `unpause`: skip the spoken "resuming, N elapsed" intro so a
  # pause/resume cycle stays silent. The catch-up fast-forward below still runs.
  local quiet=${4:-0}
  local interval_seconds=$((interval_minutes * 60))
  local start resumed=0
  if [[ "$resume_start" =~ ^[0-9]+$ ]]; then
    start=$resume_start
    resumed=1
  else
    start=$(date +%s)
  fi

  # Write both the runtime state (read by the bar widget) and a persistent
  # copy that outlives a reboot, so `resume` can respawn this loop with the
  # original start_epoch.
  mkdir -p "$STATE_DIR" "$(dirname "$PERSIST_FILE")"
  # A freshly started stopwatch always begins audible (it speaks its own
  # intro); `resume` keeps whatever mute state was in effect before reboot.
  ((resumed)) || rm -f "$VOICE_MUTE_FILE"
  local state_json
  state_json=$(jq -n --argjson start_epoch "$start" --argjson interval_minutes "$interval_minutes" --arg label "$label" \
    '{start_epoch: $start_epoch, interval_minutes: $interval_minutes, label: $label}')
  printf '%s\n' "$state_json" >"$STATE_FILE"
  printf '%s\n' "$state_json" >"$PERSIST_FILE"

  local interval_word="minutes"
  ((interval_minutes == 1)) && interval_word="minute"

  local elapsed_minutes=0
  if ((resumed)); then
    # Fast-forward past every announcement whose moment already passed while
    # we were logged out, so login doesn't machine-gun catch-up TTS.
    local now
    now=$(date +%s)
    while (( start + (elapsed_minutes + interval_minutes) * 60 <= now )); do
      elapsed_minutes=$((elapsed_minutes + interval_minutes))
    done
    local elapsed_so_far
    elapsed_so_far=$(humanize_minutes "$(( (now - start) / 60 ))")
    local intro="Resuming the stopwatch, ${elapsed_so_far} elapsed."
    [[ -n "$label" ]] && intro="Resuming the stopwatch for ${label}, ${elapsed_so_far} elapsed."
    ((quiet)) || speak "$intro"
    notify-send "Stopwatch resumed" "${label:-Stopwatch}" 2>/dev/null || true
  else
    local intro="Starting a stopwatch, announcing every ${interval_minutes} ${interval_word}."
    [[ -n "$label" ]] && intro="Starting a stopwatch for ${label}, announcing every ${interval_minutes} ${interval_word}."
    speak "$intro"
    notify-send "Stopwatch started" "${label:-Stopwatch}" 2>/dev/null || true
  fi

  while true; do
    elapsed_minutes=$((elapsed_minutes + interval_minutes))
    local target now sleep_for
    target=$((start + elapsed_minutes * 60))
    now=$(date +%s)
    sleep_for=$((target - now))
    ((sleep_for > 0)) && sleep "$sleep_for"

    speak "$(humanize_minutes "$elapsed_minutes")."
  done
}

# Re-launch a stopwatch that was running before the last logout/reboot,
# using the start_epoch persisted in $PERSIST_FILE. No-op when there's
# nothing to resume or one is already running. Invoked at login by
# omarchy-stopwatch-resume.service.
cmd_resume() {
  [[ -f "$PERSIST_FILE" ]] || { echo "No stopwatch to resume."; return 0; }
  if systemctl --user is-active --quiet "${UNIT}.service" 2>/dev/null; then
    echo "Stopwatch already running."
    return 0
  fi
  # A stopwatch paused before logout stays paused: re-materialise the runtime
  # state file so the bar widget shows it, but don't relaunch the timing unit.
  # `unpause` starts it from here.
  if jq -e '.paused_epoch' "$PERSIST_FILE" >/dev/null 2>&1; then
    mkdir -p "$STATE_DIR"
    cp -f "$PERSIST_FILE" "$STATE_FILE" 2>/dev/null || true
    echo "Paused stopwatch restored (still paused)."
    return 0
  fi
  local start_epoch interval_minutes label
  start_epoch=$(jq -r '.start_epoch // empty' "$PERSIST_FILE" 2>/dev/null || true)
  interval_minutes=$(jq -r '.interval_minutes // empty' "$PERSIST_FILE" 2>/dev/null || true)
  label=$(jq -r '.label // ""' "$PERSIST_FILE" 2>/dev/null || true)
  if ! [[ "$start_epoch" =~ ^[0-9]+$ ]] || ! [[ "$interval_minutes" =~ ^[0-9]+$ ]] || ((interval_minutes < 1)); then
    echo "Corrupt stopwatch state; discarding." >&2
    rm -f "$PERSIST_FILE"
    return 0
  fi
  # A stopwatch still "running" a week after it was last seen is almost
  # certainly one that crashed or was forgotten, not one worth resuming with
  # a "10080 minutes elapsed" announcement. Discard rather than resume.
  local age=$(( $(date +%s) - start_epoch ))
  if ((age > 7 * 24 * 3600)); then
    echo "Persisted stopwatch is over a week old ($((age / 86400))d); discarding." >&2
    rm -f "$PERSIST_FILE"
    return 0
  fi
  systemd-run --user --unit="$UNIT" --collect \
    --description="Omarchy spoken stopwatch (resumed)" \
    -- "$0" --run "$interval_minutes" "$label" "$start_epoch"
  echo "Stopwatch resumed ($(( ( $(date +%s) - start_epoch ) / 60 )) min elapsed)."
}

main() {
  case "${1:-}" in
    --run)
      shift
      run_stopwatch "$@"
      ;;
    cancel)
      cmd_cancel
      ;;
    resume)
      cmd_resume
      ;;
    pause)
      cmd_pause
      ;;
    unpause)
      cmd_unpause
      ;;
    mute)
      cmd_mute
      ;;
    unmute)
      cmd_unmute
      ;;
    chime)
      cmd_chime
      ;;
    unchime)
      cmd_unchime
      ;;
    status)
      cmd_status
      ;;
    -h | --help | "")
      usage
      ;;
    *)
      local interval_minutes=$1
      local label=${2:-}
      if ! [[ "$interval_minutes" =~ ^[0-9]+$ ]] || ((interval_minutes < 1)); then
        echo "Error: interval minutes must be a positive integer" >&2
        exit 1
      fi
      if systemctl --user is-active --quiet "${UNIT}.service" 2>/dev/null; then
        echo "A stopwatch is already running. Run 'omarchy-stopwatch cancel' first." >&2
        exit 1
      fi
      # Seed the bell switch from the panel's persisted default so the first
      # interval already honours it (the panel can still flip it live).
      mkdir -p "$STATE_DIR"
      if [[ "$(jq -r '.chime // false' "$CONFIG_FILE" 2>/dev/null || echo false)" == "true" ]]; then
        printf 'chime\n' >"$CHIME_FILE"
      else
        rm -f "$CHIME_FILE"
      fi
      systemd-run --user --unit="$UNIT" --collect \
        --description="Omarchy spoken stopwatch" \
        -- "$0" --run "$interval_minutes" "$label"
      echo "Stopwatch started, announcing every ${interval_minutes} minute(s)${label:+ ($label)}."
      ;;
  esac
}

main "$@"
