#!/usr/bin/env bash
set -euo pipefail
STATE_DIR="${OMARCHY_STATE_DIR:-$HOME/.local/state/omarchy}"
STATE_FILE="$STATE_DIR/skilldashboard.json"
LIFECYCLE_FILE="${OMARCHY_SKILL_LIFECYCLE:-$STATE_DIR/skilldashboard-lifecycle.json}"
USAGE_DIR="${OMARCHY_SKILL_USAGE_DIR:-$STATE_DIR/skill-usage}"
ROOTS_RAW="${OMARCHY_SKILL_ROOTS:-$HOME/.codex/skills:$HOME/.agents/skills}"
THRESHOLD="${OMARCHY_SKILL_DAYS:-30}"
now_ms() { date +%s%N | cut -c1-13; }
read_lifecycle() { [ -s "$LIFECYCLE_FILE" ] && cat "$LIFECYCLE_FILE" || printf '%s' '{"version":1,"skills":{},"history":[]}'; }
refresh() {
  mkdir -p "$STATE_DIR"; local now tmp rows root dir id name uses last days stale status ack owned
  now=$(now_ms); rows=$(mktemp); trap 'rm -f "$rows"' RETURN
  while IFS= read -r root; do
    [ -d "$root" ] || continue
    while IFS= read -r dir; do
      id=$(basename "$dir"); name=$(awk -F': *' '$1 == "name" {print $2; exit}' "$dir/SKILL.md" | tr -d "\"'"); [ -n "$name" ] || name="$id"
      uses=0; last=0; [ -f "$USAGE_DIR/$id.json" ] && uses=$(jq -r '.uses // 0' "$USAGE_DIR/$id.json" 2>/dev/null || echo 0); [ -f "$USAGE_DIR/$id.json" ] && last=$(jq -r '.lastAt // 0' "$USAGE_DIR/$id.json" 2>/dev/null || echo 0)
      days=null; stale=false; if [ "$last" -gt 0 ] 2>/dev/null; then days=$(( (now - last) / 86400000 )); [ "$days" -ge "$THRESHOLD" ] && stale=true; fi
      status=$(read_lifecycle | jq -r --arg id "$id" '.skills[$id].status // "active"'); ack=$(read_lifecycle | jq -r --arg id "$id" '.skills[$id].acknowledgedAt // null'); owned=false; [[ "$dir" == "$HOME"/* ]] && owned=true
      jq -cn --arg id "$id" --arg name "$name" --arg path "$(readlink -f "$dir")" --argjson uses "$uses" --argjson lastAt "$last" --argjson daysIdle "$days" --argjson stale "$stale" --arg status "$status" --argjson acknowledgedAt "$ack" --argjson owned "$owned" '{id:$id,name:$name,path:$path,owned:$owned,uses:$uses,lastAt:$lastAt,daysIdle:$daysIdle,stale:$stale,status:$status,acknowledgedAt:$acknowledgedAt}' >> "$rows"
    done < <(find "$root" -mindepth 1 -maxdepth 1 -type d -exec test -f '{}/SKILL.md' \; -print | sort)
  done < <(printf '%s\n' "$ROOTS_RAW" | tr ':' '\n')
  tmp=$(mktemp "$STATE_FILE.XXXXXX"); jq -s --argjson now "$now" --argjson threshold "$THRESHOLD" '{version:1,generatedAt:($now/1000|todateiso8601),thresholdDays:$threshold,skills:sort_by(-.uses,.id),summary:{total:length,stale:(map(select(.stale))|length),actionNeeded:(map(select(.stale and .status == "active" and .acknowledgedAt == null))|length),uses:(map(.uses)|add // 0)}}' "$rows" > "$tmp"; mv "$tmp" "$STATE_FILE"; cat "$STATE_FILE"
}
action() {
  local verb="$1" id="$2" path="${3:-}" now current tmp backup; mkdir -p "$STATE_DIR"; now=$(now_ms); current=$(read_lifecycle)
  [[ "$path" == "$HOME"/* ]] || { echo 'system-owned skill protected' >&2; return 1; }
  case "$verb" in
    acknowledge|disable|enable|deprecate) current=$(jq --arg id "$id" --arg verb "$verb" --argjson now "$now" '.skills[$id].status=(if $verb=="disable" then "disabled" elif $verb=="deprecate" then "deprecated" else (.skills[$id].status // "active") end)|if $verb=="acknowledge" then .skills[$id].acknowledgedAt=$now else . end|.history += [{action:$verb,id:$id,at:$now}]' <<<"$current") ;;
    *) echo "unsupported action" >&2; return 2 ;;
  esac
  tmp=$(mktemp "$LIFECYCLE_FILE.XXXXXX"); printf '%s\n' "$current" | jq . > "$tmp"; mv "$tmp" "$LIFECYCLE_FILE"; refresh >/dev/null
}
case "${1:-refresh}" in refresh) refresh >/dev/null ;; get) [ -f "$STATE_FILE" ] && cat "$STATE_FILE" || refresh ;; action) action "${2:-}" "${3:-}" "${4:-}" ;; *) echo "usage: $0 {refresh|get|action}" >&2; exit 2 ;; esac
