#!/usr/bin/env bash
# llm-blurb -- one-shot text generation for the small Omarchy helpers.
#
# Drop-in stand-in for a raw model call in the "self-improving" helpers
# (dictionary overview / daily suggestion, stocks commentary, dashboard digest,
# motivator pool growth, morning briefing, weekly recap). Prints the model's
# reply on stdout; on ANY failure it prints a one-line reason to stderr and
# exits non-zero *quietly* so callers keep whatever fallback they already have.
#
# Uses `hermes -z` (one-shot mode) backed by the NanoGPT adapter (port 4142).
# Web search is available by default; pass `--no-search` for a local-only
# completion. Set LLM_HERMES_PROVIDER and LLM_BLURB_BACKEND in environment to
# pin the backend; defaults route through the NanoGPT adapter.
#
# Usage:
#   llm-blurb [options] "PROMPT"        # prompt as args, or on stdin if none
#
# Options:
#   --json            ask the model for one JSON object; stdout is that object
#   --system TEXT     override the system message
#   --model NAME      model hint (passed as -m to hermes)
#   --max-tokens N    soft length hint appended to the system message
#   --timeout N       wall-clock cap in seconds (default 45)
#   --no-search       disable web search and use safe mode
# Exit codes: 0 ok | 2 bad args | 3 hermes not on PATH | 4 backend failed/timed out
#             5 empty reply
set -uo pipefail

max_tokens=""
temp=""
timeout=45
want_json=0
no_search=0
system=""
model=""

while (($#)); do
  case "$1" in
    --json)       want_json=1; shift ;;
    --system)     system="${2:-}"; shift 2 ;;
    --model)      model="${2:-}"; shift 2 ;;
    --max-tokens) max_tokens="${2:-}"; shift 2 ;;
    --temp)       temp="${2:-}"; shift 2 ;;
    --timeout)    timeout="${2:-}"; shift 2 ;;
    --no-search)  no_search=1; shift ;;
    --)           shift; break ;;
    -*)           echo "llm-blurb: unknown option $1" >&2; exit 2 ;;
    *)            break ;;
  esac
done

prompt="${*:-}"
[[ -z "$prompt" ]] && prompt="$(cat)"
[[ -z "${prompt// }" ]] && { echo "llm-blurb: empty prompt" >&2; exit 2; }

command -v hermes >/dev/null 2>&1 || { echo "llm-blurb: hermes not on PATH" >&2; exit 3; }

if [[ -z "$system" ]]; then
  if ((want_json)); then
    system="You output only a single JSON object: no markdown fences, no prose before or after it. Use web search when the request depends on current, recent, or future information, and cross-check time-sensitive facts with authoritative sources."
  else
    system="You write short, plain-text answers. No markdown, no preamble, no disclaimers, no follow-up suggestions. Use web search when the request depends on current, recent, or future information, and cross-check time-sensitive facts with authoritative sources."
  fi
fi
[[ -n "$max_tokens" ]] && system="$system Keep the reply to roughly ${max_tokens} tokens."

model_args=()
[[ -n "$model" ]] && model_args=(-m "$model")

hermes_args=(hermes -z "${system}"$'\n\n'"${prompt}" --ignore-rules)
((no_search)) && hermes_args+=(--safe-mode)
raw="$(timeout -k 5 "$timeout" "${hermes_args[@]}" "${model_args[@]}" </dev/null 2>/dev/null)"
rc=$?

if ((rc != 0)); then
  ((rc == 124)) && { echo "llm-blurb: hermes timed out after ${timeout}s" >&2; exit 4; }
  echo "llm-blurb: hermes exited $rc" >&2
  exit 4
fi

# Strip trailing "Next steps:" / "Sources:" trailer, leading "I'll ..." meta lines,
# and surrounding quotes.
clean="$(printf '%s' "$raw" | python3 -c '
import re, sys
t = sys.stdin.read().strip()
t = re.sub(r"\n+[*_#>\s]*(?:Next steps?|Follow-?ups?|Related|Sources?|Notes?)\b[^\n]*:?\s*\n.*\Z", "", t, flags=re.S | re.I)
lines = t.split("\n")
while lines and re.match(r"^\s*(?:i.?ll |i will |let me |sure[,!. ]|here.?s )", lines[0], re.I):
    lines.pop(0)
t = "\n".join(lines).strip()
if len(t) >= 2 and t[0] == t[-1] and t[0] in "\"" + chr(8220) + chr(39):
    inner = t[1:-1]
    if t[0] not in inner:
        t = inner.strip()
if not t:
    sys.exit(1)
print(t)
')" || { echo "llm-blurb: empty completion" >&2; exit 5; }

if ((want_json)); then
  clean="$(printf '%s' "$clean" | python3 -c '
import json, re, sys
s = sys.stdin.read().strip()
if s.startswith("```"):
    s = re.sub(r"^```[a-zA-Z]*\n?|\n?```$", "", s).strip()
m = re.search(r"\{.*\}", s, re.S)
if not m:
    sys.exit(1)
frag = m.group(0)
try:
    json.loads(frag)
except Exception:
    sys.exit(1)
print(frag)
')" || { echo "llm-blurb: model did not return JSON" >&2; exit 5; }
fi

[[ -z "${clean// }" ]] && { echo "llm-blurb: empty completion" >&2; exit 5; }
printf '%s\n' "$clean"