#!/usr/bin/env bash
# llm-blurb -- one-shot text generation for the small Omarchy helpers.
#
# Drop-in stand-in for a raw model call in the "self-improving" helpers
# (dictionary overview / daily suggestion, stocks commentary, dashboard digest,
# motivator pool growth, morning briefing, weekly recap). Prints the model's
# reply on stdout; on ANY failure it prints a one-line reason to stderr and
# exits non-zero *quietly* so callers keep whatever fallback they already have.
#
# History: this used to POST to a hosted inference API to keep these off the
# Claude subscription. That was swapped for `claude -p`. It now prefers the
# `hermes` CLI (one-shot `-z` mode, backed by NanoGPT) so the volume of tiny
# blurb calls stays off the Claude subscription again, and falls back to
# `claude -p` when hermes is unavailable or errors. Callers are unchanged.
#
# Backend selection:
#   LLM_BACKEND / LLM_BLURB_BACKEND = auto (default) | hermes | claude
#   LLM_HERMES_PROVIDER            = a hermes provider to pin (e.g. claude-cli for
#                                   the Claude subscription; else hermes default = NanoGPT)
#   LLM_HERMES_MODEL              = a model id to force (else the provider default)
#
# Usage:
#   llm-blurb [options] "PROMPT"        # prompt as args, or on stdin if none
#
# Options (kept for caller compatibility):
#   --json            ask the model for one JSON object; stdout is that object
#   --system TEXT     override the system message
#   --model NAME      sonnet | haiku | opus, or a legacy hosted-model id. Only
#                     consulted on the claude fallback path (mapped by family);
#                     the hermes path uses LLM_HERMES_MODEL or the hermes default.
#   --max-tokens N    soft length hint appended to the system message
#   --temp N          accepted and ignored (no temperature knob on either path)
#   --timeout N       wall-clock cap in seconds per backend call (default 45)
#
# Exit codes: 0 ok | 2 bad args | 3 no backend (hermes/claude) on PATH
#             4 backend failed/timed out | 5 empty reply
set -uo pipefail

max_tokens=""
temp=""
timeout=45
want_json=0
system=""
model=""

while (($#)); do
  case "$1" in
    --json)       want_json=1; shift ;;
    --system)     system="${2:-}"; shift 2 ;;
    --model)      model="${2:-}"; shift 2 ;;
    --max-tokens) max_tokens="${2:-}"; shift 2 ;;
    --temp)       temp="${2:-}"; shift 2 ;;
    --timeout)    timeout="${2:-}"; shift 2 ;;
    --)           shift; break ;;
    -*)           echo "llm-blurb: unknown option $1" >&2; exit 2 ;;
    *)            break ;;
  esac
done

prompt="${*:-}"
[[ -z "$prompt" ]] && prompt="$(cat)"
[[ -z "${prompt// }" ]] && { echo "llm-blurb: empty prompt" >&2; exit 2; }

backend="${LLM_BLURB_BACKEND:-${LLM_BACKEND:-auto}}"
have_hermes=0; command -v hermes >/dev/null 2>&1 && have_hermes=1
have_claude=0; command -v claude >/dev/null 2>&1 && have_claude=1

case "$backend" in
  hermes) have_hermes=1 ;;  # honour explicit request; call still fails loudly if absent
  claude) have_hermes=0 ;;
esac
if ((!have_hermes && !have_claude)); then
  echo "llm-blurb: neither hermes nor claude on PATH" >&2; exit 3
fi

# Map a model hint to a claude alias (claude fallback path only). Legacy callers
# still pass hosted-model ids such as Qwen/Qwen3-30B-A3B-Instruct-2507 -- fall
# through to the CLI default.
model_args=()
case "${model,,}" in
  *haiku*)  model_args=(--model haiku) ;;
  *opus*)   model_args=(--model opus) ;;
  *sonnet*) model_args=(--model sonnet) ;;
  *)        : ;;
esac

if [[ -z "$system" ]]; then
  if ((want_json)); then
    system="You output only a single JSON object: no markdown fences, no prose before or after it."
  else
    system="You write short, plain-text answers. No markdown, no preamble, no disclaimers, no follow-up suggestions."
  fi
fi
[[ -n "$max_tokens" ]] && system="$system Keep the reply to roughly ${max_tokens} tokens."

# hermes -z has no --system flag; fold the system message into the prompt.
# LLM_HERMES_PROVIDER (e.g. claude-cli) + LLM_HERMES_MODEL pin the backend;
# unset, hermes uses its configured default (NanoGPT).
gen_hermes() {
  local m=() hmodel="${LLM_HERMES_MODEL:-}"
  # `hermes -z --provider X` errors without a model; default one when pinned.
  [[ -n "${LLM_HERMES_PROVIDER:-}" && -z "$hmodel" ]] && hmodel=sonnet
  [[ -n "$hmodel" ]] && m=(-m "$hmodel")
  [[ -n "${LLM_HERMES_PROVIDER:-}" ]] && m+=(--provider "$LLM_HERMES_PROVIDER")
  timeout -k 5 "$timeout" hermes -z "${system}"$'\n\n'"${prompt}" \
    --safe-mode --ignore-rules "${m[@]}" </dev/null 2>/dev/null
}
gen_claude() {
  timeout -k 5 "$timeout" claude -p "$prompt" \
    --system-prompt "$system" "${model_args[@]}" \
    --output-format text </dev/null 2>/dev/null
}

raw=""; rc=1; used=""
if ((have_hermes)) && [[ "$backend" != claude ]]; then
  raw="$(gen_hermes)"; rc=$?; used=hermes
fi
if ((rc != 0)) && [[ "$backend" != hermes ]] && ((have_claude)); then
  raw="$(gen_claude)"; rc=$?; used=claude
fi

if ((rc != 0)); then
  ((rc == 124)) && { echo "llm-blurb: ${used:-backend} timed out after ${timeout}s" >&2; exit 4; }
  echo "llm-blurb: ${used:-backend} exited $rc" >&2
  exit 4
fi

# Backends occasionally tack on a "Next steps:" / "Sources:" trailer, a leading
# "I'll ..." meta line, or wrap the whole answer in quotes. Strip all three.
clean="$(printf '%s' "$raw" | python3 -c '
import re, sys
t = sys.stdin.read().strip()
t = re.sub(r"\n+[*_#>\s]*(?:Next steps?|Follow-?ups?|Related|Sources?|Notes?)\b[^\n]*:?\s*\n.*\Z", "", t, flags=re.S | re.I)
lines = t.split("\n")
while lines and re.match(r"^\s*(?:i.?ll |i will |let me |sure[,!. ]|here.?s )", lines[0], re.I):
    lines.pop(0)
t = "\n".join(lines).strip()
if len(t) >= 2 and t[0] == t[-1] and t[0] in "\"" + chr(8220) + chr(39):
    inner = t[1:-1]
    if t[0] not in inner:
        t = inner.strip()
if not t:
    sys.exit(1)
print(t)
')" || { echo "llm-blurb: empty completion" >&2; exit 5; }

if ((want_json)); then
  clean="$(printf '%s' "$clean" | python3 -c '
import json, re, sys
s = sys.stdin.read().strip()
if s.startswith("```"):
    s = re.sub(r"^```[a-zA-Z]*\n?|\n?```$", "", s).strip()
m = re.search(r"\{.*\}", s, re.S)
if not m:
    sys.exit(1)
frag = m.group(0)
try:
    json.loads(frag)
except Exception:
    sys.exit(1)
print(frag)
')" || { echo "llm-blurb: model did not return JSON" >&2; exit 5; }
fi

[[ -z "${clean// }" ]] && { echo "llm-blurb: empty completion" >&2; exit 5; }
printf '%s\n' "$clean"
