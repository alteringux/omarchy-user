#!/usr/bin/env bash
# llm-blurb -- one-shot text generation via the Claude CLI (`claude -p`).
#
# Drop-in stand-in for a raw model call in the small Omarchy "self-improving"
# helpers (dictionary overview / daily suggestion, stocks commentary, dashboard
# digest, motivator pool growth, morning briefing, weekly recap). Prints the
# model's reply on stdout; on ANY failure it prints a one-line reason to stderr
# and exits non-zero *quietly* so callers keep whatever fallback they already
# have.
#
# History: this used to POST to a hosted inference API to keep these off the Claude
# subscription. That backend has been removed, so the same interface now
# shells out to `claude -p`. Callers are unchanged.
#
# Usage:
#   llm-blurb [options] "PROMPT"        # prompt as args, or on stdin if none
#
# Options (kept for caller compatibility):
#   --json            ask the model for one JSON object; stdout is that object
#   --system TEXT     override the system message
#   --model NAME      sonnet | haiku | opus, or a legacy hosted-model id which is
#                     mapped by family (anything unrecognised -> claude default)
#   --max-tokens N    soft length hint appended to the system message
#   --temp N          accepted and ignored (claude -p has no temperature knob)
#   --timeout N       wall-clock cap in seconds for the claude call (default 45)
#
# Exit codes: 0 ok | 2 bad args | 3 claude not found | 4 claude failed/timed out
#             5 empty reply
set -uo pipefail

max_tokens=""
temp=""
timeout=45
want_json=0
system=""
model=""

while (($#)); do
  case "$1" in
    --json)       want_json=1; shift ;;
    --system)     system="${2:-}"; shift 2 ;;
    --model)      model="${2:-}"; shift 2 ;;
    --max-tokens) max_tokens="${2:-}"; shift 2 ;;
    --temp)       temp="${2:-}"; shift 2 ;;
    --timeout)    timeout="${2:-}"; shift 2 ;;
    --)           shift; break ;;
    -*)           echo "llm-blurb: unknown option $1" >&2; exit 2 ;;
    *)            break ;;
  esac
done

prompt="${*:-}"
[[ -z "$prompt" ]] && prompt="$(cat)"
[[ -z "${prompt// }" ]] && { echo "llm-blurb: empty prompt" >&2; exit 2; }

command -v claude >/dev/null 2>&1 || { echo "llm-blurb: claude CLI not on PATH" >&2; exit 3; }

# Map a model hint to a claude alias. Legacy callers still pass hosted-model ids
# such as Qwen/Qwen3-30B-A3B-Instruct-2507 -- fall through to the CLI default.
model_args=()
case "${model,,}" in
  *haiku*)  model_args=(--model haiku) ;;
  *opus*)   model_args=(--model opus) ;;
  *sonnet*) model_args=(--model sonnet) ;;
  "")       : ;;
  *)        : ;;
esac

if [[ -z "$system" ]]; then
  if ((want_json)); then
    system="You output only a single JSON object: no markdown fences, no prose before or after it."
  else
    system="You write short, plain-text answers. No markdown, no preamble, no disclaimers, no follow-up suggestions."
  fi
fi
[[ -n "$max_tokens" ]] && system="$system Keep the reply to roughly ${max_tokens} tokens."

raw="$(timeout -k 5 "$timeout" claude -p "$prompt" \
        --system-prompt "$system" "${model_args[@]}" \
        --output-format text </dev/null 2>/dev/null)"
rc=$?
if ((rc != 0)); then
  ((rc == 124)) && { echo "llm-blurb: claude timed out after ${timeout}s" >&2; exit 4; }
  echo "llm-blurb: claude exited $rc" >&2
  exit 4
fi

# `claude -p` occasionally tacks on a "Next steps:" / "Sources:" trailer or a
# leading "I'll ..." meta line. Strip both so callers get just the answer.
clean="$(printf '%s' "$raw" | python3 -c '
import re, sys
t = sys.stdin.read().strip()
t = re.sub(r"\n+[*_#>\s]*(?:Next steps?|Follow-?ups?|Related|Sources?|Notes?)\b[^\n]*:?\s*\n.*\Z", "", t, flags=re.S | re.I)
lines = t.split("\n")
while lines and re.match(r"^\s*(?:i.?ll |i will |let me |sure[,!. ]|here.?s )", lines[0], re.I):
    lines.pop(0)
t = "\n".join(lines).strip()
if not t:
    sys.exit(1)
print(t)
')" || { echo "llm-blurb: empty completion" >&2; exit 5; }

if ((want_json)); then
  clean="$(printf '%s' "$clean" | python3 -c '
import json, re, sys
s = sys.stdin.read().strip()
if s.startswith("```"):
    s = re.sub(r"^```[a-zA-Z]*\n?|\n?```$", "", s).strip()
m = re.search(r"\{.*\}", s, re.S)
if not m:
    sys.exit(1)
frag = m.group(0)
try:
    json.loads(frag)
except Exception:
    sys.exit(1)
print(frag)
')" || { echo "llm-blurb: model did not return JSON" >&2; exit 5; }
fi

[[ -z "${clean// }" ]] && { echo "llm-blurb: empty completion" >&2; exit 5; }
printf '%s\n' "$clean"
