#!/usr/bin/env python3
"""llm-agent -- a grounded one-shot answer for the small Omarchy helpers.

This used to run a client-side tool-calling loop against a hosted model with
web_search backed by a local SearXNG, then it shelled out to `claude -p`. It
now prefers the `hermes` CLI (one-shot `-z` mode, backed by NanoGPT, with
hermes' own web search) so the volume of these calls stays off the Claude
subscription, and falls back to `claude -p` when hermes is unavailable or
errors. Either way the result is reshaped into the same envelope callers
already expect.

Backend selection:
    LLM_BACKEND / LLM_AGENT_BACKEND = auto (default) | hermes | claude
    LLM_HERMES_PROVIDER            = a hermes provider to pin (e.g. claude-cli for the
                                    Claude subscription; else hermes default = NanoGPT)
    LLM_HERMES_MODEL              = a model id to force (else the provider default)

Usage:
    llm-agent [options] "PROMPT"          # prompt in args, or on stdin if none
    echo "PROMPT" | llm-agent [options]

Options:
    --json               ask for one JSON object back as the answer
    --json-full          print {text, steps[], citations[], iters, model}
    --system TEXT        system message (default: a terse research operator)
    --no-search          forbid web search -- a plain one-shot completion
    --model NAME         sonnet | haiku | opus, or a legacy id. Consulted only on
                         the claude fallback path; the hermes path uses
                         LLM_HERMES_MODEL or the hermes default.
    --max-iters N        upper bound on model<->tool round trips (default 6)
    --timeout N          wall-clock cap in seconds (default 120)
    --verbose            log progress to stderr

    --max-tokens / --temp / --results / --searxng-url / --rag-store are accepted
    for caller compatibility and ignored.

Exit codes: 0 ok | 2 bad args | 3 no backend (hermes/claude) on PATH
            4 backend failed/timed out | 5 empty/no final answer
"""
from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys


def eprint(*a):
    print(*a, file=sys.stderr)


class BackendError(Exception):
    """Raised by a backend runner; carries the process exit code to return."""

    def __init__(self, msg: str, code: int = 4):
        super().__init__(msg)
        self.code = code


def map_model(name: str):
    n = (name or "").lower()
    if "haiku" in n:
        return ["--model", "haiku"]
    if "opus" in n:
        return ["--model", "opus"]
    if "sonnet" in n:
        return ["--model", "sonnet"]
    return []


URL_RE = re.compile(r"https?://[^\s\)\]\}>\"']+")

_TRAILER_RE = re.compile(
    r"\n+[*_#>\s]*(?:Next steps?|Follow-?ups?|Related|Sources?|Notes?)\b[^\n]*:?\s*\n.*\Z",
    re.S | re.I,
)
_META_RE = re.compile(r"^\s*(?:i.?ll |i will |let me |sure[,!. ]|here.?s )", re.I)


def clean_text(t: str) -> str:
    t = _TRAILER_RE.sub("", (t or "").strip())
    lines = t.split("\n")
    while lines and _META_RE.match(lines[0]):
        lines.pop(0)
    return "\n".join(lines).strip()


def harvest_citations(text: str):
    out, seen = [], set()
    for u in URL_RE.findall(text or ""):
        u = u.rstrip(".,;")
        if u not in seen:
            seen.add(u)
            out.append({"url": u})
    return out


def run_hermes(prompt: str, system: str, args) -> tuple[str, str, int]:
    """One-shot via `hermes -z`. Returns (raw_text, model_id, iters)."""
    sysmsg = system
    argv = ["hermes", "-z", "", "--ignore-rules"]
    if args.no_search:
        sysmsg += " Do not use any tools or web search; answer directly from your own knowledge."
        argv.append("--safe-mode")
    model = os.environ.get("LLM_HERMES_MODEL", "").strip()
    provider = os.environ.get("LLM_HERMES_PROVIDER", "").strip()
    # `hermes -z --provider X` errors without a model; default one when pinned.
    if provider and not model:
        model = "sonnet"
    if model:
        argv += ["-m", model]
    if provider:
        argv += ["--provider", provider]
    argv[2] = f"{sysmsg}\n\n{prompt}"

    if args.verbose:
        eprint(f"llm-agent: hermes -z (search={'off' if args.no_search else 'on'}, "
               f"model={model or 'default'}, timeout={args.timeout}s)")
    try:
        proc = subprocess.run(
            argv, capture_output=True, text=True, timeout=args.timeout,
            stdin=subprocess.DEVNULL,
        )
    except FileNotFoundError:
        raise BackendError("hermes not on PATH", code=3)
    except subprocess.TimeoutExpired:
        raise BackendError(f"hermes timed out after {args.timeout}s")
    if proc.returncode != 0:
        raise BackendError(f"hermes exited {proc.returncode}: {proc.stderr.strip()[:400]}")
    raw = proc.stdout.strip()
    if not raw:
        raise BackendError("hermes returned an empty answer", code=5)
    return raw, (model or "hermes/default"), 1


def run_claude(prompt: str, system: str, args) -> tuple[str, str, int]:
    """One-shot via `claude -p --output-format json`. Returns (raw_text, model_id, iters)."""
    argv = [
        "claude", "-p", prompt,
        "--system-prompt", system,
        "--output-format", "json",
        "--max-turns", str(max(1, args.max_iters)),
    ]
    argv += map_model(args.model)
    if not args.no_search:
        argv += ["--allowedTools", "WebSearch", "WebFetch"]
    else:
        argv += ["--disallowedTools", "WebSearch", "WebFetch"]

    if args.verbose:
        eprint(f"llm-agent: claude -p (search={'off' if args.no_search else 'on'}, "
               f"max_turns={args.max_iters}, timeout={args.timeout}s)")
    try:
        proc = subprocess.run(
            argv, capture_output=True, text=True, timeout=args.timeout,
            stdin=subprocess.DEVNULL,
        )
    except FileNotFoundError:
        raise BackendError("claude not on PATH", code=3)
    except subprocess.TimeoutExpired:
        raise BackendError(f"claude timed out after {args.timeout}s")
    if proc.returncode != 0:
        raise BackendError(f"claude exited {proc.returncode}: {proc.stderr.strip()[:400]}")
    try:
        env = json.loads(proc.stdout.strip())
    except ValueError:
        raise BackendError(f"claude did not return JSON: {proc.stdout[:300]}", code=5)
    if env.get("is_error") or env.get("subtype") not in (None, "success"):
        eprint(f"llm-agent: claude reported {env.get('subtype') or 'an error'}")
    raw = env.get("result") or ""
    if not raw.strip():
        raise BackendError("claude returned an empty final answer", code=5)
    return raw, (env.get("model") or args.model or "claude"), int(env.get("num_turns") or 1)


def main() -> int:
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("--json", action="store_true", dest="want_json")
    ap.add_argument("--json-full", action="store_true", dest="want_json_full")
    ap.add_argument("--system", default="")
    ap.add_argument("--model", default="")
    ap.add_argument("--no-search", action="store_true")
    ap.add_argument("--max-iters", type=int, default=6)
    ap.add_argument("--timeout", type=float, default=120.0)
    ap.add_argument("--verbose", action="store_true")
    # accepted, ignored
    ap.add_argument("--max-tokens", type=int, default=None)
    ap.add_argument("--temp", type=float, default=None)
    ap.add_argument("--results", type=int, default=None)
    ap.add_argument("--searxng-url", default=None)
    ap.add_argument("--rag-store", action="append", dest="rag_store", default=[])
    ap.add_argument("-h", "--help", action="store_true")
    ap.add_argument("prompt", nargs="*")
    args = ap.parse_args()

    if args.help:
        print(__doc__)
        return 0

    prompt = " ".join(args.prompt).strip()
    if not prompt and not sys.stdin.isatty():
        prompt = sys.stdin.read().strip()
    if not prompt:
        eprint("llm-agent: empty prompt")
        return 2

    backend = (os.environ.get("LLM_AGENT_BACKEND")
               or os.environ.get("LLM_BACKEND") or "auto").strip().lower()
    order = {"hermes": ["hermes"], "claude": ["claude"]}.get(backend, ["hermes", "claude"])
    order = [b for b in order if shutil.which(b)]
    if not order:
        eprint("llm-agent: neither hermes nor claude on PATH")
        return 3

    system = args.system.strip() or (
        "You are a terse research operator. Search the web to gather current "
        "facts before answering; make several focused searches rather than one "
        "broad one, and cross-check anything time-sensitive. Note the source URL "
        "for every fact you surface. When you have enough, answer directly with "
        "no preamble."
    )
    if args.want_json:
        system += " Your final message must be exactly one JSON object and nothing else."

    runners = {"hermes": run_hermes, "claude": run_claude}
    raw_text = model_id = None
    iters = 1
    last = BackendError("no backend ran", code=4)
    for name in order:
        try:
            raw_text, model_id, iters = runners[name](prompt, system, args)
            break
        except BackendError as e:
            last = e
            eprint(f"llm-agent: {e}")
            continue
    if raw_text is None:
        return last.code

    text = clean_text(raw_text)
    if not text:
        eprint("llm-agent: model returned an empty final answer")
        return 5

    if args.want_json:
        m = re.search(r"\{.*\}", text, re.S)
        if not m:
            eprint("llm-agent: --json asked but model text held no JSON object")
            return 5
        text = m.group(0)

    if args.want_json_full:
        citations = harvest_citations(raw_text)
        steps = [] if args.no_search else [
            {"iter": 1, "tool": "web_search", "ok": True,
             "note": f"{model_id} ran its own search loop; per-query trace not exposed"}
        ]
        print(json.dumps(
            {"text": text, "steps": steps, "citations": citations,
             "iters": iters, "model": model_id},
            ensure_ascii=False,
        ))
    else:
        print(text)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
