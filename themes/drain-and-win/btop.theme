# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#0a0a0a"
theme_background=true

# Main text color
theme[main_fg]="#f2e8d5"

# Title color for boxes
theme[title]="#ff3b1f"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#ffb000"

# Background color of selected item in processes box
theme[selected_bg]="#1a1210"

# Foreground color of selected item in processes box
theme[selected_fg]="#fff8e7"

# Color of inactive/disabled text
theme[inactive_fg]="#5a4f42"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#ffb000"

# Box outline and divider line color
theme[cpu_box]="#ff3b1f"
theme[mem_box]="#ff3b1f"
theme[net_box]="#ff3b1f"
theme[proc_box]="#ff3b1f"
theme[div_line]="#5a4f42"

# Gradient for all meters and graphs -- draining (green start) to critical (red end)
theme[temp_start]="#39ff14"
theme[temp_mid]="#ffb000"
theme[temp_end]="#ff2b2b"

theme[cpu_start]="#39ff14"
theme[cpu_mid]="#ffb000"
theme[cpu_end]="#ff2b2b"

theme[free_start]="#39ff14"
theme[free_mid]="#6bff5c"
theme[free_end]="#39ff14"

theme[cached_start]="#2de2c8"
theme[cached_mid]="#2de2c8"
theme[cached_end]="#2de2c8"

theme[available_start]="#ffb000"
theme[available_mid]="#ffb000"
theme[available_end]="#ffb000"

theme[used_start]="#ff3b1f"
theme[used_mid]="#ff3b1f"
theme[used_end]="#ff2b2b"

theme[download_start]="#3a6bff"
theme[download_mid]="#6f93ff"
theme[download_end]="#3a6bff"

theme[upload_start]="#ff3b1f"
theme[upload_mid]="#ff6a00"
theme[upload_end]="#ff3b1f"
