#!/bin/bash
# Records a click on a watchlist card so the panel can learn which tickers
# the user actually cares about. Called by BarWidget.qml's engageTicker().
#
# Usage: omarchy-stocks-engage TICKER

set -uo pipefail

STATE_DIR="$HOME/.local/state/omarchy"
FILE="$STATE_DIR/stocks-engagement.json"
LOCK="$STATE_DIR/.stocks-engagement.lock"
TICKER="${1:-}"

[[ -z "$TICKER" ]] && exit 0

mkdir -p "$STATE_DIR"
[[ -f "$FILE" ]] || echo '{}' > "$FILE"

(
  flock -x 200
  now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
  tmp=$(mktemp "${FILE}.XXXXXX")
  jq --arg t "$TICKER" --arg now "$now" \
    '.[$t] = { count: ((.[$t].count // 0) + 1), lastClickedAt: $now }' \
    "$FILE" > "$tmp" && mv "$tmp" "$FILE" || rm -f "$tmp"
) 200>"$LOCK"
