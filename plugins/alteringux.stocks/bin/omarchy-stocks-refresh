#!/bin/bash
# Refreshes the stocks bar-widget's state file with GLOBAL top-10 gainers
# and top-10 losers:
#   - queries Yahoo Finance's unofficial (keyless) screener endpoint once per
#     major region (US, GB, DE, JP, AU, HK, CA), then merges each side and
#     re-sorts to a global top 10 by %change
#   - trending symbols (Yahoo's unofficial trending endpoint, bare tickers)
# Both are free, keyless, and undocumented — this script only fetches and
# bundles the raw JSON; Model.js (loaded by the QML side) does all the
# shape-specific parsing, so a break in Yahoo's shape is a one-file fix.
#
# The screener's region-scoped POST form needs a session cookie + crumb
# (Yahoo's newer anti-scraping gate); see ensure_crumb below. That crumb is
# cached to disk and reused across refreshes rather than re-fetched every
# run, to keep this frequent (default 30s) poll light.
#
# Usage: omarchy-stocks-refresh   (no args — this is no longer per-ticker)

set -uo pipefail

STATE_DIR="$HOME/.local/state/omarchy"
STATE_FILE="$STATE_DIR/stocks.json"
CRUMB_FILE="$STATE_DIR/.stocks-crumb"
COOKIE_FILE="$STATE_DIR/.stocks-cookiejar"
CRUMB_MAX_AGE=21600 # 6h — the crumb rides on the cookie, not the clock, but
                     # refreshing it occasionally is cheap insurance
mkdir -p "$STATE_DIR"

# Multiple bar instances can refresh at the same time. Serialize the complete
# fetch/merge/write transaction so a slower request cannot overwrite newer
# quotes with an older snapshot.
LOCK_FILE="$STATE_DIR/.stocks-refresh.lock"
exec 9>"$LOCK_FILE"
flock -n 9 || exit 0

previous_state='{}'
if [[ -s "$STATE_FILE" ]]; then
  previous_state=$(jq -c 'if type == "object" then . else {} end' "$STATE_FILE" 2>/dev/null || echo '{}')
fi

provider_error=""
quotes_ok=false
trending_ok=false

UA="Mozilla/5.0 (X11; Linux x86_64) omarchy-stocks-refresh"
now_iso() { date -u +"%Y-%m-%dT%H:%M:%SZ"; }

fetch() {
  curl -fsS --max-time 8 -A "$UA" "$1" 2>/dev/null
}

# Regions Yahoo's screener `region` operand actually filters by (confirmed
# live — the account-scoped `region=` query param on the GET predefined
# endpoint does NOT scope results despite looking like it should; only the
# POST screener's query-operand form does).
REGIONS=(us gb de jp au hk ca)

# Session cookie + crumb, cached to disk. A stale/missing crumb makes every
# screener POST 401 with "Invalid Crumb"; ensure_crumb refreshes it, and
# fetch_movers below retries once through it on a 401.
ensure_crumb() {
  if [[ -s "$CRUMB_FILE" && -s "$COOKIE_FILE" ]]; then
    local age
    age=$(( $(date +%s) - $(stat -c %Y "$CRUMB_FILE" 2>/dev/null || echo 0) ))
    (( age < CRUMB_MAX_AGE )) && return 0
  fi
  curl -fsS --max-time 8 -A "$UA" -c "$COOKIE_FILE" -b "$COOKIE_FILE" "https://fc.yahoo.com" -o /dev/null 2>/dev/null
  local crumb
  crumb=$(curl -fsS --max-time 8 -A "$UA" -c "$COOKIE_FILE" -b "$COOKIE_FILE" \
    "https://query1.finance.yahoo.com/v1/test/getcrumb" 2>/dev/null)
  [[ -z "$crumb" || "$crumb" == *"<html"* ]] && return 1
  printf '%s' "$crumb" > "$CRUMB_FILE"
  return 0
}

# One region's gainers or losers, tagged with the region so a de-dup pass
# can drop the same instrument cross-listed on multiple exchanges. Filters
# (market cap, day volume, min price) mirror Yahoo's own day_gainers/
# day_losers predefined screener so results stay real movers rather than
# illiquid penny-stock noise. The upper %-change bound matters more here
# than on the US-only predefined screener: several regions' `region`
# operand pulls in thinly-traded cross-listed depositary receipts (Yahoo's
# "IOB" board) whose stale reference prices otherwise show up as fake
# 100-900% moves — capping the range keeps those out while still letting
# real 1-40% single-day moves through.
fetch_movers() {
  local direction="$1" region="$2" crumb body cmp bound sort thresh boundVal
  if [[ "$direction" == "gainers" ]]; then cmp="gt"; bound="lt"; sort="DESC"; thresh=1; boundVal=40
  else cmp="lt"; bound="gt"; sort="ASC"; thresh=-1; boundVal=-40; fi
  crumb=$(cat "$CRUMB_FILE" 2>/dev/null)
  body=$(jq -cn --arg region "$region" --arg sort "$sort" --arg cmp "$cmp" --arg bound "$bound" \
    --argjson thresh "$thresh" --argjson boundVal "$boundVal" '
    { size: 8, offset: 0, sortField: "percentchange", sortType: $sort, quoteType: "EQUITY",
      query: { operator: "and", operands: [
        { operator: "eq",   operands: ["region", $region] },
        { operator: "gt",   operands: ["intradaymarketcap", 500000000] },
        { operator: "gt",   operands: ["dayvolume", 50000] },
        { operator: "gte",  operands: ["intradayprice", 1] },
        { operator: $cmp,   operands: ["percentchange", $thresh] },
        { operator: $bound, operands: ["percentchange", $boundVal] }
      ] } }')
  curl -fsS --max-time 8 -A "$UA" -c "$COOKIE_FILE" -b "$COOKIE_FILE" -H "Content-Type: application/json" \
    -X POST "https://query1.finance.yahoo.com/v1/finance/screener?crumb=${crumb}&formatted=false&lang=en-US&region=US" \
    -d "$body" 2>/dev/null
}

# Each screener row carries ~90 fields; only project the ones the panel
# needs, tagging the region so a later merge can still show "which market".
SCREENER_PICK='[.finance.result[0].quotes[]? | {
  symbol, shortName, longName,
  regularMarketPrice, regularMarketChangePercent,
  fiftyTwoWeekHigh, fiftyTwoWeekLow, currency, exchange
}]'

fetch_region_side() {
  local direction="$1" region="$2" raw parsed
  raw=$(fetch_movers "$direction" "$region")
  [[ -z "$raw" ]] && { echo "[]"; return 1; }
  if [[ "$raw" == *"Invalid Crumb"* ]]; then
    rm -f "$CRUMB_FILE"
    ensure_crumb || { echo "[]"; return 1; }
    raw=$(fetch_movers "$direction" "$region")
    [[ -z "$raw" ]] && { echo "[]"; return 1; }
  fi
  if ! jq -e '(.finance.result | type == "array") and (.finance.result[0].quotes | type == "array")' <<<"$raw" >/dev/null 2>&1; then
    echo "[]"
    return 1
  fi
  parsed=$(echo "$raw" | jq -c "$SCREENER_PICK" 2>/dev/null) || parsed=""
  [[ -z "$parsed" ]] && { echo "[]"; return 1; }
  echo "$parsed"
  return 0
}

# --------------------------------------------------------------- movers
ensure_crumb || true # best-effort: fetch_region_side reports the failure

gainers_json="[]"
losers_json="[]"
gainers_ok_count=0
losers_ok_count=0
if [[ -s "$CRUMB_FILE" ]]; then
  gainers_parts=()
  losers_parts=()
  for region in "${REGIONS[@]}"; do
    if part=$(fetch_region_side gainers "$region"); then
      gainers_parts+=("$part")
      gainers_ok_count=$((gainers_ok_count + 1))
    else
      gainers_parts+=("[]")
    fi
    if part=$(fetch_region_side losers "$region"); then
      losers_parts+=("$part")
      losers_ok_count=$((losers_ok_count + 1))
    else
      losers_parts+=("[]")
    fi
  done
  # Merge all regions, dedup by symbol (cross-listed instruments), re-sort
  # globally by %change, cap at 10.
  gainers_json=$(printf '%s\n' "${gainers_parts[@]}" | jq -cs '
    add | unique_by(.symbol) | sort_by(-.regularMarketChangePercent) | .[:10]' 2>/dev/null) || gainers_json=""
  losers_json=$(printf '%s\n' "${losers_parts[@]}" | jq -cs '
    add | unique_by(.symbol) | sort_by(.regularMarketChangePercent) | .[:10]' 2>/dev/null) || losers_json=""
  if [[ "$gainers_ok_count" -eq "${#REGIONS[@]}" && "$losers_ok_count" -eq "${#REGIONS[@]}" && -n "$gainers_json" && -n "$losers_json" ]]; then
    quotes_ok=true
  else
    provider_error="Yahoo Finance movers unavailable"
  fi
else
  provider_error="Yahoo Finance movers unavailable"
fi
[[ -z "$gainers_json" ]] && gainers_json="[]"
[[ -z "$losers_json" ]] && losers_json="[]"

# -------------------------------------------------------------- trending
trending_json="null"
raw=$(fetch "https://query1.finance.yahoo.com/v1/finance/trending/US")
if [[ -n "$raw" ]] && jq -e '(.finance.result | type == "array") and (.finance.result[0].quotes | type == "array")' <<<"$raw" >/dev/null 2>&1; then
  trending_json=$(echo "$raw" | jq -c '.' 2>/dev/null) || trending_json="null"
  [[ "$trending_json" != "null" ]] && trending_ok=true
fi
if ! "$trending_ok"; then
  [[ -n "$provider_error" ]] && provider_error+="; "
  provider_error+="Yahoo Finance trending unavailable"
fi

provider_status="ok"
if ! "$quotes_ok"; then
  provider_status="error"
elif ! "$trending_ok"; then
  provider_status="degraded"
fi


# ------------------------------------------------------- write atomically
tmp=$(mktemp "${STATE_FILE}.XXXXXX")
trap 'rm -f "$tmp"' EXIT

# Catch a non-zero exit and hand it to the plugin bug-report pipeline.
# Sourced after our own trap so it chains, not clobbers. Best-effort:
# absent guard file = no-op.
OMARCHY_PLUGIN_ID="alteringux.stocks"
[[ -r "$HOME/.local/bin/plugin-bin-guard.sh" ]] && source "$HOME/.local/bin/plugin-bin-guard.sh"

now="$(now_iso)"
jq -cn \
  --argjson previous "$previous_state" \
  --argjson gainers "$gainers_json" \
  --argjson losers "$losers_json" \
  --argjson trending "$trending_json" \
  --argjson quotesOk "$quotes_ok" \
  --argjson trendingOk "$trending_ok" \
  --arg now "$now" \
  --arg status "$provider_status" \
  --arg error "$provider_error" \
  '($previous
   | .version = 1
   | .updatedAt = (if $quotesOk then $now else (.updatedAt // null) end)
   | .gainers = (if $quotesOk then $gainers else (.gainers // []) end)
   | .losers = (if $quotesOk then $losers else (.losers // []) end)
   | .trending = (if $trendingOk then $trending else (.trending // []) end)
   | .stale = (if $quotesOk then false else true end)
   | .providerStatus = $status
   | .providerError = (if $error == "" then null else $error end)
   | .checkedAt = $now)' \
  > "$tmp" && mv "$tmp" "$STATE_FILE"

# ---- alteringux.pulse: flag the single biggest global mover, once per ticker/day ----
# Best-effort — a missing or failing omarchy-pulse never affects the refresh.
if command -v omarchy-pulse >/dev/null 2>&1; then
  mover=$(jq -r '
    ((.gainers // []) + (.losers // []))
    | map(select(.regularMarketChangePercent != null))
    | sort_by(.regularMarketChangePercent | if . < 0 then -. else . end) | reverse | (.[0] // empty)
    | "\(.symbol) \(.regularMarketChangePercent)"' <<<"$(jq -n --argjson g "$gainers_json" --argjson l "$losers_json" '{gainers:$g, losers:$l}')" 2>/dev/null || true)
  if [[ -n "$mover" ]]; then
    mt=${mover%% *}; mp=${mover#* }
    seen="$STATE_DIR/.stocks-pulse-seen"
    key="$(date +%F) $mt"
    if ! grep -qxF "$key" "$seen" 2>/dev/null; then
      printf -v mpr '%+.1f' "$mp"
      lvl=info
      awk "BEGIN{m=$mp; if (m<0) m=-m; exit !(m>=8)}" && lvl=warning
      if omarchy-pulse log alteringux.stocks "${mt} ${mpr}% today (global movers)" \
           --action "omarchy-shell alteringux.stocks open" --action-label "Open stocks" \
           --level "$lvl" >/dev/null 2>&1; then
# `if` (not `[[ ]] &&`) so the group exits 0 when $seen is absent —
         # under `set -o pipefail` the short-circuited test would otherwise
         # fail the pipeline and skip the mv, so the file never got created.
         {
           echo "$key"
           if [[ -f "$seen" ]]; then cat "$seen"; fi
         } | head -n 60 > "${seen}.tmp" 2>/dev/null && mv "${seen}.tmp" "$seen"
      fi
    fi
  fi
fi
