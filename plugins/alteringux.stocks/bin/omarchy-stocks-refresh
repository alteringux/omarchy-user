#!/bin/bash
# Refreshes the stocks bar-widget's state file:
#   - one Yahoo Finance chart call per watchlist ticker (passed as args) —
#     gives both a live quote and a same-day intraday series in one request
#   - day gainers / day losers (Yahoo's unofficial screener endpoint)
#   - trending symbols (Yahoo's unofficial trending endpoint, bare tickers)
# All three are free, keyless, and undocumented — this script only fetches
# and bundles the raw JSON; Model.js (loaded by the QML side) does all the
# shape-specific parsing, so a break in Yahoo's shape is a one-file fix.
#
# Usage: omarchy-stocks-refresh [TICKER...]

set -uo pipefail

STATE_DIR="$HOME/.local/state/omarchy"
STATE_FILE="$STATE_DIR/stocks.json"
mkdir -p "$STATE_DIR"

UA="Mozilla/5.0 (X11; Linux x86_64) omarchy-stocks-refresh"
now_iso() { date -u +"%Y-%m-%dT%H:%M:%SZ"; }

fetch() {
  curl -fsS --max-time 8 -A "$UA" "$1" 2>/dev/null
}

# ------------------------------------------------------------- watchlist
# Trim each ticker's response down to the two paths Model.parseChartQuote
# (and omarchy-stocks-commentary) actually read — meta + the intraday close
# series. Yahoo's raw chart payload also carries full open/high/low/volume
# arrays and a timestamp array none of the consumers touch; keeping them
# bloated stocks.json to ~28KB/ticker, re-parsed by a FileView every 2min.
# An error/malformed response has no .chart.result[0].meta and passes
# through untouched so Model still sees it as "not ok".
watchlist_json="{}"
for ticker in "$@"; do
  raw=$(fetch "https://query1.finance.yahoo.com/v8/finance/chart/${ticker}?interval=5m&range=1d")
  [[ -z "$raw" ]] && raw='null'
  parsed=$(echo "$raw" | jq -c '
    if (.chart.result[0].meta // null) != null then
      { chart: { result: [ {
          meta: .chart.result[0].meta,
          indicators: { quote: [ { close: (.chart.result[0].indicators.quote[0].close // []) } ] }
        } ] } }
    else . end' 2>/dev/null) || parsed='null'
  watchlist_json=$(echo "$watchlist_json" | jq -c --arg t "$ticker" --argjson v "$parsed" '.[$t] = $v')
done

# ---------------------------------------------------------------- movers
# Each screener row carries ~87 fields; Model.parseScreenerQuote reads 7.
# Project to just those so gainers/losers don't dominate stocks.json.
SCREENER_PICK='[.finance.result[0].quotes[]? | {
  symbol, shortName, longName,
  regularMarketPrice, regularMarketChangePercent,
  fiftyTwoWeekHigh, fiftyTwoWeekLow
}]'

gainers_json="[]"
raw=$(fetch "https://query1.finance.yahoo.com/v1/finance/screener/predefined/saved?formatted=false&lang=en-US&scrIds=day_gainers&count=8")
[[ -n "$raw" ]] && gainers_json=$(echo "$raw" | jq -c "$SCREENER_PICK" 2>/dev/null) || gainers_json="[]"

losers_json="[]"
raw=$(fetch "https://query1.finance.yahoo.com/v1/finance/screener/predefined/saved?formatted=false&lang=en-US&scrIds=day_losers&count=8")
[[ -n "$raw" ]] && losers_json=$(echo "$raw" | jq -c "$SCREENER_PICK" 2>/dev/null) || losers_json="[]"

# -------------------------------------------------------------- trending
trending_json="null"
raw=$(fetch "https://query1.finance.yahoo.com/v1/finance/trending/US")
[[ -n "$raw" ]] && trending_json=$(echo "$raw" | jq -c '.' 2>/dev/null) || trending_json="null"

# ------------------------------------------------------- write atomically
tmp=$(mktemp "${STATE_FILE}.XXXXXX")
trap 'rm -f "$tmp"' EXIT

# Catch a non-zero exit and hand it to the plugin bug-report pipeline.
# Sourced after our own trap so it chains, not clobbers. Best-effort:
# absent guard file = no-op.
OMARCHY_PLUGIN_ID="alteringux.stocks"
[[ -r "$HOME/.local/bin/plugin-bin-guard.sh" ]] && source "$HOME/.local/bin/plugin-bin-guard.sh"

jq -cn \
  --argjson watchlist "$watchlist_json" \
  --argjson gainers "$gainers_json" \
  --argjson losers "$losers_json" \
  --argjson trending "$trending_json" \
  --arg now "$(now_iso)" \
  '{version: 1, updatedAt: $now, watchlist: $watchlist, gainers: $gainers, losers: $losers, trending: $trending}' \
  > "$tmp" && mv "$tmp" "$STATE_FILE"

# ---- alteringux.pulse: flag a notable intraday move, once per ticker/day ----
# Best-effort — a missing or failing omarchy-pulse never affects the refresh.
if command -v omarchy-pulse >/dev/null 2>&1; then
  mover=$(jq -r '
    [ to_entries[]
      | .key as $t
      | (.value.chart.result[0].meta // {}) as $m
      | ($m.regularMarketPrice // null) as $p
      | ($m.chartPreviousClose // $m.previousClose // null) as $c
      | select($p != null and $c != null and $c != 0)
      | { t: $t, pct: (($p - $c) / $c * 100) } ]
    | map(select((.pct | if . < 0 then -. else . end) >= 3))
    | sort_by(.pct | if . < 0 then -. else . end) | reverse | (.[0] // empty)
    | "\(.t) \(.pct)"' <<<"$watchlist_json" 2>/dev/null || true)
  if [[ -n "$mover" ]]; then
    mt=${mover%% *}; mp=${mover#* }
    seen="$STATE_DIR/.stocks-pulse-seen"
    key="$(date +%F) $mt"
    if ! grep -qxF "$key" "$seen" 2>/dev/null; then
      printf -v mpr '%+.1f' "$mp"
      lvl=info
      awk "BEGIN{m=$mp; if (m<0) m=-m; exit !(m>=5)}" && lvl=warning
      if omarchy-pulse log alteringux.stocks "${mt} ${mpr}% today" \
           --action "omarchy-shell alteringux.stocks open" --action-label "Open stocks" \
           --level "$lvl" >/dev/null 2>&1; then
# `if` (not `[[ ]] &&`) so the group exits 0 when $seen is absent —
         # under `set -o pipefail` the short-circuited test would otherwise
         # fail the pipeline and skip the mv, so the file never got created.
         {
           echo "$key"
           if [[ -f "$seen" ]]; then cat "$seen"; fi
         } | head -n 60 > "${seen}.tmp" 2>/dev/null && mv "${seen}.tmp" "$seen"
      fi
    fi
  fi
fi

# Self-improving step: detached (setsid, own process group) so a slow/no
# claude call never blocks the price refresh Process this script runs under.
# See omarchy-stocks-commentary for its own internal rate-limiting.
setsid bash "$(dirname "$0")/omarchy-stocks-commentary" </dev/null >/dev/null 2>&1 &
