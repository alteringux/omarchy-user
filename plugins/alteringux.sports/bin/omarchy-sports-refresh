#!/bin/bash
# Refreshes the alteringux.sports state file by fetching every configured
# league/favourite-team from TheSportsDB. All parsing lives in sports_fetch.py
# (stdlib only); this wrapper only wires in the plugin bug-report guard so a
# hard failure is caught like the other alteringux.* plugins.
#
# Usage: omarchy-sports-refresh [--config PATH] [--state PATH] [--timeout SECS]

set -uo pipefail

# Chain the plugin bin guard AFTER any traps of our own (there are none here).
# Best-effort: absent guard file = plain no-op.
OMARCHY_PLUGIN_ID="alteringux.sports"
[[ -r "$HOME/.local/bin/plugin-bin-guard.sh" ]] && source "$HOME/.local/bin/plugin-bin-guard.sh"

# Not exec'd: the guard's EXIT trap must run in this shell to see python's code.
python3 "$(dirname "$(readlink -f "$0")")/sports_fetch.py" "$@"
exit $?
