#!/bin/bash
# Appends one countdown usage entry to the history file that Panel.qml
# reads to rank one-tap presets (Model.rankPresets). Fire-and-forget,
# called from BarWidget.qml's startCountdown via execDetached.
set -uo pipefail

MODE="$1"
DURATION="$2"
LABEL="${3:-}"
HISTORY_LIMIT=200

STATE_DIR="$HOME/.local/state/omarchy"
HISTORY_FILE="$STATE_DIR/countdown-history.json"
mkdir -p "$STATE_DIR"

[[ -f "$HISTORY_FILE" ]] || echo '[]' > "$HISTORY_FILE"

tmp=$(mktemp "${HISTORY_FILE}.XXXXXX")
trap 'rm -f "$tmp"' EXIT
jq -c --arg mode "$MODE" --argjson duration "$DURATION" --arg label "$LABEL" --argjson limit "$HISTORY_LIMIT" --arg ts "$(date -u +%s)" \
  '. + [{mode: $mode, duration: $duration, label: $label, timestamp: ($ts|tonumber)}] | if length > $limit then .[-$limit:] else . end' \
  "$HISTORY_FILE" > "$tmp" && mv "$tmp" "$HISTORY_FILE"
