#!/bin/bash
# Pushes a freeform line onto the dashboard bar-widget's "Notes" card.
# This is the manual/CLI-driven side of the dashboard: run it yourself, or
# have a Claude Code session run it, to pin anything ("meeting moved to 3pm",
# a reminder, a link) onto the overlay. Newest entries show first; the list
# is capped at 20.
#
# Usage:
#   omarchy-dashboard-note "text to add"
#   omarchy-dashboard-note --clear

set -uo pipefail

# Catch a non-zero exit (e.g. jq choking on a bad arg) and hand it to the
# plugin bug-report pipeline. Best-effort: absent guard file = no-op.
OMARCHY_PLUGIN_ID="alteringux.dashboard"
[[ -r "$HOME/.local/bin/plugin-bin-guard.sh" ]] && source "$HOME/.local/bin/plugin-bin-guard.sh"

SCRIPT_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source=dashboard-common.sh
source "$SCRIPT_DIR/dashboard-common.sh"

ensure_state_file || { echo "dashboard: failed to initialize state file" >&2; exit 1; }

usage() {
  echo "Usage: omarchy-dashboard-note \"text to add\"" >&2
  echo "       omarchy-dashboard-note --clear" >&2
  exit 1
}

[[ $# -ge 1 ]] || usage

if [[ "$1" == "--clear" ]]; then
  if ! (
    flock 9 || exit 1
    tmp=$(mktemp "${STATE_FILE}.XXXXXX") || exit 1
    trap 'rm -f "$tmp"' EXIT
    jq -c '.notes.items = []' "$STATE_FILE" >"$tmp" || exit 1
    mv "$tmp" "$STATE_FILE"
  ) 9>"$LOCK_FILE"; then
    echo "dashboard: failed to clear notes" >&2
    exit 1
  fi
  echo "Dashboard notes cleared."
  exit 0
fi

text="$*"
(
  flock 9 || exit 1
  tmp=$(mktemp "${STATE_FILE}.XXXXXX") || exit 1
  trap 'rm -f "$tmp"' EXIT
  jq -c --arg text "$text" --arg now "$(now_iso)" \
    '.notes.items = ([{text: $text, at: $now}] + (.notes.items // [])) | .notes.items |= .[0:20]' \
    "$STATE_FILE" >"$tmp" || exit 1
  mv "$tmp" "$STATE_FILE"
) 9>"$LOCK_FILE" || {
  echo "dashboard: failed to add note" >&2
  exit 1
}
echo "Added to dashboard: $text"
