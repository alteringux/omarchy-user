#!/bin/bash
# Refreshes the News Bar state file by fetching every configured RSS/Atom feed.
# All parsing lives in newsbar_fetch.py (stdlib only); this wrapper only wires
# in the plugin bug-report guard so a hard failure is caught like the other
# alteringux.* plugins.
#
# Usage: omarchy-newsbar-refresh

set -uo pipefail

# Chain the plugin bin guard AFTER any traps of our own (there are none here).
# Best-effort: absent guard file = plain no-op.
OMARCHY_PLUGIN_ID="alteringux.newsbar"
[[ -r "$HOME/.local/bin/plugin-bin-guard.sh" ]] && source "$HOME/.local/bin/plugin-bin-guard.sh"

# Not exec'd: the guard's EXIT trap must run in this shell to see python's code.
python3 "$(dirname "$(readlink -f "$0")")/newsbar_fetch.py" "$@"
exit $?
