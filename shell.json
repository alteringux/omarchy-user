          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "alteringux.timers"
        },
        {
          "id": "alteringux.pomodoro"
        },
        {
          "id": "alteringux.countdown"
        },
        {
          "id": "alteringux.stopwatch"
