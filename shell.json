          "id": "alteringux.flow"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "alteringux.vpnrotate"
        },
        {
          "id": "alteringux.ttsplayer"
