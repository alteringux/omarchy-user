#!/usr/bin/env bash
# Mock hyprctl for the omarchy-hide-window test suite.
#
#   hyprctl -j clients          -> $MOCK_CLIENTS         (default "[]")
#   hyprctl -j activewindow     -> $MOCK_ACTIVEWINDOW    (default "{}")
#   hyprctl -j activeworkspace  -> $MOCK_ACTIVEWORKSPACE (default "{}")
#   hyprctl dispatch <args...>  -> appends "<args>" to $MOCK_DISPATCH_LOG

if [ "${1:-}" = "-j" ]; then
  case "${2:-}" in
    clients)         printf '%s' "${MOCK_CLIENTS-[]}" ;;
    activewindow)    printf '%s' "${MOCK_ACTIVEWINDOW-\{\}}" ;;
    activeworkspace) printf '%s' "${MOCK_ACTIVEWORKSPACE-\{\}}" ;;
    *)               printf 'null' ;;
  esac
  exit 0
fi

if [ "${1:-}" = "dispatch" ]; then
  shift
  [ -n "${MOCK_DISPATCH_LOG:-}" ] && printf '%s\n' "$*" >> "$MOCK_DISPATCH_LOG"
  exit 0
fi

exit 0
